  } = useForm<FormValues>({
    resolver: zodResolver(formSchema),
    defaultValues: {
      finalPrice: "",
    },
  });

  useEffect(() => {
    if (open && booking) {
      reset({
        finalPrice:
          booking.finalPrice != null ? String(booking.finalPrice) : "",
      });
    }
  }, [open, booking, reset]);

  const handleClose = () => {
    if (isSubmitting) return;
    onClose();
  };

  const onSubmit = async (values: FormValues) => {
    if (!booking) return;

    const numericPrice = Number(values.finalPrice);
    if (booking.finalPrice === numericPrice) {
      toast.info("Price is already set to BDT " + formatBookingAmount(numericPrice));
      onClose();
      return;
    }

    setIsSubmitting(true);
    try {
      const response = await axiosInstance.patch(`/booking/${booking._id}/price`, {
        finalPrice: numericPrice,
      });

      toast.success(
        response.data?.message || "Booking price updated successfully.",
      );
      onSuccess?.();
      onClose();
    } catch (error: unknown) {
      const err = error as { response?: { data?: { message?: string } }; message?: string };
      const message =
        err?.response?.data?.message ||
        err?.message ||
        "Failed to update booking price.";
      toast.error(message);
    } finally {
      setIsSubmitting(false);
    }
  };

  return (
    <Dialog open={open && Boolean(booking)} onOpenChange={(val) => !val && handleClose()}>
      <DialogContent className="max-h-[92vh] overflow-hidden rounded-2xl border-0 p-0 shadow-2xl sm:max-w-xl">
        <div className="flex max-h-[92vh] flex-col">
          <DialogHeader className="border-b px-6 py-5 text-left sm:px-8">
            <DialogTitle className="text-xl font-bold text-navy">
              Update Final Price
            </DialogTitle>
            <DialogDescription className="text-sm leading-6">
              Adjust the final agreed price for booking{" "}
              <span className="font-semibold text-foreground">
                #{booking?.bookingNumber}
              </span>
              .
            </DialogDescription>
          </DialogHeader>

          <form onSubmit={handleSubmit(onSubmit)} className="flex flex-1 flex-col overflow-hidden">
            <div className="min-h-0 flex-1 space-y-5 overflow-y-auto px-6 py-6 sm:px-8">
              {/* Current Price Box */}
              <div className="rounded-xl border bg-muted/20 p-4 text-sm">
                <span className="text-muted-foreground">Current final price: </span>
                <span className="font-semibold text-foreground">
                  {booking?.finalPrice != null
                    ? `BDT ${formatBookingAmount(booking.finalPrice)}`
                    : "Not set (Quote Pending)"}
                </span>
              </div>

              {/* Price Input */}
              <div className="space-y-2">
                <Label htmlFor="final-price-input" className="text-sm font-semibold text-navy">
                  New Final Price (BDT)
                </Label>
                <Input
                  id="final-price-input"
                  type="number"
                  step="any"
                  min="0"
                  placeholder="e.g. 15000"
                  disabled={isSubmitting}
                  {...register("finalPrice")}
                  className="h-11 rounded-xl"
                />
                {errors.finalPrice && (
                  <p className="text-xs text-destructive">{errors.finalPrice.message}</p>
                )}
                <p className="text-xs leading-5 text-muted-foreground">
                  Enter the total finalized price in BDT for this booking request.
                </p>
              </div>
            </div>

            {/* Footer */}
            <div className="flex flex-col-reverse gap-3 border-t bg-muted/20 px-6 py-4 sm:flex-row sm:justify-end sm:px-8">
              <DashboardButton
                type="button"
                variant="outline"
                className="min-h-10 rounded-xl px-5 text-xs font-bold"
                disabled={isSubmitting}
                onClick={handleClose}
              >
                Cancel
              </DashboardButton>
              <DashboardButton
                type="submit"
                disabled={isSubmitting}
                icon={isSubmitting ? <Loader2 className="h-4 w-4 animate-spin" /> : undefined}
              >
                {isSubmitting ? "Updating..." : "Update Price"}
              </DashboardButton>
            </div>
          </form>
        </div>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="components/Header/Header.tsx">
"use client";

import CartDrawer from "@/components/cart/CartDrawer";
import { useLenis } from "lenis/react";
import { Menu } from "lucide-react";
import { motion, useReducedMotion } from "motion/react";
import { useCallback, useEffect, useRef, useState } from "react";

import { EASE } from "../animations/variants";
import Container from "../Container";
import Logo from "../Logo";
import { ScrollProgress } from "../ScrollProgress";
import DesktopNavbar from "./DesktopNavbar";
import MobileMenu from "./MobileMenu";
import TopHeaderBar from "./TopHeaderBar";

type CartAddAnimationDetail = {
  sourceRect: {
    left: number;
    top: number;
    width: number;
    height: number;
  };
  quantity: number;
};

type CartFlight = {
  id: number;
  startX: number;
  startY: number;
  endX: number;
  endY: number;
  quantity: number;
};

export default function Header() {
  const [open, setOpen] = useState(false);
  const [cartOpen, setCartOpen] = useState(false);

  const cartTriggerRef = useRef<HTMLButtonElement>(null);

  const [scrolled, setScrolled] = useState(false);

  const [cartFlight, setCartFlight] = useState<CartFlight | null>(
    null,
  );

  const reduce = useReducedMotion();

  // Access the existing Lenis smooth-scroll instance.
  const lenis = useLenis();

  const closeCart = useCallback(() => setCartOpen(false), []);

  const links: { label: string; href: string }[] = [
    { label: "Home", href: "/" },
    { label: "About Us", href: "/about" },
    { label: "Services", href: "/services" },
    { label: "Projects", href: "/projects" },
    { label: "Products", href: "/products" },
    { label: "Blog", href: "/blog" },
    { label: "Contact Us", href: "/contact" },
  ];

  // Track page scrolling for the sticky header.
  useEffect(() => {
    const onScroll = () => {
      setScrolled(window.scrollY > 20);
    };

    window.addEventListener("scroll", onScroll, { passive: true });

    onScroll();

    return () => {
      window.removeEventListener("scroll", onScroll);
    };
  }, []);

  // Lock background scrolling while the mobile menu is open.
  // Stop Lenis as well so smooth scrolling cannot move the page.
  useEffect(() => {
    const body = document.body;
    const html = document.documentElement;

    const previousBodyOverflow = body.style.overflow;
    const previousHtmlOverflow = html.style.overflow;

    if (open) {
      lenis?.stop();

      body.style.overflow = "hidden";
      html.style.overflow = "hidden";
    } else {
      lenis?.start();
    }

    return () => {
      body.style.overflow = previousBodyOverflow;
      html.style.overflow = previousHtmlOverflow;

      // Ensure smooth scrolling resumes when the menu closes
      // or the Header component unmounts.
      lenis?.start();
    };
  }, [open, lenis]);

  // Close the mobile menu with the Escape key.
  useEffect(() => {
    if (!open) return;

    const onKey = (event: KeyboardEvent) => {
      if (event.key === "Escape") {
        setOpen(false);
      }
    };

    window.addEventListener("keydown", onKey);

    return () => {
      window.removeEventListener("keydown", onKey);
    };
  }, [open]);

  // Animate an item toward the cart icon when added to the cart.
  useEffect(() => {
    const handleCartAddAnimation = (event: Event) => {
      const detail = (event as CustomEvent<CartAddAnimationDetail>)
        .detail;

      const target = cartTriggerRef.current;

      if (!detail || !target || reduce) return;

      const targetRect = target.getBoundingClientRect();

      // Do not animate toward a hidden cart icon on mobile.
      if (!targetRect.width || !targetRect.height) return;

      const scrollY = window.scrollY;

      setCartFlight({
        id: Date.now(),

        startX: detail.sourceRect.left + detail.sourceRect.width / 2,

        startY: detail.sourceRect.top + detail.sourceRect.height / 2,

        endX: targetRect.left + targetRect.width / 2,

        endY: targetRect.top + scrollY + targetRect.height / 2,

        quantity: detail.quantity,
      });
    };

    window.addEventListener(
      "cart:add-animation",
      handleCartAddAnimation,
    );

    return () => {
      window.removeEventListener(
        "cart:add-animation",
        handleCartAddAnimation,
      );
    };
  }, [reduce]);

  return (
    <>
      <ScrollProgress />

      <TopHeaderBar
        onCartClick={() => setCartOpen(true)}
        cartOpen={cartOpen}
        cartTriggerRef={cartTriggerRef}
      />

      {/* Main Header */}
      <motion.header
        className="sticky top-0 z-20 h-[82px] border-b"
        animate={{
          backgroundColor: scrolled
            ? "rgba(255, 255, 255, 0.55)"
            : "rgba(255, 255, 255, 1)",

          backdropFilter: scrolled
            ? "blur(16px) saturate(180%)"
            : "blur(0px) saturate(100%)",

          boxShadow: scrolled
            ? "0px 10px 30px -5px rgba(0, 51, 78, 0.08), inset 0px 1px 0px 0px rgba(255, 255, 255, 0.8)"
            : "0px 0px 0px rgba(0, 51, 78, 0), inset 0px 0px 0px 0px rgba(255, 255, 255, 0)",

          borderColor: scrolled
            ? "rgba(255, 255, 255, 0.4)"
            : "rgba(223, 229, 233, 0)",
        }}
        style={{
          WebkitBackdropFilter: scrolled
            ? "blur(16px) saturate(180%)"
            : "blur(0px) saturate(100%)",
        }}
        transition={{ duration: 0.3 }}
      >
        <Container className="flex h-full items-center justify-between">
          {/* Logo */}
          <motion.div
            initial={
              reduce
                ? false
                : {
                    opacity: 0,
                    y: -8,
                  }
            }
            animate={{
              opacity: 1,
              y: 0,
            }}
            transition={{
              duration: 0.5,
              ease: EASE,
            }}
          >
            <Logo />
          </motion.div>

          {/* Desktop Navigation */}
          <DesktopNavbar links={links} />

          {/* Mobile Menu Toggle */}
          <button
            className="block text-navy min-[901px]:hidden"
            type="button"
            aria-label="Open navigation"
            aria-expanded={open}
            aria-controls="mobile-navigation"
            onClick={() => setOpen(true)}
          >
            <Menu aria-hidden="true" />
          </button>
        </Container>
      </motion.header>

      {/* Mobile Navigation Drawer */}
      <MobileMenu
        open={open}
        links={links}
        onClose={() => setOpen(false)}
        onCartClick={() => setCartOpen(true)}
      />

      {/* Shopping Cart Drawer */}
      <CartDrawer
        open={cartOpen}
        onClose={closeCart}
        triggerRef={cartTriggerRef}
      />

      {/* Add-to-Cart Animation */}
      {cartFlight && (
        <motion.div
          key={cartFlight.id}
          aria-hidden="true"
          initial={{
            x: 0,
            y: 0,
            scale: 0.45,
            opacity: 0,
          }}
          animate={{
            x: cartFlight.endX - cartFlight.startX,

            y: cartFlight.endY - cartFlight.startY,

            scale: [0.45, 1.1, 0.72, 0.55],

            opacity: [0, 1, 1, 0],
          }}
          transition={{
            duration: 1.6,
            ease: [0.22, 1, 0.36, 1],
            times: [0, 0.16, 0.76, 1],
          }}
          onAnimationComplete={() => {
            setCartFlight(null);
          }}
          style={{
            left: cartFlight.startX - 18,
            top: cartFlight.startY - 18,
          }}
          className="pointer-events-none fixed z-[100] grid size-9 place-items-center rounded-full border-2 border-white bg-blue text-xs font-extrabold text-white shadow-[0_6px_22px_rgba(1,110,220,0.4)]"
        >
          +{cartFlight.quantity}
        </motion.div>
      )}
    </>
  );
}
</file>

<file path="components/products/AddToCart.tsx">
"use client";

import { addToCart } from "@/lib/cart";
import type { IPublishedProduct, IProductVariant } from "@/types/product.type";
import { useLenis } from "lenis/react";
import { Check, Minus, Plus, ShoppingCart } from "lucide-react";
import { useEffect, useRef, useState } from "react";

type Props = {
  product: Pick<
    IPublishedProduct,
    "_id" | "slug" | "sku" | "name" | "price" | "primaryImage"
  >;
  selectedVariant?: IProductVariant;
  /** Units available. 0 disables the button. */
  stock: number;
};

type CartAddAnimationDetail = {
  sourceRect: {
    left: number;
    top: number;
    width: number;
    height: number;
  };
  quantity: number;
};

export default function AddToCart({ product, selectedVariant, stock }: Props) {
  const [qty, setQty] = useState(1);
  const [added, setAdded] = useState(false);

  const timer = useRef<ReturnType<typeof setTimeout> | null>(null);
  const addButtonRef = useRef<HTMLButtonElement>(null);
  const lenis = useLenis();

  useEffect(() => {
    return () => {
      if (timer.current) clearTimeout(timer.current);
    };
  }, []);

  const outOfStock = stock <= 0;

  const clamp = (n: number) =>
    Math.min(Math.max(1, n), Math.max(1, stock));

  const handleAdd = () => {
    if (outOfStock) return;

    const variantPrice = selectedVariant?.price ?? product.price;
    const variantSku = selectedVariant?.sku || product.sku;
    const variantWeight = selectedVariant?.weight || selectedVariant?.size;
    const variantSize = selectedVariant?.size || selectedVariant?.weight;
    const variantId = selectedVariant?._id;

    addToCart(
      {
        productId: product._id,
        variantId,
        weight: variantWeight,
        size: variantSize,
        slug: product.slug,
        sku: variantSku,
        name: product.name,
        price: variantPrice,
        image: product.primaryImage?.url ?? "",
        imageAlt: product.primaryImage?.alt || product.name,
        stockQuantity: stock,
      },
      qty,
      stock,
    );

    if (lenis) {
      lenis.scrollTo(0, {
        duration: 1.2,
        force: true,
      });
    } else {
      window.scrollTo({
        top: 0,
        left: 0,
        behavior: "smooth",
      });
    }

    const rect = addButtonRef.current?.getBoundingClientRect();

    if (rect) {
      const detail: CartAddAnimationDetail = {
        sourceRect: {
          left: rect.left,
          top: rect.top,
          width: rect.width,
          height: rect.height,
        },
        quantity: qty,
      };

      window.dispatchEvent(
        new CustomEvent<CartAddAnimationDetail>(
          "cart:add-animation",
          { detail },
        ),
      );
    }

    setAdded(true);

    if (timer.current) clearTimeout(timer.current);

    timer.current = setTimeout(() => {
      setAdded(false);
    }, 2200);
  };

  const stepBtn =
    "grid size-12 place-items-center text-navy transition-colors hover:bg-blue hover:text-white disabled:cursor-not-allowed disabled:text-ink/30 disabled:hover:bg-transparent disabled:hover:text-ink/30";

  return (
    <div className="flex flex-col gap-2">
      <div className="flex items-stretch gap-3">
        <div
          role="group"
          aria-label="Quantity"
          className="flex shrink-0 items-center overflow-hidden rounded-full border border-line"
        >
          <button
            type="button"
            onClick={() => setQty((q) => clamp(q - 1))}
            disabled={outOfStock || qty <= 1}
            aria-label="Decrease quantity"
            className={stepBtn}
          >
            <Minus size={16} />
          </button>

          <input
            type="number"
            inputMode="numeric"
            min={1}
            max={Math.max(1, stock)}
            value={qty}
            disabled={outOfStock}
            onChange={(e) =>
              setQty(clamp(Number(e.target.value) || 1))
            }
            aria-label="Quantity"
            className="h-12 w-12 border-0 bg-transparent text-center text-[14px] font-bold tabular-nums text-navy outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
          />

          <button
            type="button"
            onClick={() => setQty((q) => clamp(q + 1))}
            disabled={outOfStock || qty >= stock}
            aria-label="Increase quantity"
            className={stepBtn}
          >
            <Plus size={16} />
          </button>
        </div>

        <button
          ref={addButtonRef}
          type="button"
          onClick={handleAdd}
          disabled={outOfStock}
          className={`inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-full px-5 text-[13px] font-bold tracking-[0.01em] text-white shadow-[0_4px_14px_rgba(1,110,220,0.22)] transition-all duration-300 active:scale-[0.97] disabled:cursor-not-allowed disabled:bg-ink/30 disabled:shadow-none ${
            added
              ? "bg-deep"
              : "bg-blue hover:bg-deep hover:shadow-[0_8px_22px_rgba(1,110,220,0.32)]"
          }`}
        >
          {outOfStock ? (
            "Out of stock"
          ) : added ? (
            <>
              <Check size={17} aria-hidden="true" />
              Added to cart
            </>
          ) : (
            <>
              <ShoppingCart size={17} aria-hidden="true" />
              Add to cart
            </>
          )}
        </button>
      </div>

      <p
        role="status"
        aria-live="polite"
        className="min-h-[18px] text-[12px] text-ink/60"
      >
        {added
          ? `${qty} × ${product.name}${selectedVariant?.size ? ` (${selectedVariant.size})` : ""} added to your cart.`
          : ""}
      </p>
    </div>
  );
}
</file>

