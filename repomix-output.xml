                  }
                >
                  {user.emailVerified
                    ? "Email verified"
                    : "Email not verified"}
                </Badge>
              </div>
            </div>
          </div>
        </div>

        <section
          className="px-5 py-5 sm:px-7"
          aria-labelledby="user-account-heading"
        >
          <h4
            id="user-account-heading"
