    method: "DELETE",
    headers: {
      "Content-Type": "application/json",
    },
    body: JSON.stringify({
      public_id: publicId,
    }),
  });

  if (!response.ok) {
    const message = await response.text();
    throw new Error(message || "Failed to delete image.");
  }
};
</file>

<file path="utils/generateSlug.ts">
export const generateSlug = (value: string) => {
    return value
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9\s-]/g, "")
      .replace(/\s+/g, "-")
      .replace(/-+/g, "-");
  };
</file>

