<file path="app/sitemap.ts">
import type { MetadataRoute } from "next";

import { getPublishedBlogs } from "@/lib/api/blogs";
import { getPublishedProjects } from "@/lib/api/projects";
import { getPublishedServices } from "@/lib/api/services";
import { getPublishedProducts } from "@/lib/api/products";
import { siteUrl } from "@/lib/site-url";

type PaginatedResult<T> = {
  meta: {
    page: number;
    limit: number;
    total: number;
    totalPages: number;
  };
  data: T[];
};

/**
 * Fetch every page of a paginated API response.
 */
async function fetchAllPages<T>(
  fetchPage: (
    page: number,
    limit: number,
  ) => Promise<PaginatedResult<T>>,
  pageSize = 100,
): Promise<T[]> {
  const firstPage = await fetchPage(1, pageSize);

  const totalPages = Math.max(1, firstPage.meta.totalPages || 1);
  const limit = firstPage.meta.limit || pageSize;

  if (totalPages === 1) {
    return firstPage.data;
  }

  const remainingPages = await Promise.all(
    Array.from({ length: totalPages - 1 }, (_, index) =>
      fetchPage(index + 2, limit),
    ),
  );

  return [firstPage, ...remainingPages].flatMap(
    (result) => result.data,
  );
}

export default async function sitemap(): Promise<MetadataRoute.Sitemap> {
  const staticRoutes: MetadataRoute.Sitemap = [
    {
      url: siteUrl,
      changeFrequency: "weekly",
      priority: 1,
    },
    {
      url: `${siteUrl}/about`,
      changeFrequency: "monthly",
      priority: 0.8,
    },
    {
      url: `${siteUrl}/services`,
      changeFrequency: "monthly",
      priority: 0.9,
    },
    {
      url: `${siteUrl}/projects`,
      changeFrequency: "monthly",
      priority: 0.9,
    },
    {
      url: `${siteUrl}/products`,
      changeFrequency: "monthly",
      priority: 0.9,
    },
    {
      url: `${siteUrl}/blog`,
      changeFrequency: "weekly",
      priority: 0.8,
    },
    {
      url: `${siteUrl}/contact`,
      changeFrequency: "monthly",
      priority: 0.8,
    },
    {
      url: `${siteUrl}/best-roof-waterproofing-company-in-bangladesh`,
      lastModified: new Date("2026-03-13T00:00:00.000Z"),
      changeFrequency: "monthly",
      priority: 0.9,
    },
  ];

  /* ------------------------------------------------------------------------ */
  /* SERVICES                                                                 */
  /* ------------------------------------------------------------------------ */

  let serviceRoutes: MetadataRoute.Sitemap = [];

  try {
    const services = await fetchAllPages((page, limit) =>
      getPublishedServices({ page, limit }),
    );

    serviceRoutes = services
      .filter(
        (service) =>
          service.status === "published" &&
          service.seo?.noIndex !== true,
      )
      .map((service) => ({
        url: `${siteUrl}/services/${service.slug}`,
        lastModified: service.updatedAt
          ? new Date(service.updatedAt)
          : undefined,
        changeFrequency: "monthly" as const,
        priority: 0.8,
      }));
  } catch (error) {
    console.error("Failed to generate service sitemap routes:", error);
  }

  /* ------------------------------------------------------------------------ */
  /* PROJECTS                                                                 */
  /* ------------------------------------------------------------------------ */

  let projectRoutes: MetadataRoute.Sitemap = [];

  try {
    const projects = await fetchAllPages((page, limit) =>
      getPublishedProjects({ page, limit }),
    );

    projectRoutes = projects
      .filter(
        (project) =>
          project.status === "published" &&
          project.seo?.noIndex !== true,
      )
      .map((project) => ({
        url: `${siteUrl}/projects/${project.slug}`,
        lastModified: project.updatedAt
          ? new Date(project.updatedAt)
          : undefined,
        changeFrequency: "monthly" as const,
        priority: 0.8,
      }));
  } catch (error) {
    console.error("Failed to generate project sitemap routes:", error);
  }

  /* ------------------------------------------------------------------------ */
  /* PRODUCTS                                                                 */
  /* ------------------------------------------------------------------------ */

  let productRoutes: MetadataRoute.Sitemap = [];

  try {
    const firstPage = await getPublishedProducts({
      page: 1,
      limit: 100,
    });

    const remainingPages = await Promise.all(
      Array.from(
        {
          length: Math.max(
            0,
            firstPage.meta.totalPages - 1,
          ),
        },
        (_, index) =>
          getPublishedProducts({
            page: index + 2,
            limit: firstPage.meta.limit || 100,
          }),
      ),
    );

    productRoutes = [firstPage, ...remainingPages]
      .flatMap(({ data }) => data)
      .filter(
        (product) =>
          product.status === "published" &&
          product.seo?.noIndex !== true,
      )
      .map((product) => ({
        url: `${siteUrl}/products/${product.slug}`,
        lastModified: product.updatedAt
          ? new Date(product.updatedAt)
          : undefined,
        changeFrequency: "monthly" as const,
        priority: 0.7,
      }));
  } catch (error) {
    console.error("Failed to generate product sitemap routes:", error);
  }

  /* ------------------------------------------------------------------------ */
  /* BLOG                                                                     */
  /* ------------------------------------------------------------------------ */

  let blogRoutes: MetadataRoute.Sitemap = [];

  try {
    const blogs = await fetchAllPages((page, limit) =>
      getPublishedBlogs({ page, limit }),
    );

    blogRoutes = blogs
      .filter(
        (post) =>
          post.status === "published" &&
          post.seo?.noIndex !== true,
      )
      .map((post) => ({
        url: `${siteUrl}/blog/${post.slug}`,
        lastModified: post.updatedAt
          ? new Date(post.updatedAt)
          : undefined,
        changeFrequency: "monthly" as const,
        priority: 0.7,
      }));
  } catch (error) {
    console.error("Failed to generate blog sitemap routes:", error);
  }

  /* ------------------------------------------------------------------------ */
  /* FINAL SITEMAP                                                            */
  /* ------------------------------------------------------------------------ */

  return [
    ...staticRoutes,
    ...serviceRoutes,
    ...projectRoutes,
    ...productRoutes,
    ...blogRoutes,
  ];
}
</file>

<file path="components/dashboard/admin/ecommerce/orders/OrderDetailsModal.tsx">
"use client";

import { Badge } from "@/components/ui/badge";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";
import type { AdminOrder } from "@/types";
import {
  BadgeCheck,
  Check,
  Package,
  PackageCheck,
  ShoppingBag,
  Truck,
  XCircle,
  type LucideIcon,
} from "lucide-react";
import { motion, useReducedMotion } from "motion/react";
import Image from "next/image";
import {
  formatOrderAmount,
  formatOrderDate,
  prettyOrderStatus,
} from "./orderActionUtils";

const statusStyles: Record<string, string> = {
  pending: "border-amber-200 bg-amber-50 text-amber-700",
  confirmed: "border-blue-200 bg-blue-50 text-blue-700",
  processing: "border-indigo-200 bg-indigo-50 text-indigo-700",
  shipped: "border-violet-200 bg-violet-50 text-violet-700",
  delivered: "border-emerald-200 bg-emerald-50 text-emerald-700",
  cancelled: "border-red-200 bg-red-50 text-red-700",
  paid: "border-emerald-200 bg-emerald-50 text-emerald-700",
  failed: "border-red-200 bg-red-50 text-red-700",
  refunded: "border-slate-200 bg-slate-100 text-slate-700",
};

function Detail({ label, value }: { label: string; value: string }) {
  return (
    <div className="space-y-1">
      <p className="text-xs font-medium uppercase tracking-wide text-muted-foreground">
        {label}
      </p>
      <p className="break-words font-medium text-foreground">
        {value || "—"}
      </p>
    </div>
  );
}

function StatusBadge({ status }: { status: string }) {
  return (
    <Badge
      variant="outline"
      className={statusStyles[status] ?? "capitalize"}
    >
      {prettyOrderStatus(status)}
    </Badge>
  );
}

const fulfillmentStages: {
  status: AdminOrder["status"];
  label: string;
  Icon: LucideIcon;
}[] = [
  { status: "pending", label: "Order Placed", Icon: ShoppingBag },
  { status: "confirmed", label: "Confirmed", Icon: BadgeCheck },
  { status: "processing", label: "Processing", Icon: Package },
  { status: "shipped", label: "Shipped", Icon: Truck },
  { status: "delivered", label: "Delivered", Icon: PackageCheck },
];

const SEGMENT_DURATION = 0.45; // seconds the bar takes to travel between two stages

function OrderTrackingTimeline({ order }: { order: AdminOrder }) {
  const prefersReducedMotion = useReducedMotion();

  if (order.status === "cancelled") {
    return (
      <section
        aria-label="Order cancellation status"
        className="rounded-2xl border border-red-200 bg-red-50 p-4 dark:border-red-900 dark:bg-red-950/30 sm:p-5"
      >
        <div className="flex items-start gap-3">
          <span className="grid size-10 shrink-0 place-items-center rounded-xl bg-red-100 text-red-700 dark:bg-red-900/50 dark:text-red-300">
            <XCircle className="size-5" aria-hidden="true" />
          </span>
          <div className="min-w-0">
            <h3 className="font-semibold text-red-900 dark:text-red-200">
              Order Cancelled
            </h3>
            <p className="mt-1 text-sm leading-5 text-red-800/80 dark:text-red-200/80">
              This order is no longer progressing through fulfilment.
            </p>
            {order.cancellationReason && (
              <p className="mt-3 text-sm text-red-900 dark:text-red-200">
                <span className="font-semibold">Reason:</span>{" "}
                {order.cancellationReason}
              </p>
            )}
          </div>
        </div>
      </section>
    );
  }

  const currentIndex = Math.max(
    fulfillmentStages.findIndex(
      (stage) => stage.status === order.status,
    ),
    0,
  );
  const lastIndex = fulfillmentStages.length - 1;
  const isDelivered = order.status === "delivered";

  // One shared clock: the bar moves at a constant speed (linear), so stage `i`
  // is reached at exactly i * SEGMENT_DURATION. Nodes/labels use the same value.
  const reachTime = (index: number) =>
    prefersReducedMotion ? 0 : index * SEGMENT_DURATION;
  const totalFillTime = reachTime(currentIndex);

  return (
    <section
      aria-label="Order fulfilment progress"
      className="rounded-2xl border bg-card p-4 text-card-foreground sm:p-5"
    >
      <div className="mb-5 flex flex-wrap items-center justify-between gap-2">
        <h3 className="font-semibold text-navy dark:text-foreground">
          Order tracking
        </h3>
        <p className="text-xs text-muted-foreground">
          {prettyOrderStatus(order.status)}
        </p>
      </div>

      {/* key replays the whole sequence when the order or its status changes */}
      <ol
        key={`${order.orderNumber}-${order.status}`}
        className="relative grid grid-cols-5 gap-1"
      >
        {fulfillmentStages.map(({ status, label, Icon }, index) => {
          const isCurrent = index === currentIndex;
          const isComplete = index < currentIndex || isDelivered;
          const isReached = isCurrent || isComplete;
          const delay = reachTime(index);
          const nodeFade = {
            duration: prefersReducedMotion ? 0 : 0.3,
            delay,
            ease: "easeOut" as const,
          };

          return (
            <li
              key={status}
              className="relative flex min-w-0 flex-col items-center text-center"
              aria-current={isCurrent ? "step" : undefined}
            >
              {/* Track + fill (drawn once from the first step, spans centre-to-centre) */}
              {index === 0 && (
                <span
                  aria-hidden="true"
                  className="pointer-events-none absolute left-1/2 top-4 z-0 h-1 w-[calc(400%+1rem)] -translate-y-1/2 overflow-hidden rounded-full bg-border sm:top-5"
                >
                  {currentIndex > 0 && (
                    <motion.span
                      initial={
                        prefersReducedMotion ? false : { scaleX: 0 }
                      }
                      animate={{ scaleX: currentIndex / lastIndex }}
                      transition={{
                        duration: prefersReducedMotion
                          ? 0
                          : totalFillTime,
                        ease: "linear",
                      }}
                      style={{ transformOrigin: "left center" }}
                      className="absolute inset-0 rounded-full bg-blue will-change-transform"
                    />
                  )}
                </span>
              )}

              {/* Glow pulse behind the current step. The loops run from mount;
                  only the wrapper fades in once the bar arrives, so nothing
                  restarts or pops at the end of the fill. */}
              {isCurrent && !prefersReducedMotion && (
                <motion.span
                  aria-hidden="true"
                  initial={{ opacity: 0 }}
                  animate={{ opacity: 1 }}
                  transition={{
                    duration: 0.35,
                    delay: totalFillTime,
                    ease: "easeOut",
                  }}
                  className="pointer-events-none absolute left-1/2 top-0 z-0 size-8 -translate-x-1/2 sm:size-10"
                >
                  <motion.span
                    className="absolute -inset-2 rounded-full bg-[radial-gradient(circle,rgba(1,110,220,0.55)_0%,rgba(1,110,220,0)_70%)]"
                    animate={{
                      opacity: [0.35, 0.9, 0.35],
                      scale: [0.95, 1.25, 0.95],
                    }}
                    transition={{
                      duration: 2.2,
                      repeat: Infinity,
                      ease: "easeInOut",
                    }}
                  />
                  <motion.span
                    className="absolute inset-0 rounded-full border-2 border-blue"
                    animate={{ opacity: [0.5, 0], scale: [1, 1.8] }}
                    transition={{
                      duration: 2.2,
                      repeat: Infinity,
                      ease: "easeOut",
                    }}
                  />
                </motion.span>
              )}

              {/* Step node: muted base + blue layer that fades in when the bar arrives */}
              <span className="relative z-10 grid size-8 place-items-center rounded-full border border-border bg-muted text-muted-foreground sm:size-10">
                <Icon
                  className="size-4 sm:size-[18px]"
                  aria-hidden="true"
                />

                {isReached && (
                  <motion.span
                    initial={
                      prefersReducedMotion ? false : { opacity: 0 }
                    }
                    animate={{ opacity: 1 }}
                    transition={nodeFade}
                    className={`absolute -inset-px grid place-items-center rounded-full border border-blue bg-blue text-white ${
                      isCurrent
                        ? "shadow-[0_0_14px_rgba(1,110,220,0.5)] ring-4 ring-blue/20"
                        : "shadow-[0_0_6px_rgba(1,110,220,0.25)]"
                    }`}
                  >
                    <Icon
                      className="size-4 sm:size-[18px]"
                      aria-hidden="true"
                    />
                  </motion.span>
                )}

                {isComplete && (
                  <motion.span
                    initial={
                      prefersReducedMotion
                        ? false
                        : { opacity: 0, scale: 0 }
                    }
                    animate={{ opacity: 1, scale: 1 }}
                    transition={{
                      duration: prefersReducedMotion ? 0 : 0.25,
                      delay: delay + 0.12,
                      ease: "easeOut",
                    }}
                    className="absolute -right-1 -bottom-1 z-10 grid size-4 place-items-center rounded-full border border-card bg-card text-blue"
                  >
                    <Check className="size-3" aria-hidden="true" />
                  </motion.span>
                )}
              </span>

              {/* Label: muted text fades out while the active text fades in, same clock */}
              <span className="relative mt-2 max-w-full text-[9px] font-medium leading-tight sm:text-xs">
                <motion.span
                  className="block text-muted-foreground"
                  initial={{ opacity: 1 }}
                  animate={{ opacity: isReached ? 0 : 1 }}
                  transition={nodeFade}
                >
                  {label}
                </motion.span>
                {isReached && (
                  <motion.span
                    initial={
                      prefersReducedMotion ? false : { opacity: 0 }
                    }
                    animate={{ opacity: 1 }}
                    transition={nodeFade}
                    className={`absolute inset-0 block whitespace-nowrap ${
                      isCurrent
                        ? "font-semibold text-blue"
                        : "text-foreground"
                    }`}
                  >
                    {label}
                  </motion.span>
                )}
              </span>

              {isCurrent && (
                <motion.span
                  initial={
                    prefersReducedMotion
                      ? false
                      : { opacity: 0, y: -3 }
                  }
                  animate={{ opacity: 1, y: 0 }}
                  transition={{ ...nodeFade, delay: delay + 0.1 }}
                  className="mt-1 text-[8px] font-semibold uppercase tracking-wide text-blue sm:text-[9px]"
                >
                  Current Status
                </motion.span>
              )}
            </li>
          );
        })}
      </ol>
    </section>
  );
}

type OrderDetailsModalProps = {
