import {
  defaultNotificationPreferences,
  INotificationPreferences,
} from "@/types/user-preferences.type";

export async function fetchNotificationPreferences(): Promise<INotificationPreferences> {
  const response = await fetch("/api/user/notification-preferences", {
    method: "GET",
    headers: {
      "Content-Type": "application/json",
    },
    cache: "no-store",
  });

  if (!response.ok) {
    throw new Error("Failed to load notification preferences.");
  }

  const json = await response.json();
  return json.data || defaultNotificationPreferences;
}

export async function updateNotificationPreferences(
  preferences: Partial<INotificationPreferences>,
): Promise<INotificationPreferences> {
  const response = await fetch("/api/user/notification-preferences", {
    method: "PATCH",
    headers: {
      "Content-Type": "application/json",
    },
    body: JSON.stringify(preferences),
  });

  if (!response.ok) {
    const errorData = await response.json().catch(() => null);
    throw new Error(
      errorData?.error || "Failed to update notification preferences.",
    );
  }

  const json = await response.json();
  return json.data;
}
</file>

<file path="lib/consent/consent-store.ts">
export interface VisitorConsent {
  essential: true;
  analytics: boolean;
  marketing: boolean;
  timestamp: number;
  decided: boolean;
}

export const CONSENT_STORAGE_KEY = "enviroshield_consent_preferences";
export const CONSENT_EVENT_NAME = "enviroshield_consent_change";
export const OPEN_PREFERENCES_EVENT = "open_cookie_preferences";

export const defaultConsentState: VisitorConsent = {
  essential: true,
  analytics: false,
  marketing: false,
  timestamp: 0,
  decided: false,
};

export function getStoredConsent(): VisitorConsent {
  if (typeof window === "undefined") {
    return defaultConsentState;
  }

  try {
    const raw = localStorage.getItem(CONSENT_STORAGE_KEY);
    if (!raw) return defaultConsentState;

    const parsed = JSON.parse(raw);
    if (typeof parsed === "object" && parsed !== null && parsed.decided) {
      return {
        essential: true,
        analytics: Boolean(parsed.analytics),
        marketing: Boolean(parsed.marketing),
        timestamp: Number(parsed.timestamp) || Date.now(),
        decided: true,
      };
    }
  } catch (e) {
    console.warn("Error parsing stored cookie consent:", e);
  }

  return defaultConsentState;
}

export function saveConsent(consent: {
  analytics: boolean;
  marketing: boolean;
}): VisitorConsent {
  const record: VisitorConsent = {
    essential: true,
    analytics: consent.analytics,
    marketing: consent.marketing,
    timestamp: Date.now(),
    decided: true,
  };

  if (typeof window !== "undefined") {
    try {
      localStorage.setItem(CONSENT_STORAGE_KEY, JSON.stringify(record));
      // Also set a 1-year cookie for SSR awareness
      const expires = new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toUTCString();
      document.cookie = `enviroshield_consent=${encodeURIComponent(
        JSON.stringify({
          analytics: record.analytics,
          marketing: record.marketing,
          decided: true,
        }),
      )}; expires=${expires}; path=/; SameSite=Lax`;
    } catch (e) {
      console.warn("Error storing consent:", e);
    }

    window.dispatchEvent(
      new CustomEvent<VisitorConsent>(CONSENT_EVENT_NAME, {
        detail: record,
      }),
    );
  }

  return record;
}

export function openConsentPreferences() {
  if (typeof window !== "undefined") {
    window.dispatchEvent(new CustomEvent(OPEN_PREFERENCES_EVENT));
  }
}
</file>

