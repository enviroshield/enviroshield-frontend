              animate={{ opacity: 1 }}
              transition={{
                duration: 0.5,
                delay: 0.8,
              }}
            >
              <Link
                href="/"
                className="text-[12px] font-bold text-ink transition-colors hover:text-blue"
              >
                Back to Enviroshield
              </Link>
            </motion.div>
          </motion.div>
        </div>
      </section>
    </main>
  );
}
</file>

