<file path="lib/api/projects.ts">
import type {
  IProject,
  IProjectResponse,
  IProjectSingleResponse,
} from "@/types/project.type";

const API_BASE_URL =
  process.env.NODE_ENV === "development"
    ? process.env.NEXT_PUBLIC_DEV_API_BASE_URL
    : process.env.NEXT_PUBLIC_API_BASE_URL;

type PaginationOptions = {
  page?: number;
  limit?: number;
};

function getBaseUrl() {
  if (!API_BASE_URL) {
    throw new Error("API base URL is not configured.");
  }
  return API_BASE_URL.replace(/\/+$/, "");
}

export async function getPublishedProjects({
  page = 1,
  limit = 10,
}: PaginationOptions = {}): Promise<IProjectResponse> {
  const params = new URLSearchParams({ page: String(page), limit: String(limit) });
  const response = await fetch(`${getBaseUrl()}/project/published?${params}`, {
    next: { revalidate: 60, tags: ["published-projects"] },
  });

  if (!response.ok) {
    throw new Error(`Failed to fetch published projects: ${response.status}`);
  }

  const result: IProjectResponse = await response.json();
  if (!result.success) {
    throw new Error(result.message || "Failed to fetch published projects.");
  }
  return result;
}

export async function getFeaturedProjects(): Promise<IProject[]> {
  const response = await fetch(`${getBaseUrl()}/project/featured`, {
    next: { revalidate: 60, tags: ["featured-projects"] },
  });

  if (!response.ok) {
    throw new Error(`Failed to fetch featured projects: ${response.status}`);
  }

  const result: { success: boolean; message: string; data: IProject[] } =
    await response.json();
  if (!result.success) {
    throw new Error(result.message || "Failed to fetch featured projects.");
  }
  return result.data ?? [];
}

export async function getPublishedProjectBySlug(
  slug: string,
): Promise<IProject> {
  const response = await fetch(
    `${getBaseUrl()}/project/slug/${encodeURIComponent(slug)}`,
    {
      next: {
        revalidate: 60,
        tags: ["published-projects", `published-project-${slug}`],
      },
    },
  );

  if (response.status === 404) {
    throw new Error("Project not found.");
  }
  if (!response.ok) {
    throw new Error(`Failed to fetch project: ${response.status}`);
  }

  const result: IProjectSingleResponse = await response.json();
  if (!result.success || !result.data) {
    throw new Error(result.message || "Failed to fetch project.");
  }
  return result.data;
}
</file>

<file path="lib/cart.ts">
export type CartItem = {
  productId: string;
  variantId?: string;
  weight?: string;
  size?: string;
  slug: string;
  sku?: string;
  name: string;
  price: number;
  image: string;
  imageAlt: string;
  quantity: number;
  /** Cached stock is only used to keep the cart controls within known limits. */
  stockQuantity?: number;
};

const KEY = "enviroshield-cart";
export const CART_EVENT = "cart:updated";
const EMPTY_CART: CartItem[] = [];
let cartSnapshot: CartItem[] = EMPTY_CART;
let cartInitialized = false;
const cartListeners = new Set<() => void>();

function notifyCartListeners() {
  cartListeners.forEach((listener) => listener());
}

export function getItemKey(productId: string, variantId?: string): string {
  return `${productId}:${variantId || ""}`;
}

export function subscribeToCart(listener: () => void) {
  cartListeners.add(listener);
  if (typeof window !== "undefined") {
    window.addEventListener(CART_EVENT, notifyCartListeners);
    window.addEventListener("storage", onStorage);
  }
  return () => {
    cartListeners.delete(listener);
    if (typeof window !== "undefined") {
      window.removeEventListener(CART_EVENT, notifyCartListeners);
      window.removeEventListener("storage", onStorage);
    }
  };
}

function onStorage(event: StorageEvent) {
  if (event.key !== KEY) return;
  cartSnapshot = readCart();
  notifyCartListeners();
}

export function getCartSnapshot() {
  return cartSnapshot;
}

export function getCartServerSnapshot() {
  return EMPTY_CART;
}

export function isCartInitialized() {
  return cartInitialized;
}

export function initializeCartStore() {
  if (typeof window === "undefined" || cartInitialized) return;
  cartSnapshot = readCart();
  cartInitialized = true;
  notifyCartListeners();
}

function isCartItem(value: unknown): value is CartItem {
  if (typeof value !== "object" || value === null) return false;
  const item = value as Record<string, unknown>;
  return (
    typeof item.productId === "string" &&
    typeof item.slug === "string" &&
    typeof item.name === "string" &&
    typeof item.price === "number" &&
    Number.isFinite(item.price) &&
    typeof item.image === "string" &&
    Number.isInteger(item.quantity) &&
    (item.quantity as number) >= 1
  );
}

export function readCart(): CartItem[] {
  if (typeof window === "undefined") return [];

  try {
    const raw = window.localStorage.getItem(KEY);
    const parsed: unknown = raw ? JSON.parse(raw) : [];
    if (!Array.isArray(parsed)) return [];

    const validItems = parsed.filter(isCartItem).map((item) => ({
      ...item,
      variantId: typeof item.variantId === "string" ? item.variantId : "",
      size: typeof item.size === "string" ? item.size : "",
      sku: typeof item.sku === "string" ? item.sku : "",
      imageAlt: typeof item.imageAlt === "string" ? item.imageAlt : item.name,
      quantity: Math.min(99, item.quantity),
    }));

    return validItems;
  } catch {
    return [];
  }
}

function writeCart(items: CartItem[]) {
  if (typeof window === "undefined") return;
  cartSnapshot = items;
  cartInitialized = true;
  try {
    window.localStorage.setItem(KEY, JSON.stringify(items));
  } catch {
    // Storage can be disabled or full. Keep the in-memory UI responsive.
  }
  window.dispatchEvent(new CustomEvent(CART_EVENT, { detail: items }));
}

export function addToCart(
  item: Omit<CartItem, "quantity">,
  quantity: number,
  max = Infinity,
): number {
  if (!Number.isFinite(quantity) || quantity < 1) return 0;
  const items = readCart();
  const existing = items.find(
    (candidate) =>
      candidate.productId === item.productId &&
      (candidate.variantId || "") === (item.variantId || ""),
  );
  const limit = Math.max(1, Math.min(99, max));
  const next = Math.min((existing?.quantity ?? 0) + Math.floor(quantity), limit);

  if (existing) {
    Object.assign(existing, item, { quantity: next });
  } else {
    items.push({ ...item, quantity: next });
  }

  writeCart(items);
  return next;
}

export function updateCartQuantity(
  productId: string,
  quantity: number,
  variantId?: string,
) {
  const targetVariant = variantId || "";
  const items = readCart().map((item) => {
    const matches =
      item.productId === productId &&
      (variantId !== undefined ? (item.variantId || "") === targetVariant : true);

    if (!matches) return item;

    const stockLimit = Number.isFinite(item.stockQuantity)
      ? Math.max(1, item.stockQuantity ?? 1)
      : 99;
    return {
      ...item,
      quantity: Math.max(1, Math.min(99, stockLimit, Math.floor(quantity) || 1)),
    };
  });
  writeCart(items);
}

export function removeFromCart(productId: string, variantId?: string) {
  const targetVariant = variantId || "";
  writeCart(
    readCart().filter((item) => {
      if (item.productId !== productId) return true;
      if (variantId !== undefined) {
        return (item.variantId || "") !== targetVariant;
      }
      return false;
    }),
  );
}

export function clearCart() {
  writeCart([]);
}

export function cartCount(items = readCart()): number {
  return items.reduce((sum, item) => sum + item.quantity, 0);
}

export function cartSubtotal(items: CartItem[]): number {
  return items.reduce((sum, item) => sum + item.price * item.quantity, 0);
}
</file>

