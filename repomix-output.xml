            <p className="mb-2 flex items-center gap-1.5 text-[12px] font-bold text-blue transition-colors duration-300 group-hover:text-paste">
              <MapPin
                size={13}
                aria-hidden="true"
                className="shrink-0"
              />
              <span className="line-clamp-1">{location}</span>
