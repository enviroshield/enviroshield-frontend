"use client";

import { useEffect, useMemo, useState, type FormEvent } from "react";
import { ArrowDown, ArrowUp, Loader2, PackagePlus } from "lucide-react";
import { toast } from "sonner";
import { mutate } from "swr";

import DashboardButton from "@/components/dashboard/DashboardButton";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { axiosInstance } from "@/lib/axios";
import type {
  InventoryAdjustmentResponse,
  InventoryMovementType,
} from "@/types/inventory.type";
import type { IProduct, IProductResponse } from "@/types";

type StockAdjustmentModalProps = {
  product: IProduct | null;
  open: boolean;
  revalidateKey: string;
  onClose: () => void;
};

type AdjustmentField = "variantId" | "movementType" | "quantity" | "reason";
type AdjustmentErrors = Partial<Record<AdjustmentField, string>>;
type ErrorSource = { path: string; message: string };
type ApiErrorPayload = {
  message?: unknown;
  errorSources?: unknown;
  response?: { data?: unknown };
};

function readApiError(error: unknown) {
  const outer =
    error && typeof error === "object" ? (error as ApiErrorPayload) : null;
  const payload = outer?.response?.data ?? error;
  const details =
    payload && typeof payload === "object"
      ? (payload as ApiErrorPayload)
      : null;
  const message =
    typeof details?.message === "string" ? details.message : undefined;
  const sources = Array.isArray(details?.errorSources)
    ? details.errorSources.filter(
        (source): source is ErrorSource =>
          Boolean(source) &&
          typeof source === "object" &&
          "path" in source &&
          typeof source.path === "string" &&
          "message" in source &&
          typeof source.message === "string",
      )
    : [];

  return { message, sources };
}

function getAdjustmentField(path: string): AdjustmentField | undefined {
  const field = path.toLowerCase().split(".").at(-1);
  if (field === "variantid") return "variantId";
  if (field === "quantity") return "quantity";
  if (field === "reason") return "reason";
  if (field === "movementtype") return "movementType";
  return undefined;
}

export default function StockAdjustmentModal({
  product,
  open,
  revalidateKey,
  onClose,
}: StockAdjustmentModalProps) {
  const variants = useMemo(() => product?.variants ?? [], [product?.variants]);
  const hasVariants = variants.length > 0;

  const [selectedVariantId, setSelectedVariantId] = useState<string>("");
  const [movementType, setMovementType] =
    useState<InventoryMovementType>("increase");
  const [quantity, setQuantity] = useState("");
  const [reason, setReason] = useState("");
  const [errors, setErrors] = useState<AdjustmentErrors>({});
  const [isSubmitting, setIsSubmitting] = useState(false);

  // Default to first variant when opened
  useEffect(() => {
    if (open && hasVariants && variants[0]?._id) {
      setSelectedVariantId(variants[0]._id);
    } else {
      setSelectedVariantId("");
    }
  }, [open, hasVariants, variants]);

  const selectedVariant = useMemo(() => {
    if (!hasVariants) return undefined;
    return (
      variants.find((v) => v._id === selectedVariantId) ??
      variants[0]
    );
  }, [hasVariants, variants, selectedVariantId]);

  const resetForm = () => {
    setMovementType("increase");
    setQuantity("");
    setReason("");
    setErrors({});
    if (hasVariants && variants[0]?._id) {
      setSelectedVariantId(variants[0]._id);
    } else {
      setSelectedVariantId("");
    }
  };

  const handleClose = () => {
    if (isSubmitting) return;
    resetForm();
    onClose();
  };

  const handleApiError = (error: unknown) => {
    const { message, sources } = readApiError(error);
    const mappedErrors: AdjustmentErrors = {};
    let hasUnmappedError = false;

    for (const source of sources) {
      const field = getAdjustmentField(source.path);
      if (field) {
        mappedErrors[field] = source.message;
      } else {
        hasUnmappedError = true;
      }
    }

    if (Object.keys(mappedErrors).length > 0) {
      setErrors((current) => ({ ...current, ...mappedErrors }));
    }

    if (sources.length === 0 || hasUnmappedError) {
      toast.error(
        message || "The stock adjustment could not be completed.",
      );
    }
  };

  const handleSubmit = async (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    if (!product || isSubmitting) return;

    const nextErrors: AdjustmentErrors = {};
    const quantityValue = Number(quantity);

    if (hasVariants && !selectedVariant) {
      nextErrors.variantId = "Please select a product variant.";
    }

    if (
      !quantity.trim() ||
      !Number.isFinite(quantityValue) ||
      quantityValue <= 0 ||
      !Number.isInteger(quantityValue)
    ) {
      nextErrors.quantity = "Enter a positive whole number for quantity.";
    } else if (movementType === "decrease") {
      const currentAvailable = selectedVariant
        ? selectedVariant.stockQuantity
        : product.stockQuantity;
      if (quantityValue > currentAvailable) {
        nextErrors.quantity = `Insufficient stock. Maximum available to decrease is ${currentAvailable} units.`;
      }
    }

    if (!reason.trim()) {
      nextErrors.reason = "Enter a reason for this stock adjustment.";
    } else if (reason.trim().length < 3) {
      nextErrors.reason = "Reason must contain at least 3 characters.";
    }

    setErrors(nextErrors);
    if (Object.keys(nextErrors).length > 0) return;

    setIsSubmitting(true);

    try {
      const response = await axiosInstance.post<InventoryAdjustmentResponse>(
        `/inventory/${encodeURIComponent(product._id)}/adjust`,
        {
          variantId: hasVariants ? (selectedVariant?._id || selectedVariantId) : undefined,
          movementType,
          quantity: quantityValue,
          reason: reason.trim(),
        },
      );
      const result = response.data;

      if (!result.success) {
        handleApiError(result);
        return;
      }

      const updatedProduct = result.data.product;

      // Optimistically update list cache
      void mutate<IProductResponse>(
        revalidateKey,
        (current) =>
          current
            ? {
                ...current,
                data: current.data.map((item) =>
                  item._id === updatedProduct._id
                    ? {
                        ...item,
                        stockQuantity: updatedProduct.stockQuantity,
                        variants: updatedProduct.variants ?? item.variants,
                      }
                    : item,
                ),
              }
            : current,
        { revalidate: false },
      );
      void mutate(revalidateKey);
      void mutate(
        (key) => typeof key === "string" && key.startsWith("/inventory"),
      );
      void mutate(
        (key) => typeof key === "string" && key.startsWith("/product"),
      );

      toast.success(result.message || "Stock adjusted successfully.");
      resetForm();
      onClose();
    } catch (error: unknown) {
      handleApiError(error);
    } finally {
      setIsSubmitting(false);
    }
  };

  const numericQuantity = Number(quantity);
  const hasQuantity =
    quantity.trim() !== "" &&
    Number.isFinite(numericQuantity) &&
    numericQuantity > 0;

  const totalProjectedStock = product
    ? product.stockQuantity +
      (movementType === "increase" ? numericQuantity : -numericQuantity)
    : undefined;

  const variantProjectedStock = selectedVariant
    ? selectedVariant.stockQuantity +
      (movementType === "increase" ? numericQuantity : -numericQuantity)
    : undefined;

  return (
    <Dialog
      open={open}
      onOpenChange={(nextOpen) => {
        if (!nextOpen) handleClose();
      }}
    >
      <DialogContent className="max-h-[90vh] overflow-y-auto rounded-2xl border-0 p-0 shadow-2xl sm:max-w-xl">
        <DialogHeader className="border-b px-6 py-5 text-left sm:px-8">
          <div className="mb-2 flex h-11 w-11 items-center justify-center rounded-xl bg-blue/10 text-blue">
            <PackagePlus className="h-5 w-5" />
          </div>
          <DialogTitle className="text-xl font-bold text-navy">
            Adjust Stock
          </DialogTitle>
          <DialogDescription className="text-sm leading-6">
            Record a stock increase or decrease for this product and its variant.
          </DialogDescription>
          <div className="pt-1">
            <p className="text-sm font-semibold text-navy">
              {product?.name ?? "Selected product"}
            </p>
            {product?.sku && (
              <p className="mt-1 text-xs text-slate-500">Base SKU: {product.sku}</p>
            )}
          </div>
        </DialogHeader>

        <form onSubmit={handleSubmit} noValidate>
          <div className="space-y-5 px-6 py-6 sm:px-8">
            {/* VARIANT SELECTOR */}
            {hasVariants && (
              <div className="space-y-2">
                <div className="flex items-center justify-between">
                  <Label
                    htmlFor="stock-adjustment-variant"
                    className="font-semibold text-navy text-xs"
                  >
                    Select Product Variant / Weight <span className="text-red-500">*</span>
                  </Label>
                  {selectedVariant?.sku && (
                    <span className="text-[11px] font-mono text-slate-500">
                      Variant SKU: <strong className="text-slate-700">{selectedVariant.sku}</strong>
                    </span>
                  )}
                </div>
                <Select
                  value={selectedVariant?._id ?? selectedVariantId}
                  onValueChange={(value) => {
                    setSelectedVariantId(value ?? "");
                    setErrors((current) => ({
                      ...current,
                      variantId: undefined,
                      quantity: undefined,
                    }));
                  }}
                  disabled={isSubmitting}
                >
                  <SelectTrigger
                    id="stock-adjustment-variant"
                    className="h-11 rounded-xl border-slate-200 w-full"
                    aria-invalid={Boolean(errors.variantId)}
                  >
                    <SelectValue placeholder="Choose a variant">
                      {selectedVariant ? (
                        <span className="flex items-center gap-2 text-xs">
                          <span className="font-semibold text-navy">
                            {selectedVariant.weight || selectedVariant.size || "Standard"}
                          </span>
                          <span className="text-slate-400">·</span>
                          <span className="text-slate-500">
                            Stock: <strong className="text-slate-700">{selectedVariant.stockQuantity}</strong>
                          </span>
                          <span className="text-slate-400">·</span>
                          <span className="text-blue font-medium">
                            ৳{selectedVariant.price.toLocaleString("en-BD")}
                          </span>
                        </span>
                      ) : undefined}
                    </SelectValue>
                  </SelectTrigger>
                  <SelectContent>
                    {variants.map((v) => {
                      const label = v.weight || v.size || "Standard";
                      return (
                        <SelectItem key={v._id} value={v._id}>
                          <div className="flex items-center justify-between gap-4 w-full text-xs">
                            <span className="font-semibold text-navy">
                              {label}
                            </span>
                            <span className="text-slate-500">
                              Stock: <strong className="text-slate-800">{v.stockQuantity}</strong>
                            </span>
                            <span className="text-blue font-medium">
                              ৳{v.price.toLocaleString("en-BD")}
                            </span>
                          </div>
                        </SelectItem>
                      );
                    })}
                  </SelectContent>
                </Select>
                {errors.variantId && (
                  <p className="text-sm text-destructive">{errors.variantId}</p>
                )}
              </div>
            )}

            {/* STOCK PREVIEW CARD */}
            <div className="rounded-xl border border-blue/15 bg-blue/[0.04] p-4">
              {hasVariants && selectedVariant ? (
                <div>
                  <div className="flex items-start justify-between gap-2">
                    <div>
                      <p className="text-xs font-medium text-slate-500">
                        Selected Variant Stock ({selectedVariant.weight || selectedVariant.size})
                      </p>
                      <p className="mt-1 text-xl font-bold text-navy">
                        {selectedVariant.stockQuantity.toLocaleString("en-BD")} units
                      </p>
                    </div>
                    <div className="text-right">
                      <p className="text-xs font-medium text-slate-500">
                        Total Across All Variants
                      </p>
                      <p className="mt-1 text-sm font-semibold text-slate-700">
                        {product?.stockQuantity.toLocaleString("en-BD") ?? "—"} units
                      </p>
                    </div>
                  </div>
                  {hasQuantity && (
                    <div className="mt-3 border-t border-blue/10 pt-2.5 flex items-center justify-between text-xs">
                      <div>
                        <span className="text-slate-500">After adjustment: </span>
                        <strong className="text-navy">
                          {variantProjectedStock?.toLocaleString("en-BD")} units
                        </strong>
                      </div>
                      <span className="text-slate-500">
                        Total: {totalProjectedStock?.toLocaleString("en-BD")} units
                      </span>
                    </div>
                  )}
                </div>
              ) : (
                <div>
                  <p className="text-xs font-medium text-slate-500">Current stock</p>
                  <p className="mt-1 text-lg font-bold text-navy">
                    {product?.stockQuantity.toLocaleString("en-BD") ?? "—"} units
                  </p>
                  {hasQuantity && product && (
                    <p className="mt-1 text-xs text-slate-500">
                      Expected stock after adjustment: {totalProjectedStock?.toLocaleString("en-BD")} units
                    </p>
                  )}
                </div>
              )}
            </div>

            {/* MOVEMENT TYPE */}
            <div className="space-y-2">
              <Label htmlFor="stock-adjustment-type" className="font-semibold text-navy text-xs">
                Movement Type
              </Label>
              <Select
                value={movementType}
                onValueChange={(value) => {
                  setMovementType(value === "decrease" ? "decrease" : "increase");
                  setErrors((current) => ({ ...current, movementType: undefined, quantity: undefined }));
                }}
                disabled={isSubmitting}
              >
                <SelectTrigger
                  id="stock-adjustment-type"
                  className="h-10 rounded-xl border-slate-200 w-full"
                  aria-invalid={Boolean(errors.movementType)}
                >
                  <SelectValue />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="increase">Increase Stock (Restock / Return)</SelectItem>
                  <SelectItem value="decrease">Decrease Stock (Damage / Manual Correction)</SelectItem>
                </SelectContent>
              </Select>
              {errors.movementType && (
                <p className="text-sm text-destructive">{errors.movementType}</p>
              )}
            </div>

            {/* QUANTITY */}
            <div className="space-y-2">
              <Label htmlFor="stock-adjustment-quantity" className="font-semibold text-navy text-xs">
                Quantity <span className="text-red-500">*</span>
              </Label>
              <Input
                id="stock-adjustment-quantity"
                type="number"
                min="1"
                step="1"
                inputMode="numeric"
                value={quantity}
                onChange={(event) => {
                  setQuantity(event.target.value);
                  setErrors((current) => ({ ...current, quantity: undefined }));
                }}
                disabled={isSubmitting}
                aria-invalid={Boolean(errors.quantity)}
                aria-describedby={errors.quantity ? "stock-quantity-error" : undefined}
                placeholder="Enter whole number quantity"
                className="h-10 rounded-xl border-slate-200"
              />
              {errors.quantity && (
                <p id="stock-quantity-error" className="text-sm text-destructive">
                  {errors.quantity}
                </p>
              )}
            </div>

            {/* REASON */}
            <div className="space-y-2">
              <Label htmlFor="stock-adjustment-reason" className="font-semibold text-navy text-xs">
                Reason <span className="text-red-500">*</span>
              </Label>
              <Input
                id="stock-adjustment-reason"
                type="text"
                value={reason}
                onChange={(event) => {
                  setReason(event.target.value);
                  setErrors((current) => ({ ...current, reason: undefined }));
                }}
                disabled={isSubmitting}
                aria-invalid={Boolean(errors.reason)}
                aria-describedby={errors.reason ? "stock-reason-error" : undefined}
                placeholder="e.g. Received new shipment from factory"
                className="h-10 rounded-xl border-slate-200"
              />
              {errors.reason && (
                <p id="stock-reason-error" className="text-sm text-destructive">
                  {errors.reason}
                </p>
              )}
            </div>
          </div>

          <div className="flex flex-col-reverse gap-3 border-t bg-muted/20 px-6 py-4 sm:flex-row sm:justify-end sm:px-8">
            <DashboardButton
              type="button"
              variant="outline"
              onClick={handleClose}
              disabled={isSubmitting}
              className="min-h-10 rounded-xl px-5"
            >
              Cancel
            </DashboardButton>
            <DashboardButton
              type="submit"
              disabled={isSubmitting || !product}
              icon={
                isSubmitting ? (
                  <Loader2 className="h-4 w-4 animate-spin" />
                ) : movementType === "increase" ? (
                  <ArrowUp className="h-4 w-4" />
                ) : (
                  <ArrowDown className="h-4 w-4" />
                )
              }
            >
              {isSubmitting ? "Adjusting..." : "Adjust Stock"}
            </DashboardButton>
          </div>
        </form>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="components/dashboard/admin/projects/CreateProjectModal.tsx">
"use client";

import { FormSection } from "../common/FormSection";

import { zodResolver } from "@hookform/resolvers/zod";
import {
  Check,
  ChevronLeft,
  ChevronRight,
  Loader2,
  Plus,
  Trash2,
} from "lucide-react";
import { useState, type ReactNode } from "react";
import { Controller, useFieldArray, useForm } from "react-hook-form";
import { toast } from "sonner";
import { z } from "zod";

import { formatAltFromFileName } from "@/lib/utils";
import { ImageUploader } from "@/components/image-uploader";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Switch } from "@/components/ui/switch";
import { Textarea } from "@/components/ui/textarea";
import { usePost } from "@/hooks/swr/usePost";
import { usePersistentFormDraft } from "@/hooks/usePersistentFormDraft";
import type { IService } from "@/types";
import { generateSlug } from "@/utils/generateSlug";

import DashboardButton from "../../DashboardButton";

const imageSchema = z.object({
  url: z.string().min(1, "Image is required"),
  publicId: z.string().min(1, "Image public ID is required"),
  alt: z.string().min(1, "Image alt text is required"),
  caption: z.string().min(1, "Image caption is required"),
});

const galleryItemSchema = z.object({
  url: z.string().min(1, "Gallery image is required"),
  publicId: z.string().min(1, "Gallery image public ID is required"),
  alt: z.string().min(1, "Gallery image alt text is required"),
});

const locationSchema = z.object({
  city: z.string().min(1, "City is required"),
  area: z.string().optional(),
  country: z.string().min(1, "Country is required"),
});

const clientSchema = z.object({
  name: z.string().min(1, "Client name is required"),
  description: z.string().optional(),
  logo: z
    .object({
      url: z.string().optional(),
      publicId: z.string().optional(),
      alt: z.string().optional(),
    })
    .optional(),
});

const seoSchema = z.object({
  metaTitle: z.string().optional(),
  metaDescription: z.string().optional(),
  keywords: z.array(z.string().min(1, "Keyword cannot be empty")),
  ogTitle: z.string().optional(),
  ogDescription: z.string().optional(),
  ogImage: z
    .string()
    .optional()
    .refine(
      (val) => !val || /^https?:\/\/.+/.test(val),
      "Enter a valid OG image URL",
    ),
  ogImagePublicId: z.string().optional(),
  noIndex: z.boolean(),
});

const formSchema = z.object({
  title: z
    .string()
    .min(1, "Project title is required")
    .max(150, "Project title must be 150 characters or less"),

  slug: z
    .string()
    .min(1, "Slug is required")
    .regex(
      /^[a-z0-9]+(?:-[a-z0-9]+)*$/,
      "Slug can only contain lowercase letters, numbers, and hyphens",
    ),

  primaryImage: imageSchema,

  description: z.string().min(1, "Description is required"),

  location: locationSchema,

  completionDate: z.string().min(1, "Completion date is required"),

  gallery: z
    .array(galleryItemSchema)
    .min(1, "At least one gallery image is required"),

  client: clientSchema,

  serviceId: z.string().min(1, "Service is required"),

  status: z.enum(["draft", "published"]),

  isFeatured: z.boolean(),

  seo: seoSchema,
});

type FormValues = z.infer<typeof formSchema>;

type CreateProjectModalProps = {
  isModalOpen: boolean;
  setIsModalOpen: (open: boolean) => void;
  onSuccess?: () => void;
  services: IService[];
  servicesLoading?: boolean;
  servicesError?: boolean;
};

const defaultValues: FormValues = {
  title: "",
  slug: "",

  primaryImage: {
    url: "",
    publicId: "",
    alt: "",
    caption: "",
  },

  description: "",

  location: {
    city: "",
    area: "",
    country: "",
  },

  completionDate: "",

  gallery: [
    {
      url: "",
      publicId: "",
      alt: "",
    },
  ],

  client: {
    name: "",
    description: "",
    logo: {
      url: "",
      publicId: "",
      alt: "",
    },
  },

  serviceId: "",

  status: "draft",

  isFeatured: false,

  seo: {
    metaTitle: "",
    metaDescription: "",
    keywords: [],
    ogTitle: "",
    ogDescription: "",
    ogImage: "",
    ogImagePublicId: "",
    noIndex: false,
  },
};

const steps = [
  {
    number: "01",
    title: "Basic Information",
    shortTitle: "Basic",
    description: "Project details and primary image",
  },
  {
    number: "02",
    title: "Location & Service",
    shortTitle: "Location",
    description: "Project location and associated service",
  },
  {
    number: "03",
    title: "Client",
    shortTitle: "Client",
    description: "Client information and logo",
  },
  {
    number: "04",
    title: "Gallery",
    shortTitle: "Gallery",
    description: "Project gallery images",
  },
  {
    number: "05",
    title: "SEO",
    shortTitle: "SEO",
    description: "Search and social sharing settings",
  },
];

export default function CreateProjectModal({
  isModalOpen,
  setIsModalOpen,
  onSuccess,
  services,
  servicesLoading = false,
  servicesError = false,
}: CreateProjectModalProps) {
  const [currentStep, setCurrentStep] = useState(0);
  const [seoKeywordInput, setSeoKeywordInput] = useState("");
  const [ogImageCustomized, setOgImageCustomized] = useState(false);

  const { mutate: postProject, isLoading } = usePost("/project", {
    revalidateKey: "/project",
  });

  const {
    register,
    control,
    handleSubmit,
    reset,
    setValue,
    watch,
    trigger,
    formState: { errors },
  } = useForm<FormValues>({
    resolver: zodResolver(formSchema),
    defaultValues,
  });

  const { clearDraft } = usePersistentFormDraft<FormValues>({
    storageKey: "enviroshield:draft:create-project",
    watch,
    reset,
    defaultValues,
  });

  const galleryItems = useFieldArray({
    control,
    name: "gallery",
  });

  const currentKeywords = watch("seo.keywords") ?? [];
  const currentMetaTitle = watch("seo.metaTitle");
  const currentOgTitle = watch("seo.ogTitle");
  const currentMetaDescription = watch("seo.metaDescription");
  const currentOgDescription = watch("seo.ogDescription");

  // Keep the OG image synced with the primary image until a custom
  // OG image is uploaded.
  const syncOgImageWithPrimary = (url: string, publicId: string) => {
    if (ogImageCustomized) return;

    setValue("seo.ogImage", url, {
      shouldDirty: true,
      shouldValidate: true,
    });

    setValue("seo.ogImagePublicId", publicId, {
      shouldDirty: true,
      shouldValidate: true,
    });
  };

  const handleClose = () => {
    if (isLoading) return;

    // Do not reset the form here: the persistent hook keeps the draft.
    setIsModalOpen(false);
    setSeoKeywordInput("");
    setCurrentStep(0);
    setOgImageCustomized(false);
  };

  const handleNextStep = async (
    e: React.MouseEvent<HTMLButtonElement>,
  ) => {
    e.preventDefault();
    e.stopPropagation();

    let isValid = false;

    switch (currentStep) {
      case 0:
        isValid = await trigger([
          "title",
          "slug",
          "primaryImage",
          "description",
          "status",
          "isFeatured",
        ]);
        break;

      case 1:
        isValid = await trigger([
          "location",
          "completionDate",
          "serviceId",
        ]);
        break;

      case 2:
        isValid = await trigger("client");
        break;

      case 3:
        isValid = await trigger("gallery");
        break;

      case 4:
        isValid = await trigger("seo");
        break;
    }

    if (!isValid) return;

    setCurrentStep((step) => Math.min(step + 1, steps.length - 1));
  };

  const handlePreviousStep = () => {
    setCurrentStep((step) => Math.max(step - 1, 0));
  };

  const handleStepClick = (stepIndex: number) => {
    if (stepIndex >= currentStep) return;

    setCurrentStep(stepIndex);
  };

  const addKeyword = () => {
    const keyword = seoKeywordInput.trim();

    if (!keyword) return;

    if (currentKeywords.includes(keyword)) {
      toast.error("This keyword already exists.");
      return;
    }

    setValue("seo.keywords", [...currentKeywords, keyword], {
      shouldDirty: true,
      shouldValidate: true,
    });

    setSeoKeywordInput("");
  };

  const removeKeyword = (index: number) => {
    setValue(
      "seo.keywords",
      currentKeywords.filter(
        (_, keywordIndex) => keywordIndex !== index,
      ),
      {
        shouldDirty: true,
        shouldValidate: true,
      },
    );
  };

  const onSubmit = async (data: FormValues) => {
    try {
      const payload = {
        title: data.title,
        slug: data.slug,

        primaryImage: {
          url: data.primaryImage.url,
          publicId: data.primaryImage.publicId,
          alt: data.primaryImage.alt,
          caption: data.primaryImage.caption,
        },

        description: data.description,

        location: {
          city: data.location.city,
          area: data.location.area?.trim() || undefined,
          country: data.location.country,
        },

        completionDate: data.completionDate,

        gallery: (data.gallery || []).map((item) => ({
          url: item.url,
          publicId: item.publicId,
          alt: item.alt,
        })),

        client: {
          name: data.client.name,
          description: data.client.description?.trim() || undefined,
          logo: data.client.logo?.url
            ? {
                url: data.client.logo.url,
                publicId: data.client.logo.publicId || "",
                alt: data.client.logo.alt || "",
              }
            : undefined,
        },

        serviceId: data.serviceId,

        status: data.status,

        isFeatured: data.isFeatured,

        seo: {
          metaTitle: data.seo?.metaTitle?.trim() || undefined,
          metaDescription: data.seo?.metaDescription?.trim() || undefined,
          keywords: data.seo?.keywords?.filter(Boolean) || [],
          ogTitle: data.seo?.ogTitle?.trim() || undefined,
          ogDescription: data.seo?.ogDescription?.trim() || undefined,
          ogImage: data.seo?.ogImage?.trim() || undefined,
          ogImagePublicId: data.seo?.ogImagePublicId?.trim() || undefined,
          noIndex: Boolean(data.seo?.noIndex),
        },
      };

      const response = await postProject(payload);

      if (response?.success) {
        toast.success(response.message);

        // Clear the saved draft only after the API succeeds.
        clearDraft();
        setIsModalOpen(false);
        setSeoKeywordInput("");
        setCurrentStep(0);
        setOgImageCustomized(false);

        onSuccess?.();
      }
    } catch (error: any) {
      const message =
        error?.response?.data?.message ||
        error?.response?.data?.error ||
        error?.message ||
        "Failed to create project.";

      toast.error(message);

      console.error("Failed to create project:", message);
    }
  };

  return (
    <Dialog
      open={isModalOpen}
      onOpenChange={(open) => {
        if (!open) {
          handleClose();
        }
      }}
    >
      <DialogContent className="max-h-[92vh] !max-w-5xl overflow-hidden rounded-2xl border-0 p-0 shadow-2xl">
        <div className="flex max-h-[92vh] flex-col">
          <DialogHeader className="border-b px-6 py-5 text-left sm:px-8">
            <DialogTitle className="text-xl font-bold text-navy">
              Add Project
            </DialogTitle>

            <DialogDescription className="text-sm leading-6">
              Create a new Enviroshield project and configure all
              project, client, gallery, and SEO information.
            </DialogDescription>
          </DialogHeader>

          {/* Step Timeline */}
          <div className="border-b bg-muted/20 px-5 py-5 sm:px-8">
            <div className="relative">
              <div className="absolute left-[7%] right-[7%] top-5 hidden h-px bg-border md:block" />

              <div className="relative grid grid-cols-5 gap-2">
                {steps.map((step, index) => {
                  const isCompleted = index < currentStep;
                  const isActive = index === currentStep;

                  return (
                    <button
                      key={step.number}
                      type="button"
                      disabled={index >= currentStep}
                      onClick={() => handleStepClick(index)}
                      className="group flex flex-col items-center text-center disabled:cursor-default"
                    >
                      <div
                        className={[
                          "relative z-10 flex h-10 w-10 items-center justify-center rounded-full border-2 text-xs font-bold transition-all duration-200",
                          isCompleted
                            ? "border-blue bg-blue text-white shadow-md shadow-blue/20"
                            : isActive
                              ? "border-blue bg-white text-blue shadow-md shadow-blue/15"
                              : "border-border bg-white text-muted-foreground",
                        ].join(" ")}
                      >
                        {isCompleted ? (
                          <Check className="h-4 w-4" />
                        ) : (
                          step.number
                        )}
                      </div>

                      <div className="mt-3 hidden md:block">
                        <p
                          className={[
                            "text-xs font-bold",
                            isActive || isCompleted
                              ? "text-navy"
                              : "text-muted-foreground",
                          ].join(" ")}
                        >
                          {step.title}
                        </p>

                        <p className="mt-1 text-[11px] text-muted-foreground">
                          {step.description}
                        </p>
                      </div>

                      <p
                        className={[
                          "mt-2 text-[10px] font-bold md:hidden",
                          isActive || isCompleted
                            ? "text-blue"
                            : "text-muted-foreground",
                        ].join(" ")}
                      >
                        {step.shortTitle}
                      </p>
                    </button>
                  );
                })}
              </div>
            </div>
          </div>

          <form
            onSubmit={handleSubmit(onSubmit)}
            className="min-h-0 flex-1 overflow-y-auto"
          >
            <div className="space-y-8 px-6 py-7 sm:px-8">
              {/* STEP 1 — BASIC INFORMATION */}
              {currentStep === 0 && (
                <FormSection
                  title="Basic Information"
                  description="Set the main information customers will see for this project."
                >
                  <div className="grid gap-5 md:grid-cols-2">
                    <Field
                      label="Project Title"
                      error={errors.title?.message}
                    >
                      <Input
                        {...register("title", {
                          onChange: (event) => {
                            setValue(
                              "slug",
                              generateSlug(event.target.value),
                              {
                                shouldValidate: true,
                                shouldDirty: true,
                              },
                            );
                          },
                        })}
                        placeholder="e.g. Industrial Roof Waterproofing Project"
                      />
                    </Field>

                    <Field label="Slug" error={errors.slug?.message}>
                      <Input
                        {...register("slug")}
                        placeholder="industrial-roof-waterproofing-project"
                      />
                    </Field>
                  </div>

                  <Field
                    label="Description"
                    error={errors.description?.message}
                  >
                    <Textarea
                      {...register("description")}
                      placeholder="Describe this project..."
                      className="min-h-32 resize-none"
                    />
                  </Field>

                  <ImageFields
                    control={control}
                    register={register}
                    errors={errors.primaryImage}
                    setValue={setValue}
                    watch={watch}
                    name="primaryImage"
                    title="Primary Image"
                    showCaption
                    onImageChange={syncOgImageWithPrimary}
                  />

                  <div className="grid gap-4 md:grid-cols-2">
                    <Controller
                      control={control}
                      name="isFeatured"
                      render={({ field }) => (
                        <div className="flex items-center justify-between rounded-xl border bg-muted/20 p-4">
                          <div className="pr-4">
                            <Label className="font-semibold text-navy">
                              Featured Project
                            </Label>

                            <p className="mt-1 text-xs leading-5 text-muted-foreground">
                              Highlight this project on the website.
                            </p>
                          </div>

                          <Switch
                            checked={field.value}
                            onCheckedChange={field.onChange}
                          />
                        </div>
                      )}
                    />

                    <Controller
                      control={control}
                      name="status"
                      render={({ field }) => (
                        <div className="flex items-center justify-between rounded-xl border bg-muted/20 p-4">
                          <div className="pr-4">
                            <Label className="font-semibold text-navy">
                              Publish Project
                            </Label>

                            <p className="mt-1 text-xs leading-5 text-muted-foreground">
                              Turn on to publish this project. Turn
                              off to save it as a draft.
                            </p>
                          </div>

                          <Switch
                            checked={field.value === "published"}
                            onCheckedChange={(checked) =>
                              field.onChange(
                                checked ? "published" : "draft",
                              )
                            }
                          />
                        </div>
                      )}
                    />
                  </div>
                </FormSection>
              )}
              {/* STEP 2 — LOCATION & SERVICE */}
              {currentStep === 1 && (
                <FormSection
                  title="Location & Service"
                  description="Set where the project was completed and associate it with an Enviroshield service."
                >
                  <div className="grid gap-5 md:grid-cols-2">
                    <Field
                      label="City"
                      error={errors.location?.city?.message}
                    >
                      <Input
                        {...register("location.city")}
                        placeholder="e.g. Dhaka"
                      />
                    </Field>

                    <Field
                      label="Area"
                      error={errors.location?.area?.message}
                    >
                      <Input
                        {...register("location.area")}
                        placeholder="e.g. Tejgaon"
                      />
                    </Field>
                  </div>

                  <Field
                    label="Country"
                    error={errors.location?.country?.message}
                  >
                    <Input
                      {...register("location.country")}
                      placeholder="e.g. Bangladesh"
                    />
                  </Field>

                  <Field
                    label="Completion Date"
                    error={errors.completionDate?.message}
                  >
                    <Input
                      type="date"
                      {...register("completionDate")}
                    />
                  </Field>

                  <Controller
                    control={control}
                    name="serviceId"
                    render={({ field }) => (
                      <Field
                        label="Service"
                        error={errors.serviceId?.message}
                      >
                        <Select
                          value={field.value}
                          onValueChange={field.onChange}
                          disabled={
                            servicesLoading ||
                            servicesError ||
                            services.length === 0
                          }
                        >
                          <SelectTrigger className="w-full">
                            <SelectValue
                              placeholder={
                                servicesLoading
                                  ? "Loading services..."
