  --sidebar-border: oklch(1 0 0 / 10%);
  --sidebar-ring: oklch(0.556 0 0);
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }

  html {
    @apply font-sans;
  }

  body {
    @apply bg-white text-ink;
    -webkit-font-smoothing: antialiased;
  }
}

/* Tip Tap Editor Css */

.tiptap {
  min-height: 360px;
}

.tiptap p {
  margin: 0.75rem 0;
  line-height: 1.8;
}

.tiptap h1 {
  margin: 1.75rem 0 1rem;
  font-size: 2rem;
  font-weight: 700;
  line-height: 1.2;
}

.tiptap h2 {
  margin: 1.5rem 0 0.75rem;
  font-size: 1.5rem;
  font-weight: 700;
  line-height: 1.3;
}

.tiptap h3 {
  margin: 1.25rem 0 0.75rem;
  font-size: 1.25rem;
  font-weight: 700;
  line-height: 1.4;
}

.tiptap ul,
.tiptap ol {
  margin: 1rem 0;
  padding-left: 1.5rem;
}

.tiptap ul {
  list-style-type: disc;
}

.tiptap ol {
  list-style-type: decimal;
}

.tiptap li {
  margin: 0.35rem 0;
}

.tiptap blockquote {
  margin: 1.25rem 0;
  border-left: 4px solid hsl(var(--border));
  padding-left: 1rem;
  color: hsl(var(--muted-foreground));
  font-style: italic;
}

.tiptap pre {
  margin: 1.25rem 0;
  overflow-x: auto;
  border-radius: 0.75rem;
  background: #111827;
  padding: 1rem;
  color: white;
}

.tiptap code {
  border-radius: 0.25rem;
  background: hsl(var(--muted));
  padding: 0.15rem 0.3rem;
  font-size: 0.875em;
}

.tiptap pre code {
  background: transparent;
  padding: 0;
}

.tiptap hr {
  margin: 2rem 0;
  border: 0;
  border-top: 1px solid hsl(var(--border));
}

.tiptap img {
  display: block;
  height: auto;
  max-width: 100%;
  margin: 1.5rem auto;
  border-radius: 0.75rem;
}

.tiptap img.ProseMirror-selectednode {
  outline: 3px solid hsl(var(--primary));
  outline-offset: 3px;
}

.tiptap a {
  color: #2563eb;
  text-decoration: underline;
  text-underline-offset: 2px;
}

.tiptap p.is-editor-empty:first-child::before {
  color: hsl(var(--muted-foreground));
  content: "Start writing your blog...";
  float: left;
  height: 0;
  pointer-events: none;
}

.blog-image-node {
  position: relative;
  display: block;
  max-width: 100%;
  margin-top: 1.5rem;
  margin-bottom: 1.5rem;
}

.blog-image-node img {
  max-width: 100%;
  height: auto;
  user-select: none;
}

.blog-image-node.ProseMirror-selectednode {
  outline: none;
}
