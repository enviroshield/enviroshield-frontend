<file path="components/dashboard/StatusPipelineGuide.tsx">
"use client";

import {
  ArrowRight,
  Ban,
  Check,
  GitBranch,
  Info,
  Lock,
  XCircle,
} from "lucide-react";
import { useMemo } from "react";
import { Badge } from "@/components/ui/badge";
import { getAllowedBookingStatusTransitions } from "@/types/booking.type";
import {
  getAllowedOrderStatusTransitions,
  getAllowedPaymentStatusTransitions,
} from "@/types/order.type";
import { getAllowedContactStatusTransitions } from "@/types/contact.type";

export type PipelineType = "booking" | "order" | "payment" | "contact";

type StepDefinition = {
  id: string;
  label: string;
};

type AlternativeBranch = {
  id: string;
  label: string;
  type: "cancelled" | "rejected" | "failed" | "lost";
};

type PipelineConfig = {
  title: string;
  primaryPath: StepDefinition[];
  alternativeBranches: AlternativeBranch[];
  getAllowed: (current: string) => readonly string[];
};

const PIPELINE_CONFIGS: Record<PipelineType, PipelineConfig> = {
  booking: {
    title: "Booking Progression Pipeline",
    primaryPath: [
      { id: "pending", label: "Pending" },
      { id: "confirmed", label: "Confirmed" },
      { id: "in-progress", label: "In Progress" },
      { id: "completed", label: "Completed" },
    ],
    alternativeBranches: [
      { id: "cancelled", label: "Cancelled", type: "cancelled" },
      { id: "rejected", label: "Rejected", type: "rejected" },
    ],
    getAllowed: (status: string) =>
      getAllowedBookingStatusTransitions(status as any),
  },
  order: {
    title: "Order Fulfillment Pipeline",
    primaryPath: [
      { id: "pending", label: "Pending" },
      { id: "confirmed", label: "Confirmed" },
      { id: "processing", label: "Processing" },
      { id: "shipped", label: "Shipped" },
      { id: "delivered", label: "Delivered" },
    ],
    alternativeBranches: [
      { id: "cancelled", label: "Cancelled", type: "cancelled" },
    ],
    getAllowed: (status: string) =>
      getAllowedOrderStatusTransitions(status as any),
  },
  payment: {
    title: "Payment Status Pipeline",
    primaryPath: [
      { id: "pending", label: "Pending" },
      { id: "paid", label: "Paid" },
      { id: "refunded", label: "Refunded" },
    ],
    alternativeBranches: [
      { id: "failed", label: "Failed", type: "failed" },
    ],
    getAllowed: (status: string) =>
      getAllowedPaymentStatusTransitions(status as any),
  },
  contact: {
    title: "Inquiry Qualification Pipeline",
    primaryPath: [
      { id: "new", label: "New" },
      { id: "contacted", label: "Contacted" },
      { id: "qualified", label: "Qualified" },
      { id: "site-visit", label: "Site Visit" },
      { id: "proposal-sent", label: "Proposal Sent" },
      { id: "won", label: "Won" },
    ],
    alternativeBranches: [
      { id: "lost", label: "Lost", type: "lost" },
    ],
    getAllowed: (status: string) =>
      getAllowedContactStatusTransitions(status as any),
  },
};

interface StatusPipelineGuideProps {
  type: PipelineType;
  currentStatus: string;
  selectedStatus?: string;
  className?: string;
}

export default function StatusPipelineGuide({
  type,
  currentStatus,
  selectedStatus,
  className = "",
}: StatusPipelineGuideProps) {
  const config = PIPELINE_CONFIGS[type];

  const allowedNext = useMemo(() => {
    return config.getAllowed(currentStatus);
  }, [config, currentStatus]);

  const primaryIds = useMemo(
    () => config.primaryPath.map((s) => s.id),
    [config.primaryPath]
  );

  const currentIndex = primaryIds.indexOf(currentStatus);
  const isTerminal = allowedNext.length === 0;

  return (
    <div
      className={`rounded-2xl border border-blue/15 bg-gradient-to-b from-blue/5 to-transparent p-4 text-xs dark:border-blue/20 dark:from-blue-950/20 ${className}`}
    >
      {/* Header */}
      <div className="flex items-center justify-between pb-3 border-b border-border/40">
        <div className="flex items-center gap-2">
          <div className="flex h-6 w-6 items-center justify-center rounded-lg bg-blue/10 text-blue dark:bg-blue-900/40 dark:text-blue-300">
            <GitBranch className="h-3.5 w-3.5" />
          </div>
          <div>
            <h4 className="font-semibold text-slate-800 dark:text-slate-200">
              {config.title}
            </h4>
          </div>
        </div>
        <div className="flex items-center gap-1.5">
          {isTerminal ? (
            <Badge
              variant="outline"
              className="border-amber-300 bg-amber-50 text-[10px] font-semibold text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/40 dark:text-amber-300"
            >
              <Lock className="mr-1 h-3 w-3" />
              Locked Terminal
            </Badge>
          ) : (
            <Badge
              variant="outline"
              className="border-blue/30 bg-blue/5 text-[10px] font-semibold text-blue dark:border-blue-800 dark:text-blue-300"
            >
              Forward Only
            </Badge>
          )}
        </div>
      </div>

      {/* Primary Pipeline Steps */}
      <div className="pt-3">
        <div className="text-[11px] font-medium text-muted-foreground mb-2 flex items-center justify-between">
          <span>Main Progression Workflow</span>
          <span className="text-[10px] text-muted-foreground/80">
            Cannot move backward
          </span>
        </div>

        <div className="flex flex-wrap items-center gap-1.5 sm:gap-2">
          {config.primaryPath.map((step, idx) => {
            const isCurrent = step.id === currentStatus;
            const isSelected = selectedStatus && step.id === selectedStatus && !isCurrent;
            const isNextAllowed = allowedNext.includes(step.id);
            const isPast = currentIndex !== -1 && idx < currentIndex;
            const isLast = idx === config.primaryPath.length - 1;

            return (
              <div key={step.id} className="flex items-center gap-1.5 sm:gap-2">
                <div
                  className={`flex items-center gap-1.5 rounded-xl px-2.5 py-1.5 transition-all ${
                    isCurrent
                      ? "border-2 border-blue bg-blue/10 font-bold text-navy shadow-sm ring-2 ring-blue/20 dark:border-blue-400 dark:bg-blue-950/60 dark:text-blue-200"
                      : isSelected
                      ? "border-2 border-emerald-500 bg-emerald-50 font-bold text-emerald-800 shadow-sm ring-2 ring-emerald-500/20 dark:bg-emerald-950/50 dark:text-emerald-300"
                      : isNextAllowed
                      ? "border border-emerald-400/80 bg-emerald-50/50 font-medium text-emerald-700 dark:border-emerald-800 dark:bg-emerald-950/30 dark:text-emerald-300"
                      : isPast
                      ? "border border-slate-200 bg-slate-100/70 text-slate-500 dark:border-slate-800 dark:bg-slate-900/50 dark:text-slate-400"
                      : "border border-dashed border-slate-200 bg-background/50 text-slate-400 dark:border-slate-800 dark:text-slate-600"
                  }`}
                >
                  {isCurrent ? (
                    <span className="flex h-2 w-2 rounded-full bg-blue animate-pulse" />
                  ) : isSelected ? (
                    <span className="flex h-2 w-2 rounded-full bg-emerald-500" />
                  ) : isPast ? (
                    <Check className="h-3 w-3 text-slate-500" />
                  ) : isNextAllowed ? (
                    <span className="h-1.5 w-1.5 rounded-full bg-emerald-500" />
                  ) : null}

                  <span className="text-[11px] whitespace-nowrap">
                    {step.label}
                  </span>

                  {isCurrent && (
                    <span className="rounded bg-blue text-white px-1 py-0.2 text-[9px] font-bold uppercase tracking-wider">
                      Current
                    </span>
                  )}
                  {isSelected && (
                    <span className="rounded bg-emerald-600 text-white px-1 py-0.2 text-[9px] font-bold uppercase tracking-wider">
                      Selected
                    </span>
                  )}
                  {!isCurrent && !isSelected && isNextAllowed && (
                    <span className="rounded bg-emerald-100 text-emerald-800 dark:bg-emerald-900/60 dark:text-emerald-200 px-1 text-[9px] font-medium">
                      Next
                    </span>
                  )}
                </div>

                {!isLast && (
                  <ArrowRight
                    className={`h-3 w-3 shrink-0 ${
                      isPast
                        ? "text-slate-400 dark:text-slate-600"
                        : "text-slate-300 dark:text-slate-700"
                    }`}
                  />
                )}
              </div>
            );
          })}
        </div>
      </div>

      {/* Alternative Terminal Branches */}
      {config.alternativeBranches.length > 0 && (
        <div className="mt-3.5 pt-3 border-t border-border/40">
          <div className="flex flex-wrap items-center gap-2">
            <span className="text-[11px] font-medium text-muted-foreground">
              Terminal Branches:
            </span>

            {config.alternativeBranches.map((branch) => {
              const isCurrent = branch.id === currentStatus;
              const isSelected = selectedStatus && branch.id === selectedStatus && !isCurrent;
              const isNextAllowed = allowedNext.includes(branch.id);

              return (
                <div
                  key={branch.id}
                  className={`inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1 text-[11px] transition-all ${
                    isCurrent
                      ? "border border-red-500 bg-red-50 font-bold text-red-800 ring-2 ring-red-500/20 dark:bg-red-950/60 dark:text-red-300"
                      : isSelected
                      ? "border border-red-500 bg-red-50 font-bold text-red-800 ring-2 ring-red-500/20 dark:bg-red-950/60 dark:text-red-300"
                      : isNextAllowed
                      ? "border border-amber-300 bg-amber-50/70 font-medium text-amber-800 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-300"
                      : "border border-slate-200 bg-slate-100/50 text-slate-400 dark:border-slate-800 dark:bg-slate-900/30 dark:text-slate-600"
                  }`}
                >
                  {isCurrent ? (
                    <Ban className="h-3 w-3 text-red-600 dark:text-red-400" />
                  ) : isSelected ? (
                    <XCircle className="h-3 w-3 text-red-600 dark:text-red-400" />
                  ) : isNextAllowed ? (
                    <span className="h-1.5 w-1.5 rounded-full bg-amber-500" />
                  ) : (
                    <Lock className="h-2.5 w-2.5 text-slate-400" />
                  )}

                  <span>{branch.label}</span>

                  {isCurrent ? (
                    <span className="rounded bg-red-600 text-white px-1 py-0.2 text-[9px] font-bold uppercase tracking-wider">
                      Current (Terminal)
                    </span>
                  ) : isSelected ? (
                    <span className="rounded bg-red-600 text-white px-1 py-0.2 text-[9px] font-bold uppercase tracking-wider">
                      Selected
                    </span>
                  ) : isNextAllowed ? (
                    <span className="rounded bg-amber-200/70 text-amber-900 dark:bg-amber-900/60 dark:text-amber-200 px-1 text-[9px] font-medium">
                      Allowed Next
                    </span>
                  ) : (
                    <span className="text-[9px] text-slate-400 dark:text-slate-600">
                      Unavailable
                    </span>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      )}

      {/* Informative Guidance Footer */}
      <div className="mt-3 flex items-start gap-1.5 pt-2 border-t border-border/30 text-[10.5px] leading-relaxed text-muted-foreground">
        <Info className="h-3.5 w-3.5 shrink-0 mt-0.5 text-blue/70" />
        <span>
          {isTerminal ? (
            <span className="font-medium text-amber-700 dark:text-amber-400">
              This record is in a terminal state. Status transitions are locked and cannot be changed.
            </span>
          ) : (
            <span>
              Status must advance in forward progression only. Once an order or booking moves to a subsequent stage, returning to an earlier stage is strictly prohibited.
            </span>
          )}
        </span>
      </div>
    </div>
  );
}
</file>

<file path="components/products/PriceFilter.tsx">
"use client";

import { useState } from "react";
import {Button} from "@/components/Button";
import { Slider } from "@/components/ui/slider";

type Props = {
  min?: number;
  max: number;
  initialMin?: number;
  initialMax?: number;
  currency?: string;
  /** Other active filters (e.g. categoryId), preserved in the Apply link */
  hidden?: Record<string, string>;
  /** Where "Reset" goes (keeps other filters, drops price) */
  resetHref?: string;
  isFiltered?: boolean;
};

export default function PriceFilter({
  min = 0,
  max,
  initialMin,
  initialMax,
  currency = "৳",
  hidden = {},
  resetHref = "/products",
  isFiltered = false,
}: Props) {
  const [range, setRange] = useState<number[]>([
    Math.max(min, initialMin ?? min),
    Math.min(max, initialMax ?? max),
  ]);
  const [lo, hi] = range;
  const step = Math.max(1, Math.round((max - min) / 200));

  // The site Button renders a link, so "Apply" is a link built from the slider values
  const qs = new URLSearchParams(hidden);
  if (lo > min) qs.set("minPrice", String(lo));
  if (hi < max) qs.set("maxPrice", String(hi));
  const applyHref = qs.toString() ? `/products?${qs.toString()}` : "/products";

  return (
    <div className="space-y-5">
      <Slider
        min={min}
        max={max}
        step={step}
        value={range}
        onValueChange={(v) => setRange(v as number[])}
        aria-label="Price range"
        className="[&_[data-slot=slider-range]]:bg-blue [&_[data-slot=slider-thumb]]:border-blue [&_[data-slot=slider-track]]:bg-line"
      />

      <p className="text-sm text-ink/70">
        Price:{" "}
        <span className="font-semibold text-navy">
          {currency}
          {lo.toLocaleString()} — {currency}
          {hi.toLocaleString()}
        </span>
      </p>

      <div className="flex flex-wrap items-center gap-2 w-full">
        <Button href={applyHref} fullWidth>Apply</Button>
        {isFiltered && (
          <Button href={resetHref} variant="outline">
            Reset
          </Button>
        )}
      </div>
    </div>
  );
}
</file>

<file path="components/products/ProductSearch.tsx">
"use client";

import { FormEvent, useEffect, useState } from "react";
import { useRouter, useSearchParams } from "next/navigation";
import { Search, X } from "lucide-react";

import { Button } from "@/components/Button";
import { Input } from "@/components/ui/input";

type Props = {
  initialSearch?: string;
};

export default function ProductSearch({ initialSearch = "" }: Props) {
  const router = useRouter();
  const searchParams = useSearchParams();
  const [value, setValue] = useState(initialSearch);

  useEffect(() => {
    setValue(initialSearch);
  }, [initialSearch]);

  const handleSubmit = (e?: FormEvent) => {
    if (e) e.preventDefault();
    const params = new URLSearchParams(searchParams.toString());
    const trimmed = value.trim();

    if (trimmed) {
      params.set("search", trimmed);
    } else {
      params.delete("search");
    }

    params.delete("page");
    const query = params.toString();
    router.push(query ? `/products?${query}` : "/products", { scroll: false });
  };

  const handleClear = () => {
    setValue("");
    const params = new URLSearchParams(searchParams.toString());
    params.delete("search");
    params.delete("page");
    const query = params.toString();
    router.push(query ? `/products?${query}` : "/products", { scroll: false });
  };

  return (
    <form
      onSubmit={handleSubmit}
      role="search"
      className="flex w-full items-center gap-2.5"
    >
      <div className="relative flex-1">
        <div className="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 flex items-center text-ink/40">
          <Search size={16} />
        </div>

        <Input
          type="search"
          value={value}
          onChange={(e) => setValue(e.target.value)}
          placeholder="Search products by name, SKU, or keywords..."
          aria-label="Search products"
          className="h-12 w-full rounded-2xl border-line/90 bg-white pl-10 pr-9 text-sm text-ink placeholder:text-ink/40 shadow-xs focus-visible:border-blue focus-visible:ring-blue/20"
        />

        {value && (
          <button
            type="button"
            onClick={handleClear}
            aria-label="Clear search"
            className="absolute right-2.5 top-1/2 -translate-y-1/2 flex h-7 w-7 items-center justify-center rounded-lg text-ink/40 transition hover:bg-mist hover:text-navy"
          >
            <X size={14} />
          </button>
        )}
      </div>

      <Button type="submit" className="shrink-0 !min-h-12">
        Search
      </Button>
    </form>
  );
}
</file>

<file path="components/products/ProductSortSelect.tsx">
"use client";

import { useRouter, useSearchParams } from "next/navigation";
import { ArrowUpDown } from "lucide-react";

import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";

type Props = {
  currentSortBy?: string;
  currentSortOrder?: string;
};

const SORT_OPTIONS = [
  { value: "createdAt:desc", label: "Newest Arrivals" },
  { value: "price:asc", label: "Price: Low to High" },
  { value: "price:desc", label: "Price: High to Low" },
  { value: "name:asc", label: "Name: A to Z" },
  { value: "name:desc", label: "Name: Z to A" },
  { value: "stockQuantity:desc", label: "Stock: High to Low" },
];

export default function ProductSortSelect({
  currentSortBy = "createdAt",
  currentSortOrder = "desc",
}: Props) {
  const router = useRouter();
  const searchParams = useSearchParams();

  const currentValue = `${currentSortBy || "createdAt"}:${currentSortOrder || "desc"}`;

  const handleValueChange = (val: string | null) => {
    if (!val) return;
    const [sortBy, sortOrder] = val.split(":");
    const params = new URLSearchParams(searchParams.toString());

    if (sortBy === "createdAt" && sortOrder === "desc") {
      params.delete("sortBy");
      params.delete("sortOrder");
    } else {
      params.set("sortBy", sortBy);
      params.set("sortOrder", sortOrder);
    }

    params.delete("page");
    const query = params.toString();
    router.push(query ? `/products?${query}` : "/products", { scroll: false });
  };

  return (
    <Select value={currentValue} onValueChange={handleValueChange}>
      <SelectTrigger
        aria-label="Sort products by"
        className="h-10 min-w-44 rounded-xl border-line/90 bg-white text-xs font-semibold text-navy shadow-xs hover:border-blue/40 focus-visible:border-blue focus-visible:ring-2 focus-visible:ring-blue/15"
      >
        <div className="flex items-center gap-2 truncate">
          <ArrowUpDown size={13} className="text-ink/50" />
          <SelectValue placeholder="Sort by" />
        </div>
      </SelectTrigger>

      <SelectContent
        align="end"
        className="rounded-xl border border-line bg-white shadow-lg"
      >
        {SORT_OPTIONS.map((opt) => (
          <SelectItem
            key={opt.value}
            value={opt.value}
            className="cursor-pointer text-xs font-medium text-navy hover:bg-mist/70 focus:bg-mist focus:text-blue"
          >
            {opt.label}
          </SelectItem>
        ))}
      </SelectContent>
    </Select>
  );
}
</file>

<file path="components/products/ProductsPagination.tsx">
import Link from "next/link";

type Props = {
  page: number;
  totalPages: number;
  search: string;
  categoryId: string;
  minPrice?: number;
  maxPrice?: number;
};

function hrefFor(page: number, props: Props) {
  const params = new URLSearchParams({ page: String(page) });
  if (props.search) params.set("search", props.search);
  if (props.categoryId) params.set("categoryId", props.categoryId);
  if (props.minPrice !== undefined) params.set("minPrice", String(props.minPrice));
  if (props.maxPrice !== undefined) params.set("maxPrice", String(props.maxPrice));
  return `/products?${params.toString()}`;
}

export default function ProductsPagination(props: Props) {
  if (props.totalPages <= 1) return null;
  const pages = Array.from({ length: props.totalPages }, (_, index) => index + 1);
  return (
    <nav aria-label="Product pages" className="mt-10 flex flex-wrap items-center justify-center gap-2">
      {props.page > 1 && <Link href={hrefFor(props.page - 1, props)} className="rounded-full border border-line px-4 py-2 text-[13px] text-navy transition hover:border-blue hover:text-blue">Previous</Link>}
      {pages.map((page) => (
        <Link key={page} href={hrefFor(page, props)} aria-current={page === props.page ? "page" : undefined} className={`grid h-10 w-10 place-items-center rounded-full border text-[13px] transition ${page === props.page ? "border-blue bg-blue text-white" : "border-line text-navy hover:border-blue hover:text-blue"}`}>
          {page}
        </Link>
      ))}
      {props.page < props.totalPages && <Link href={hrefFor(props.page + 1, props)} className="rounded-full border border-line px-4 py-2 text-[13px] text-navy transition hover:border-blue hover:text-blue">Next</Link>}
    </nav>
  );
}
</file>

