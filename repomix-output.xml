                              aria-hidden="true"
                            />
                            Cancel Order
                          </Button>
                        )}
                      </div>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          )}

          {orders.length > 0 && meta && (
            <div className="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div className="flex items-center gap-2">
                <span className="text-sm text-muted-foreground">
                  Rows per page:
                </span>
                <span className="text-sm font-medium text-foreground">
                  {meta.limit}
                </span>
              </div>

              <div className="flex items-center gap-2 self-end sm:self-auto">
                <DashboardButton
                  variant="outline"
                  disabled={meta.page <= 1 || isLoading}
                  onClick={() =>
                    setPage((currentPage) =>
                      Math.max(1, currentPage - 1),
                    )
                  }
                  icon={<ChevronLeft className="h-4 w-4" />}
                  className="h-8 w-8 rounded-full border-blue bg-blue p-0 text-white shadow-[0_3px_10px_rgba(1,110,220,0.18)] transition-[background-color,box-shadow] duration-200 hover:bg-[#005cb9] hover:text-white hover:shadow-[0_4px_12px_rgba(1,110,220,0.24)] disabled:pointer-events-none disabled:opacity-50"
                  ariaLabel="Previous page"
                />
                <span
                  className="text-sm text-muted-foreground"
                  aria-live="polite"
                >
                  Page {meta.page} of {totalPages}
                </span>
                <DashboardButton
                  variant="outline"
                  disabled={meta.page >= totalPages || isLoading}
                  onClick={() =>
                    setPage((currentPage) =>
                      Math.min(totalPages, currentPage + 1),
                    )
                  }
                  icon={<ChevronRight className="h-4 w-4" />}
                  className="h-8 w-8 rounded-full border-blue bg-blue p-0 text-white shadow-[0_3px_10px_rgba(1,110,220,0.18)] transition-[background-color,box-shadow] duration-200 hover:bg-[#005cb9] hover:text-white hover:shadow-[0_4px_12px_rgba(1,110,220,0.24)] disabled:pointer-events-none disabled:opacity-50"
                  ariaLabel="Next page"
                />
              </div>
            </div>
          )}
        </CardContent>
      </Card>

      <OrderDetailsModal
        order={selectedOrder}
        open={Boolean(selectedOrder)}
        onClose={handleCloseOrderDetails}
        showTrackingTimeline
        displayPaymentStatus={
          selectedOrder
            ? getDisplayedPaymentStatus(selectedOrder)
            : undefined
        }
      />
      <CancelMyOrderModal
        key={orderToCancel?._id ?? "closed"}
        order={orderToCancel}
        open={Boolean(orderToCancel)}
        revalidateKey={endpoint ?? "/order/mine?page=1&limit=10"}
        onClose={() => setOrderToCancel(null)}
        onSuccess={() => setOrderToCancel(null)}
      />
    </div>
  );
}
