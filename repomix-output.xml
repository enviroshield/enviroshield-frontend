  } catch {
    related = [];
  }

  const productJsonLd = {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": `${articleUrl}#product`,

    name: product.name,
    description,
    url: articleUrl,

    ...(product.sku?.trim() ? { sku: product.sku.trim() } : {}),

    ...(images.length > 0
      ? {
          image: images.map((image) => image.url),
