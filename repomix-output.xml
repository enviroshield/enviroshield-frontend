<file path="components/dashboard/admin/settings/AdminSettingsManager.tsx">
"use client";

import { useEffect, useState, useTransition } from "react";
import { toast } from "sonner";
import {
  Activity,
  AlertCircle,
  Globe,
  Loader2,
  Lock,
  Megaphone,
  Save,
  ShieldCheck,
} from "lucide-react";

import { settingsApi } from "@/lib/api/settings";
import {
  ISettings,
  defaultSettingsValues,
} from "@/types/settings.type";
import DashboardButton from "@/components/dashboard/DashboardButton";
import { SettingsSkeleton } from "./SettingsSkeleton";
import { AdvertisingSettings } from "./AdvertisingSettings";
import { AnalyticsSettings } from "./AnalyticsSettings";
import { GeneralSeoSettings } from "./GeneralSeoSettings";
import { PrivacyConsentSettings } from "./PrivacyConsentSettings";
import { AccountSettings } from "./AccountSettings";

interface AdminSettingsManagerProps {
  initialSettings?: ISettings;
  isAdmin: boolean;
}

type SettingsTab =
  | "seo"
  | "analytics"
  | "advertising"
  | "consent"
  | "account";

export function AdminSettingsManager({
  initialSettings,
  isAdmin,
}: AdminSettingsManagerProps) {
  const [activeTab, setActiveTab] = useState<SettingsTab>(
    isAdmin ? "seo" : "account",
  );
  const [settings, setSettings] = useState<ISettings>(
    initialSettings || defaultSettingsValues,
  );
  const [savedSettings, setSavedSettings] = useState<ISettings>(
    initialSettings || defaultSettingsValues,
  );
  const [isLoading, setIsLoading] = useState(
    !initialSettings && isAdmin,
  );
  const [isPending, startTransition] = useTransition();
  const [errors, setErrors] = useState<Record<string, string>>({});

  useEffect(() => {
    if (!initialSettings && isAdmin) {
      settingsApi
        .getAdminSettings()
        .then((data) => {
          setSettings(data);
          setSavedSettings(data);
        })
        .catch((err) => {
          console.error("Failed to load settings:", err);
          toast.error("Failed to load current settings.");
        })
        .finally(() => {
          setIsLoading(false);
        });
    }
  }, [initialSettings, isAdmin]);

  const hasUnsavedChanges =
    JSON.stringify(settings) !== JSON.stringify(savedSettings);

  const validate = (): boolean => {
    const newErrors: Record<string, string> = {};

    // GA4 validation
    if (
      settings.analytics.ga4.enabled &&
      settings.analytics.ga4.measurementId
    ) {
      if (
        !/^G-[A-Z0-9]+$/i.test(settings.analytics.ga4.measurementId)
      ) {
        newErrors["analytics.ga4.measurementId"] =
          "Measurement ID must be in the format G-XXXXXXXXXX";
      }
    }

    // GTM validation
    if (
      settings.analytics.gtm.enabled &&
      settings.analytics.gtm.containerId
    ) {
      if (
        !/^GTM-[A-Z0-9]+$/i.test(settings.analytics.gtm.containerId)
      ) {
        newErrors["analytics.gtm.containerId"] =
          "Container ID must be in the format GTM-XXXXXXX";
      }
    }

    // Meta Pixel validation
    if (
      settings.marketing.metaPixel.enabled &&
      settings.marketing.metaPixel.pixelId
    ) {
      if (!/^\d{8,20}$/.test(settings.marketing.metaPixel.pixelId)) {
        newErrors["marketing.metaPixel.pixelId"] =
          "Meta Pixel ID must contain 8–20 digits";
      }

      if (
        settings.marketing.metaPixel.capi?.enabled &&
        !settings.marketing.metaPixel.capi.accessTokenConfigured &&
        !settings.marketing.metaPixel.capi.accessToken?.trim()
      ) {
        newErrors["marketing.metaPixel.capi.accessToken"] =
          "Access token is required when Meta CAPI is enabled";
      }
    }

    // Google Ads validation
    if (
      settings.marketing.googleAds.enabled &&
      settings.marketing.googleAds.conversionId
    ) {
      if (
        !/^(AW-)?[0-9]+$/i.test(
          settings.marketing.googleAds.conversionId,
        )
      ) {
        newErrors["marketing.googleAds.conversionId"] =
          "Conversion ID must be numbers or AW-XXXXXXXXX";
      }
    }

    setErrors(newErrors);
    return Object.keys(newErrors).length === 0;
  };

  const handleSave = () => {
    if (!validate()) {
      toast.error(
        "Please correct the highlighted validation errors.",
      );
      return;
    }

    startTransition(async () => {
      try {
        const updated = await settingsApi.updateSettings(settings);
        setSettings(updated);
        setSavedSettings(updated);
        toast.success("Settings saved successfully!");
      } catch (error: unknown) {
        console.error("Save settings error:", error);
        let msg = "Failed to save settings.";
        const errObj = error as {
          response?: { data?: { message?: string } };
          message?: string;
        };
        if (typeof errObj?.response?.data?.message === "string") {
          msg = errObj.response.data.message;
        } else if (typeof errObj?.message === "string") {
          msg = errObj.message;
        }
        toast.error(msg);
      }
    });
  };

  if (isLoading) {
    return <SettingsSkeleton />;
  }

  return (
    <div className="space-y-8">
      {/* Navigation & Actions */}
      {isAdmin && (
        <div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-border/60 pb-4">
          <div
            role="tablist"
            className="flex flex-wrap items-center gap-1.5 rounded-2xl bg-muted/60 p-1.5 backdrop-blur-sm border border-border/40"
          >
            <button
              type="button"
              role="tab"
              aria-selected={activeTab === "seo"}
              onClick={() => setActiveTab("seo")}
              className={`flex items-center gap-2 rounded-xl px-4 py-2 text-xs font-semibold transition-all duration-200 ${
                activeTab === "seo"
                  ? "bg-background text-foreground shadow-sm ring-1 ring-border/50"
                  : "text-muted-foreground hover:text-foreground hover:bg-background/50"
              }`}
            >
              <Globe className="h-4 w-4 text-blue" />
              General SEO
            </button>

            <button
              type="button"
              role="tab"
              aria-selected={activeTab === "analytics"}
              onClick={() => setActiveTab("analytics")}
              className={`flex items-center gap-2 rounded-xl px-4 py-2 text-xs font-semibold transition-all duration-200 ${
                activeTab === "analytics"
                  ? "bg-background text-foreground shadow-sm ring-1 ring-border/50"
                  : "text-muted-foreground hover:text-foreground hover:bg-background/50"
              }`}
            >
              <Activity className="h-4 w-4 text-indigo" />
              Analytics
            </button>

            <button
              type="button"
              role="tab"
              aria-selected={activeTab === "advertising"}
              onClick={() => setActiveTab("advertising")}
              className={`flex items-center gap-2 rounded-xl px-4 py-2 text-xs font-semibold transition-all duration-200 ${
                activeTab === "advertising"
                  ? "bg-background text-foreground shadow-sm ring-1 ring-border/50"
                  : "text-muted-foreground hover:text-foreground hover:bg-background/50"
              }`}
            >
              <Megaphone className="h-4 w-4 text-purple-600" />
              Advertising
            </button>

            <button
              type="button"
              role="tab"
              aria-selected={activeTab === "consent"}
              onClick={() => setActiveTab("consent")}
              className={`flex items-center gap-2 rounded-xl px-4 py-2 text-xs font-semibold transition-all duration-200 ${
                activeTab === "consent"
                  ? "bg-background text-foreground shadow-sm ring-1 ring-border/50"
                  : "text-muted-foreground hover:text-foreground hover:bg-background/50"
              }`}
            >
              <Lock className="h-4 w-4 text-teal" />
              Privacy &amp; Consent
            </button>

            <button
              type="button"
              role="tab"
              aria-selected={activeTab === "account"}
              onClick={() => setActiveTab("account")}
              className={`flex items-center gap-2 rounded-xl px-4 py-2 text-xs font-semibold transition-all duration-200 ${
                activeTab === "account"
                  ? "bg-background text-foreground shadow-sm ring-1 ring-border/50"
                  : "text-muted-foreground hover:text-foreground hover:bg-background/50"
              }`}
            >
              <ShieldCheck className="h-4 w-4 text-emerald-600" />
              Account &amp; Security
            </button>
          </div>

          {activeTab !== "account" && (
            <div className="flex items-center gap-3">
              {hasUnsavedChanges && (
                <span className="flex items-center gap-1.5 rounded-full border border-amber-500/30 bg-amber-500/10 px-3 py-1 text-xs font-medium text-amber-600 dark:text-amber-400">
                  <AlertCircle className="h-3.5 w-3.5" />
                  Unsaved changes
                </span>
              )}
              <DashboardButton
                onClick={handleSave}
                disabled={isPending}
                icon={
                  isPending ? (
                    <Loader2 className="h-4 w-4 animate-spin" />
                  ) : (
                    <Save className="h-4 w-4" />
                  )
                }
              >
                {isPending ? "Saving..." : "Save Settings"}
              </DashboardButton>
            </div>
          )}
        </div>
      )}

      {/* Tab Panels */}
      {isAdmin && activeTab === "seo" && (
        <GeneralSeoSettings
          data={settings.seo}
          onChange={(seo) => setSettings({ ...settings, seo })}
          errors={errors}
        />
      )}

      {isAdmin && activeTab === "analytics" && (
        <AnalyticsSettings
          data={settings.analytics}
          onChange={(analytics) =>
            setSettings({ ...settings, analytics })
          }
          errors={errors}
        />
      )}

      {isAdmin && activeTab === "advertising" && (
        <AdvertisingSettings
          data={settings.marketing}
          onChange={(marketing) =>
            setSettings({ ...settings, marketing })
          }
          errors={errors}
        />
      )}

      {isAdmin && activeTab === "consent" && (
        <PrivacyConsentSettings
          data={settings.consent}
          onChange={(consent) =>
            setSettings({ ...settings, consent })
          }
          errors={errors}
        />
      )}

      {/* Account & Security Tab */}
      {(!isAdmin || activeTab === "account") && <AccountSettings />}
    </div>
  );
}
</file>

<file path="components/dashboard/user/services/MyServicesDashboard.tsx">
"use client";

import {
  CalendarDays,
  ChevronLeft,
  ChevronRight,
  ClipboardList,
  Clock3,
  Eye,
  MapPin,
  PackageCheck,
  Search,
  Wrench,
  X,
  XCircle,
} from "lucide-react";
import { usePathname, useRouter, useSearchParams } from "next/navigation";
import { useEffect, useMemo, useState } from "react";

import {
  formatBookingAmount,
  formatBookingDate,
  formatBookingStatus,
} from "@/components/dashboard/admin/service-bookings/bookingUtils";
import DashboardButton from "@/components/dashboard/DashboardButton";
import DashboardError from "@/components/dashboard/DashboardError";
import DashboardLoading from "@/components/dashboard/DashboardLoading";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { useFetch } from "@/hooks/swr/useFetch";
import { axiosInstance } from "@/lib/axios";
import type {
  Booking,
  BookingListResponse,
  BookingStatus,
} from "@/types/booking.type";
import {
  UserDashboardMetric,
  UserStatusBadge,
} from "../orders/UserDashboardUI";
import CancelMyBookingDialog from "./CancelMyBookingDialog";
import MyBookingDetailsDialog from "./MyBookingDetailsDialog";

type BookingStatusFilter = "all" | BookingStatus;
const PAGE_SIZE = 10;
const CANCELLABLE_STATUSES: BookingStatus[] = ["pending"];
const BOOKING_STATUSES: BookingStatus[] = [
  "pending",
  "confirmed",
  "in-progress",
  "completed",
  "cancelled",
  "rejected",
];

export default function MyServicesDashboard() {
  const router = useRouter();
  const pathname = usePathname();
  const searchParams = useSearchParams();
  const urlBookingId = searchParams.get("bookingId");

  const [search, setSearch] = useState("");
  const [debouncedSearch, setDebouncedSearch] = useState("");
  const [status, setStatus] = useState<BookingStatusFilter>("all");
  const [page, setPage] = useState(1);
  const [selectedBooking, setSelectedBooking] = useState<Booking | null>(null);
  const [bookingToCancel, setBookingToCancel] = useState<Booking | null>(null);

  useEffect(() => {
    const timeout = setTimeout(() => {
      setDebouncedSearch(search.trim());
    }, 500);
    return () => clearTimeout(timeout);
  }, [search]);

  const endpoint = useMemo(() => {
    const params = new URLSearchParams();
    params.set("page", String(page));
    params.set("limit", String(PAGE_SIZE));
    if (status !== "all") params.set("status", status);
    if (debouncedSearch) {
      params.set("bookingNumber", debouncedSearch);
    }
    return `/booking/mine?${params.toString()}`;
  }, [debouncedSearch, page, status]);

  const { data, isLoading, isError, refetch } = useFetch<BookingListResponse>(
    endpoint,
    { keepPreviousData: true },
  );

  const bookings = data?.data ?? [];
  const meta = data?.meta;

  // Auto-open booking details modal when navigated via notification link (?bookingId=...)
  useEffect(() => {
    if (!urlBookingId) return;

    const found = bookings.find(
      (b) => b._id === urlBookingId || b.bookingNumber === urlBookingId,
    );
    if (found) {
      setSelectedBooking(found);
      return;
    }

    let isCancelled = false;
    async function loadBooking() {
      try {
        const res = await axiosInstance.get<{ success: boolean; data: Booking }>(
          `/booking/mine/${encodeURIComponent(urlBookingId!)}`,
        );
        if (!isCancelled && res.data?.data) {
          setSelectedBooking(res.data.data);
        }
      } catch (err) {
        console.error("Failed to load booking from notification link:", err);
      }
    }
    void loadBooking();

    return () => {
      isCancelled = true;
    };
  }, [urlBookingId, bookings]);

  const handleCloseBookingDetails = () => {
    setSelectedBooking(null);
    if (urlBookingId) {
      const nextParams = new URLSearchParams(searchParams.toString());
      nextParams.delete("bookingId");
      const qs = nextParams.toString();
      router.replace(qs ? `${pathname}?${qs}` : pathname, { scroll: false });
    }
  };
  const hasActiveFilters = Boolean(search.trim()) || status !== "all";
  const isSearchPending = search.trim() !== debouncedSearch;
  const totalPages = Math.max(1, meta?.totalPages ?? 1);

  const hasCompleteUnfilteredHistory =
    !hasActiveFilters &&
    meta !== undefined &&
    meta.total === bookings.length;

  const activeBookings = hasCompleteUnfilteredHistory
    ? bookings.filter((b) =>
        ["pending", "confirmed", "in-progress"].includes(b.status),
      ).length
    : null;

  const completedBookings = hasCompleteUnfilteredHistory
    ? bookings.filter((b) => b.status === "completed").length
    : null;

  function updateSearch(value: string) {
    setSearch(value);
    setPage(1);
  }

  function updateStatus(value: string | null) {
    if (
      value === "all" ||
      value === "pending" ||
      value === "confirmed" ||
      value === "in-progress" ||
      value === "completed" ||
      value === "cancelled" ||
      value === "rejected"
    ) {
      setStatus(value);
      setPage(1);
    }
  }

  function clearFilters() {
    setSearch("");
    setDebouncedSearch("");
    setStatus("all");
    setPage(1);
  }

  if (isLoading && !data) return <DashboardLoading />;
  if (isError && !data)
    return <DashboardError onRetry={() => void refetch()} />;

  return (
    <div className="mx-auto w-full max-w-[1440px] space-y-8 p-6 sm:p-8 lg:p-10">
      {/* Page Header */}
      <section className="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p className="text-xs font-semibold uppercase tracking-[0.2em] text-indigo">
            Your account
          </p>
          <h1 className="mt-3 font-display text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
            My Service Bookings
          </h1>
          <p className="mt-3 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">
            Review your service bookings, check inspection progress, and
            manage your scheduled services.
          </p>
        </div>
        <Badge
          variant="outline"
          className="w-fit rounded-full border-blue/20 bg-blue/5 px-3 py-1.5 text-sm font-semibold text-blue"
        >
          {meta?.total ?? 0}{" "}
          {hasActiveFilters ? "matching bookings" : "bookings total"}
        </Badge>
      </section>

      {/* Metrics Row */}
      <section
        className="grid gap-4 sm:grid-cols-2 xl:grid-cols-3"
        aria-label="Booking summaries"
      >
        <UserDashboardMetric
          title="Total Bookings"
          value={String(meta?.total ?? 0)}
          description={
            hasActiveFilters
              ? "Matches the active filters"
              : "All service bookings on your account"
          }
          icon={ClipboardList}
          tone="blue"
        />
        <UserDashboardMetric
          title="Active Bookings"
          value={activeBookings === null ? "—" : String(activeBookings)}
          description={
            activeBookings === null
              ? "Unavailable for filtered or paginated history"
              : "In review, confirmed, or in progress"
          }
          icon={Wrench}
          tone="amber"
        />
        <UserDashboardMetric
          title="Completed Bookings"
          value={completedBookings === null ? "—" : String(completedBookings)}
          description={
            completedBookings === null
              ? "Unavailable for filtered or paginated history"
              : "Successfully serviced"
          }
          icon={PackageCheck}
          tone="teal"
        />
      </section>

      {/* Main Card */}
      <Card className="overflow-hidden rounded-2xl border-border/70 bg-background shadow-none">
        <CardHeader className="border-b border-border/60 px-5 py-5 sm:px-6">
          <div className="flex items-center gap-3">
            <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo/[0.08] text-indigo">
              <Wrench className="h-5 w-5" aria-hidden="true" />
            </div>
            <div>
              <CardTitle className="font-display text-base font-bold tracking-tight">
                Booking history
              </CardTitle>
              <p className="mt-1 text-sm text-muted-foreground">
                Browse and filter your service bookings.
              </p>
            </div>
          </div>
        </CardHeader>

        <CardContent className="space-y-5 p-5 sm:p-6">
          {/* Filters Bar */}
          <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <div className="space-y-1.5">
              <label
                htmlFor="bookings-search"
                className="flex items-center gap-2 text-xs font-medium text-muted-foreground"
              >
                <Search className="h-4 w-4" aria-hidden="true" />
                Search Bookings
              </label>
              <div className="relative">
                <Search
