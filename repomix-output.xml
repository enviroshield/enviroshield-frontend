<file path="components/dashboard/admin/service-bookings/ServiceBookingsDashboard.tsx">
"use client";

import {
  tableFeatures,
  useTable,
  type ColumnDef,
} from "@tanstack/react-table";
import {
  BadgeCheck,
  Ban,
  Calendar,
  CalendarClock,
  CalendarDays,
  ChevronLeft,
  ChevronRight,
  DollarSign,
  Eye,
  Filter,
  MoreHorizontal,
  Search,
} from "lucide-react";
import { useEffect, useMemo, useState } from "react";
import { usePathname, useRouter, useSearchParams } from "next/navigation";
import { axiosInstance } from "@/lib/axios";

import DashboardButton from "@/components/dashboard/DashboardButton";
import DashboardEmpty from "@/components/dashboard/DashboardEmpty";
import DashboardError from "@/components/dashboard/DashboardError";
import DashboardLoading from "@/components/dashboard/DashboardLoading";
import { Badge } from "@/components/ui/badge";
import { Card } from "@/components/ui/card";
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuGroup,
  DropdownMenuItem,
  DropdownMenuLabel,
  DropdownMenuSeparator,
  DropdownMenuTrigger,
} from "@/components/ui/dropdown-menu";
import { Input } from "@/components/ui/input";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { useFetch } from "@/hooks/swr/useFetch";
import type {
  Booking,
  BookingListResponse,
  BookingStatus,
} from "@/types/booking.type";
import {
  formatBookingAmount,
  formatBookingDate,
  formatBookingStatus,
  getBookingStatusClass,
} from "./bookingUtils";
import CancelBookingDialog from "./CancelBookingDialog";
import UpdateBookingManagementModal from "./UpdateBookingManagementModal";
import UpdateBookingPriceModal from "./UpdateBookingPriceModal";
import UpdateBookingStatusModal from "./UpdateBookingStatusModal";
import ViewBookingModal from "./ViewBookingModal";

const features = tableFeatures({});

const STATUS_OPTIONS: BookingStatus[] = [
  "pending",
  "confirmed",
  "in-progress",
  "completed",
  "cancelled",
  "rejected",
];

export default function ServiceBookingsDashboard() {
  const router = useRouter();
  const pathname = usePathname();
  const searchParams = useSearchParams();
  const urlBookingId = searchParams.get("bookingId");

  const [currentPage, setCurrentPage] = useState(1);
  const [limit, setLimit] = useState(10);
  const [search, setSearch] = useState("");
  const [debouncedSearch, setDebouncedSearch] = useState("");
  const [filterStatus, setFilterStatus] = useState<string>("");

  const [selectedBooking, setSelectedBooking] = useState<Booking | null>(null);
  const [isViewModalOpen, setIsViewModalOpen] = useState(false);
  const [isStatusModalOpen, setIsStatusModalOpen] = useState(false);
  const [isPriceModalOpen, setIsPriceModalOpen] = useState(false);
  const [isManagementModalOpen, setIsManagementModalOpen] = useState(false);
  const [isCancelDialogOpen, setIsCancelDialogOpen] = useState(false);

  useEffect(() => {
    const timeout = setTimeout(() => {
      setDebouncedSearch(search.trim());
    }, 400);
    return () => clearTimeout(timeout);
  }, [search]);

  const endpoint = useMemo(() => {
    const params = new URLSearchParams();
    params.set("page", String(currentPage));
    params.set("limit", String(limit));
    if (filterStatus) params.set("status", filterStatus);
    if (debouncedSearch) params.set("bookingNumber", debouncedSearch);
    return `/booking?${params.toString()}`;
  }, [currentPage, limit, filterStatus, debouncedSearch]);

  const { data, isLoading, isError, refetch } =
    useFetch<BookingListResponse>(endpoint);

  const bookings = data?.data ?? [];

  // Auto-open booking details modal when navigated via notification link (?bookingId=...)
  useEffect(() => {
    if (!urlBookingId) return;

    const found = bookings.find(
      (b) => b._id === urlBookingId || b.bookingNumber === urlBookingId,
    );
    if (found) {
      setSelectedBooking(found);
      setIsViewModalOpen(true);
      return;
    }

    let isCancelled = false;
    async function loadBooking() {
      try {
        const res = await axiosInstance.get<{ success: boolean; data: Booking }>(
          `/booking/${encodeURIComponent(urlBookingId!)}`,
        );
        if (!isCancelled && res.data?.data) {
          setSelectedBooking(res.data.data);
          setIsViewModalOpen(true);
        }
      } catch (err) {
        console.error("Failed to load booking from notification link:", err);
      }
    }
    void loadBooking();

    return () => {
      isCancelled = true;
    };
  }, [urlBookingId, bookings]);

  const handleCloseViewModal = () => {
    setIsViewModalOpen(false);
    setSelectedBooking(null);
    if (urlBookingId) {
      const nextParams = new URLSearchParams(searchParams.toString());
      nextParams.delete("bookingId");
      const qs = nextParams.toString();
      router.replace(qs ? `${pathname}?${qs}` : pathname, { scroll: false });
    }
  };
  const meta = data?.meta;
  const totalPages = Math.max(1, meta?.totalPages ?? 1);
  const currentPageNum = meta?.page ?? currentPage;
  const hasActiveFilters = Boolean(search.trim()) || Boolean(filterStatus);
  const isSearchPending = search.trim() !== debouncedSearch;

  const handleSearchChange = (value: string) => {
    setSearch(value);
    setCurrentPage(1);
  };

  const handleStatusChange = (value: string | null) => {
    setFilterStatus(value === "all" || value === null ? "" : value);
    setCurrentPage(1);
  };

  const handleLimitChange = (newLimit: string | null) => {
    if (!newLimit) return;
    setLimit(Number(newLimit));
    setCurrentPage(1);
  };

  const handlePageChange = (page: number) => {
    setCurrentPage(page);
  };

  const clearFilters = () => {
    setSearch("");
    setDebouncedSearch("");
    setFilterStatus("");
    setCurrentPage(1);
  };

  const handleView = (booking: Booking) => {
    setSelectedBooking(booking);
    setIsViewModalOpen(true);
  };

  const handleUpdateStatus = (booking: Booking) => {
    setSelectedBooking(booking);
    setIsStatusModalOpen(true);
  };

  const handleUpdatePrice = (booking: Booking) => {
    setSelectedBooking(booking);
    setIsPriceModalOpen(true);
  };

  const handleUpdateManagement = (booking: Booking) => {
    setSelectedBooking(booking);
    setIsManagementModalOpen(true);
  };

  const handleCancel = (booking: Booking) => {
    setSelectedBooking(booking);
    setIsCancelDialogOpen(true);
  };

  const columns: ColumnDef<typeof features, Booking>[] = [
    {
      accessorKey: "bookingNumber",
      header: "Booking ID",
      cell: ({ row }) => {
        const booking = row.original;
        return (
          <button
            type="button"
            onClick={() => handleView(booking)}
            className="text-left font-semibold text-navy transition-colors hover:text-blue hover:underline dark:text-foreground dark:hover:text-blue"
          >
            #{booking.bookingNumber}
          </button>
        );
      },
    },
    {
      id: "customer",
      header: "Customer",
      cell: ({ row }) => {
        const user =
          typeof row.original.userId === "object" && row.original.userId
            ? row.original.userId
            : null;
        return (
          <div className="min-w-[150px] space-y-0.5">
            <div className="font-semibold text-slate-900 dark:text-foreground">
              {user?.name || "Customer name unavailable"}
            </div>
            <div className="text-xs text-muted-foreground">
              {user?.phone || user?.email || "No contact info"}
            </div>
          </div>
        );
      },
    },
    {
      id: "service",
      header: "Service",
      cell: ({ row }) => {
        const service =
          typeof row.original.serviceId === "object" && row.original.serviceId
            ? row.original.serviceId
            : null;
        return (
          <div className="min-w-[180px] space-y-0.5">
            <div className="font-semibold text-slate-800 dark:text-foreground">
              {service?.name || "Service info unavailable"}
            </div>
            {row.original.project?.location && (
              <div className="truncate text-xs text-muted-foreground">
                {row.original.project.location}
              </div>
            )}
          </div>
        );
      },
    },
    {
      id: "siteVisit",
      header: "Site Visit",
      cell: ({ row }) => {
        const booking = row.original;
        return (
          <div className="min-w-[120px] text-xs">
            {booking.isSiteVisit ? (
              <span className="font-medium text-blue">
                {booking.siteVisitDate
                  ? formatBookingDate(booking.siteVisitDate)
                  : "Requested"}
              </span>
            ) : (
              <span className="text-muted-foreground">Not requested</span>
            )}
          </div>
        );
      },
    },
    {
      accessorKey: "finalPrice",
      header: "Final Price",
      cell: ({ row }) => {
        const booking = row.original;
        return (
          <div className="min-w-[110px] font-semibold text-slate-800 dark:text-foreground">
            {booking.finalPrice != null
              ? `BDT ${formatBookingAmount(booking.finalPrice)}`
              : "Quote Pending"}
          </div>
        );
      },
    },
    {
      accessorKey: "status",
      header: "Status",
      cell: ({ row }) => {
        const booking = row.original;
        return (
          <Badge
            className={`rounded-full px-3 py-1 text-[11px] font-semibold ${getBookingStatusClass(
              booking.status,
            )}`}
          >
            {formatBookingStatus(booking.status)}
          </Badge>
        );
      },
    },
    {
      accessorKey: "createdAt",
      header: "Submitted",
      cell: ({ row }) => (
        <div className="min-w-[140px] space-y-1">
          <div className="flex items-center gap-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300">
            <Calendar className="h-3.5 w-3.5 text-muted-foreground" />
            <span>{formatBookingDate(row.original.createdAt)}</span>
          </div>
        </div>
      ),
    },
    {
      id: "actions",
      header: "Actions",
      cell: ({ row }) => {
        const booking = row.original;
        const canCancel =
          booking.status === "pending" ||
          booking.status === "confirmed" ||
          booking.status === "in-progress";
        const isTerminal =
          booking.status === "completed" ||
          booking.status === "cancelled" ||
          booking.status === "rejected";

        return (
          <div className="flex items-center gap-1.5">
            <DashboardButton
              variant="outline"
              className="h-8 w-8 rounded-lg border-blue/30 bg-muted/30 p-0 text-navy shadow-sm transition-all duration-200 hover:border-blue/30 hover:bg-blue/10 hover:text-blue hover:shadow-md"
              icon={<Eye className="h-4 w-4" />}
              onClick={() => handleView(booking)}
              ariaLabel={`View booking ${booking.bookingNumber}`}
            />

            <DropdownMenu>
              <DropdownMenuTrigger>
                <DashboardButton
                  variant="outline"
                  className="h-8 w-8 rounded-lg border-blue/30 bg-muted/30 p-0 text-navy shadow-sm transition-all duration-200 hover:border-blue/30 hover:bg-blue/10 hover:text-blue hover:shadow-md"
                  icon={<MoreHorizontal className="h-4 w-4" />}
                  ariaLabel={`Actions for booking ${booking.bookingNumber}`}
                />
              </DropdownMenuTrigger>
              <DropdownMenuContent align="end" className="w-52">
                <DropdownMenuGroup>
                  <DropdownMenuLabel>Booking Actions</DropdownMenuLabel>
                  <DropdownMenuSeparator />

                  <DropdownMenuItem
                    className="cursor-pointer"
                    disabled={isTerminal}
                    onClick={() => handleUpdateStatus(booking)}
                  >
                    <BadgeCheck className="mr-2 h-4 w-4 text-blue" />
                    {isTerminal ? "Status (Terminal)" : "Update Status"}
                  </DropdownMenuItem>

                  <DropdownMenuItem
                    className="cursor-pointer"
                    onClick={() => handleUpdatePrice(booking)}
                  >
                    <DollarSign className="mr-2 h-4 w-4 text-emerald-600" />
                    Update Price
                  </DropdownMenuItem>

                  <DropdownMenuItem
                    className="cursor-pointer"
                    onClick={() => handleUpdateManagement(booking)}
                  >
                    <CalendarClock className="mr-2 h-4 w-4 text-amber-600" />
                    Manage Site Visit / Notes
                  </DropdownMenuItem>

                  {canCancel && (
                    <>
                      <DropdownMenuSeparator />
                      <DropdownMenuItem
                        className="cursor-pointer text-destructive focus:text-destructive"
                        onClick={() => handleCancel(booking)}
                      >
                        <Ban className="mr-2 h-4 w-4" />
                        Cancel Booking
                      </DropdownMenuItem>
                    </>
                  )}
                </DropdownMenuGroup>
              </DropdownMenuContent>
            </DropdownMenu>
          </div>
        );
      },
    },
  ];

  const table = useTable({
    features,
    columns,
    data: bookings,
  });

  if (isLoading && !data) {
    return <DashboardLoading />;
  }

  if (isError && !data) {
    return <DashboardError onRetry={() => void refetch()} />;
  }

  return (
    <section className="container mx-auto px-5 py-8 lg:px-0">
      {/* Header */}
      <header className="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h1 className="text-3xl font-bold">Service Bookings Management</h1>
          <p className="mt-1 text-muted-foreground">
            Manage customer service booking requests, inspection schedules, and
            progress.
          </p>
          {meta && !isSearchPending && (
            <p className="mt-1 text-sm text-muted-foreground">
              Showing {bookings.length} of {meta.total} bookings
            </p>
          )}
        </div>
      </header>

      {/* Filters Bar */}
      <div className="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div className="relative w-full sm:w-64 sm:shrink-0">
          <Search className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
          <Input
            placeholder="Search by booking number..."
            value={search}
            onChange={(e) => handleSearchChange(e.target.value)}
            className="h-9 rounded-full border-blue/30 bg-muted/30 pl-9 text-xs shadow-sm transition-all duration-200 focus:border-blue/40 focus:ring-2 focus:ring-blue/10"
          />
        </div>

        <div className="flex flex-wrap items-center gap-3 sm:ml-auto sm:justify-end">
          <div className="flex items-center gap-2">
            <Filter className="h-4 w-4 text-muted-foreground" />
            <span className="text-sm font-medium">Filter:</span>
          </div>

          <div className="flex items-center gap-1.5">
            <label className="text-xs font-medium text-muted-foreground">
              Status
            </label>
            <Select
              value={filterStatus || "all"}
              onValueChange={handleStatusChange}
            >
              <SelectTrigger className="h-9 w-[160px] rounded-full border-blue/30 bg-muted/30 px-3 text-xs font-semibold text-navy">
                <SelectValue placeholder="All Statuses" />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="all">All Statuses</SelectItem>
                {STATUS_OPTIONS.map((status) => (
                  <SelectItem key={status} value={status}>
                    {formatBookingStatus(status)}
                  </SelectItem>
                ))}
              </SelectContent>
            </Select>
          </div>

          {hasActiveFilters && (
            <DashboardButton
              variant="outline"
              onClick={clearFilters}
              className="h-9 rounded-full border-blue/60 bg-muted/30 px-4 text-xs font-semibold text-navy shadow-sm transition-all duration-200 hover:border-blue/30 hover:bg-blue/10 hover:text-blue hover:shadow-md"
            >
              Clear filters
            </DashboardButton>
          )}
        </div>
      </div>

      {/* Table & Empty States */}
      {bookings.length === 0 ? (
        <DashboardEmpty
          title="No bookings found"
          description="There are no service bookings matching your current filter criteria."
          icon={<CalendarDays className="h-6 w-6" />}
        />
      ) : (
        <Card className="overflow-hidden border p-0 shadow-sm">
          <div className="overflow-x-auto">
            <table className="w-full">
              <thead className="border-b bg-muted/50">
                {table.getHeaderGroups().map((headerGroup) => (
                  <tr key={headerGroup.id}>
                    {headerGroup.headers.map((header) => (
                      <th
                        key={header.id}
                        className="px-6 py-3 text-left text-sm font-medium text-muted-foreground"
                      >
                        {header.isPlaceholder ? null : (
                          <table.FlexRender header={header} />
                        )}
                      </th>
                    ))}
                  </tr>
                ))}
              </thead>
              <tbody>
                {table.getRowModel().rows.map((row) => (
                  <tr
                    key={row.id}
                    className="border-b transition-colors last:border-0 hover:bg-muted/30"
                  >
                    {row.getAllCells().map((cell) => (
                      <td key={cell.id} className="px-6 py-4">
                        <table.FlexRender cell={cell} />
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </Card>
      )}

      {/* Pagination Footer */}
      {bookings.length > 0 && (
        <div className="mt-4 flex items-center justify-between">
          <div className="flex items-center gap-2">
            <span className="text-sm text-muted-foreground">
              Rows per page:
            </span>
            <Select
              value={String(limit)}
              onValueChange={handleLimitChange}
            >
              <SelectTrigger className="h-8 w-20 rounded-full border-blue/30 bg-muted/30 px-4 text-xs !text-navy font-semibold shadow-sm transition-all duration-200 hover:border-blue/30 hover:bg-blue/5 focus:border-blue/40 focus:ring-2 focus:ring-blue/10">
                <SelectValue />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="5">5</SelectItem>
                <SelectItem value="10">10</SelectItem>
                <SelectItem value="20">20</SelectItem>
                <SelectItem value="50">50</SelectItem>
              </SelectContent>
            </Select>
          </div>

          <div className="flex items-center gap-2">
            <DashboardButton
              variant="outline"
              disabled={currentPageNum <= 1 || isSearchPending}
              onClick={() => handlePageChange(currentPageNum - 1)}
              icon={<ChevronLeft className="h-4 w-4" />}
              className="h-8 w-8 rounded-full border-blue bg-blue p-0 text-white shadow-[0_3px_10px_rgba(1,110,220,0.18)] transition-[background-color,box-shadow] duration-200 hover:bg-[#005cb9] hover:text-white hover:shadow-[0_4px_12px_rgba(1,110,220,0.24)] disabled:pointer-events-none disabled:opacity-50"
              ariaLabel="Previous page"
            />
            <span className="text-sm text-muted-foreground">
              Page {currentPageNum} of {totalPages}
            </span>
            <DashboardButton
              variant="outline"
              disabled={currentPageNum >= totalPages || isSearchPending}
              onClick={() => handlePageChange(currentPageNum + 1)}
              icon={<ChevronRight className="h-4 w-4" />}
              className="h-8 w-8 rounded-full border-blue bg-blue p-0 text-white shadow-[0_3px_10px_rgba(1,110,220,0.18)] transition-[background-color,box-shadow] duration-200 hover:bg-[#005cb9] hover:text-white hover:shadow-[0_4px_12px_rgba(1,110,220,0.24)] disabled:pointer-events-none disabled:opacity-50"
              ariaLabel="Next page"
            />
          </div>
        </div>
      )}

      {/* Dedicated Modals & Dialogs */}
      <ViewBookingModal
        isModalOpen={isViewModalOpen}
        setIsModalOpen={(open) => {
          if (!open) {
            handleCloseViewModal();
          } else {
            setIsViewModalOpen(true);
          }
        }}
        booking={selectedBooking}
      />

      <UpdateBookingStatusModal
        booking={selectedBooking}
        open={isStatusModalOpen}
        onClose={() => {
          setIsStatusModalOpen(false);
          setSelectedBooking(null);
        }}
        onSuccess={() => void refetch()}
      />

      <UpdateBookingPriceModal
        booking={selectedBooking}
        open={isPriceModalOpen}
        onClose={() => {
          setIsPriceModalOpen(false);
          setSelectedBooking(null);
        }}
        onSuccess={() => void refetch()}
      />

      <UpdateBookingManagementModal
        booking={selectedBooking}
        open={isManagementModalOpen}
        onClose={() => {
          setIsManagementModalOpen(false);
          setSelectedBooking(null);
        }}
        onSuccess={() => void refetch()}
      />

      <CancelBookingDialog
        booking={selectedBooking}
        open={isCancelDialogOpen}
        onClose={() => {
          setIsCancelDialogOpen(false);
          setSelectedBooking(null);
        }}
        onSuccess={() => void refetch()}
      />
    </section>
  );
}
</file>

<file path="app/(main)/products/[slug]/page.tsx">
import BlogContent from "@/components/blog/BlogContent";
import { Button } from "@/components/Button";
import Container from "@/components/Container";
import { ProductCard } from "@/components/ProductCard";
import ProductPurchaseSection from "@/components/products/ProductPurchaseSection";
import ProductGallery from "@/components/products/ProductGallery";
import { TdsSpecificationButton } from "@/components/products/TdsSpecificationButton";
import { Reveal } from "@/components/Reveal";
import {
  getPublishedProductBySlug,
  getPublishedProducts,
} from "@/lib/api/products";
import { getProductImageUrl } from "@/lib/products/images";
import { getTrustedTdsUrl } from "@/lib/products/tds";
import { siteUrl } from "@/lib/site-url";
import type {
  IProductImage,
  IPublishedProduct,
} from "@/types/product.type";
import type { JSONContent } from "@tiptap/react";
import {
  ArrowLeft,
  ArrowUpRight,
  CalendarDays,
  FileText,
  Layers,
  Scale,
  Tag,
} from "lucide-react";
import type { Metadata } from "next";
import Link from "next/link";
import { notFound } from "next/navigation";

type ProductPageProps = {
  params: Promise<{
    slug: string;
  }>;
};

function getProductDescription(product: IPublishedProduct) {
  const metaDescription =
    typeof product.seo?.metaDescription === "string"
      ? product.seo.metaDescription.trim()
      : "";

  const shortDescription =
    typeof product.shortDescription === "string"
      ? product.shortDescription.trim()
      : "";

  return (
    metaDescription ||
    shortDescription ||
    `Explore ${product.name} from Enviroshield.`
  );
}

function formatPrice(price: number) {
  if (!Number.isFinite(price) || price <= 0) {
    return null;
  }

  return new Intl.NumberFormat("en-BD", {
    style: "currency",
    currency: "BDT",
    maximumFractionDigits: 2,
  }).format(price);
}

function hasRichContent(content: unknown): content is JSONContent {
  if (!content || typeof content !== "object") {
    return false;
  }

  const value = content as {
    type?: unknown;
    content?: unknown;
  };

  return (
    value.type === "doc" &&
    Array.isArray(value.content) &&
    value.content.length > 0
  );
}

function getProductImages(product: IPublishedProduct) {
  const images = [
    product.primaryImage,
    ...(Array.isArray(product.gallery) ? product.gallery : []),
  ].filter((image): image is IProductImage =>
    Boolean(image && getProductImageUrl(image.url)),
  );

  return images.filter(
    (image, index, allImages) =>
      allImages.findIndex((item) => item.url === image.url) === index,
  );
}

function getStockStatus(quantity: number, threshold: number) {
  if (quantity <= 0) {
    return {
      label: "Currently out of stock",
      dot: "bg-red-500",
      pill: "bg-red-50 text-red-700",
    };
  }

  if (quantity <= threshold) {
    return {
      label: `Low stock · only ${quantity} left`,
      dot: "bg-amber-500",
      pill: "bg-amber-50 text-amber-700",
    };
  }

  return {
    label: `In stock · ${quantity} available`,
    dot: "bg-emerald-500",
    pill: "bg-emerald-50 text-emerald-700",
  };
}

export async function generateMetadata({
  params,
}: ProductPageProps): Promise<Metadata> {
  const { slug } = await params;

  try {
    const product = await getPublishedProductBySlug(slug);

    const seo = product.seo;

    const title = seo?.metaTitle?.trim() || `${product.name} | Enviroshield`;

    const description = getProductDescription(product);

    const canonical = `${siteUrl}/products/${product.slug}`;

    const keywords = seo?.keywords?.filter(Boolean) ?? [];

    const ogTitle = seo?.ogTitle?.trim() || title;

    const ogDescription = seo?.ogDescription?.trim() || description;

    const ogImage = seo?.ogImage?.trim() || product.primaryImage?.url;

    const imageAlt = product.primaryImage?.alt?.trim() || product.name;

    return {
      title,
      description,
      keywords,

      alternates: {
        canonical,
      },

      robots: {
        index: seo?.noIndex !== true,
        follow: seo?.noIndex !== true,
        googleBot: {
          index: seo?.noIndex !== true,
          follow: seo?.noIndex !== true,
        },
      },

      openGraph: {
        title: ogTitle,
        description: ogDescription,
        type: "website",
        url: canonical,
        images: [
          {
            url: ogImage,
            alt: imageAlt,
          },
        ],
      },

      twitter: {
        card: "summary_large_image",
        title: ogTitle,
        description: ogDescription,
        images: [ogImage],
      },
    };
  } catch {
    return {
      title: "Product not found | Enviroshield",
      description: "The requested Enviroshield product could not be found.",

      robots: {
        index: false,
        follow: false,
        googleBot: {
          index: false,
          follow: false,
        },
      },
    };
  }
}

export async function generateStaticParams() {
  try {
    const result = await getPublishedProducts({
      page: 1,
      limit: 100,
    });

    return result.data.map((product) => ({
      slug: product.slug,
    }));
  } catch {
    return [];
  }
}

export default async function ProductDetailPage({ params }: ProductPageProps) {
  const { slug } = await params;

  let product: IPublishedProduct | null = null;

  try {
    product = await getPublishedProductBySlug(slug);
  } catch {
    product = null;
  }

  // Only published API products can render.
  // A missing product must return a real 404.
  if (!product) {
    notFound();
  }

  const categoryName = product.categoryId?.name || "Product";

  const images = getProductImages(product);
  const description = getProductDescription(product);
  const price = formatPrice(product.price);
  const articleUrl = `${siteUrl}/products/${product.slug}`;

  const stockQuantity = Number.isFinite(product.stockQuantity)
    ? Math.max(0, product.stockQuantity)
    : 0;

  const lowStockThreshold = Number.isFinite(product.lowStockThreshold)
    ? Math.max(0, product.lowStockThreshold ?? 5)
    : 0;

  const available = stockQuantity > 0;

  const stock = getStockStatus(stockQuantity, lowStockThreshold);

  const publishedDate = product.publishedAt
    ? new Date(product.publishedAt)
    : null;

  const publishedOn =
    publishedDate && !Number.isNaN(publishedDate.getTime())
      ? publishedDate.toLocaleDateString("en-GB", {
          day: "numeric",
          month: "short",
          year: "numeric",
        })
      : null;

  // Related products from the same category.
  let related: Awaited<ReturnType<typeof getPublishedProducts>>["data"] = [];

  try {
    const categoryId =
      typeof product.categoryId === "object" ? product.categoryId._id : "";

    if (categoryId) {
      const result = await getPublishedProducts({
        page: 1,
        limit: 4,
        categoryId,
      });

      related = result.data
        .filter((item) => item._id !== product._id)
        .slice(0, 3);
