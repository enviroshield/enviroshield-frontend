  assert(footer.includes('href: "/blog"'), "Footer must link to /blog");
  assert(footer.includes('href: "/contact"'), "Footer must link to /contact");
});

console.log(`\nResults: ${passed}/${total} tests passed.\n`);
if (passed !== total) {
  process.exit(1);
}
