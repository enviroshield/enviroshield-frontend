        />

        {/* Featured tag, top-left corner */}
        {isFeatured && (
          <span className="absolute left-0 top-0 rounded-br-[16px] bg-blue px-4 py-2.5 text-[11px] font-extrabold uppercase tracking-[0.14em] text-white">
            Featured
          </span>
