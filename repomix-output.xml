<file path="components/dashboard/admin/ecommerce/categories/ViewCategoryModal.tsx">
"use client";

import {
  Calendar,
  Clock,
  Copy,
  FolderTree,
  Hash,
} from "lucide-react";
import { toast } from "sonner";

import type { ICategory } from "@/types";
import { formatDate } from "@/utils/formatDate";

import DashboardButton from "@/components/dashboard/DashboardButton";

import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogHeader,
