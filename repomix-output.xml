                        </Link>

                        {order.status === "pending" && (
                          <Button
                            type="button"
                            variant="destructive"
                            size="sm"
                            className="rounded-full"
                            onClick={() => setOrderToCancel(order)}
                            aria-label={`Cancel order ${order.orderNumber}`}
