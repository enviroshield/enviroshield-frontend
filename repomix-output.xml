<file path="components/dashboard/notifications/NotificationBell.tsx">
"use client";

import { useState } from "react";
import useSWR from "swr";
import Link from "next/link";
import { useRouter } from "next/navigation";
import {
  AlertTriangle,
  Bell,
  Boxes,
  Calendar,
  CalendarCheck,
  CheckCheck,
  CheckCircle2,
  ExternalLink,
  Inbox,
  Loader2,
  Mail,
  Package,
} from "lucide-react";
import { toast } from "sonner";

import DashboardButton from "@/components/dashboard/DashboardButton";
import {
  fetchNotifications,
  fetchUnreadCount,
  markAllNotificationsAsRead,
  markNotificationAsRead,
  resolveNotificationLink,
} from "@/lib/api/notifications";
import { cn } from "@/lib/utils";
import { INotification, TNotificationType } from "@/types/notification.type";

import { Button } from "@/components/ui/button";
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuTrigger,
} from "@/components/ui/dropdown-menu";

interface NotificationBellProps {
  role?: string | null;
}

function getNotificationIcon(type: TNotificationType) {
  if (type.startsWith("order")) {
    if (type === "order.payment_confirmed") {
      return <CheckCircle2 className="h-4 w-4 text-emerald-500" />;
    }
    if (type === "order.cancelled") {
      return <AlertTriangle className="h-4 w-4 text-rose-500" />;
    }
    return <Package className="h-4 w-4 text-blue" />;
  }

  if (type.startsWith("booking")) {
    if (type === "booking.cancelled") {
      return <AlertTriangle className="h-4 w-4 text-rose-500" />;
    }
    return <CalendarCheck className="h-4 w-4 text-teal-600" />;
  }

  if (type.startsWith("contact")) {
    return <Mail className="h-4 w-4 text-indigo-500" />;
  }

  if (type === "site_visit.scheduled") {
    return <Calendar className="h-4 w-4 text-amber-500" />;
  }

  if (type.startsWith("inventory")) {
    return <Boxes className="h-4 w-4 text-orange-500" />;
  }

  return <Bell className="h-4 w-4 text-blue" />;
}

function formatRelativeTime(dateString: string): string {
  const date = new Date(dateString);
  const now = new Date();
  const diffInSeconds = Math.floor((now.getTime() - date.getTime()) / 1000);

  if (isNaN(diffInSeconds) || diffInSeconds < 0) return "Just now";
  if (diffInSeconds < 60) return "Just now";
  const diffInMinutes = Math.floor(diffInSeconds / 60);
  if (diffInMinutes < 60) return `${diffInMinutes}m ago`;
  const diffInHours = Math.floor(diffInMinutes / 60);
  if (diffInHours < 24) return `${diffInHours}h ago`;
  const diffInDays = Math.floor(diffInHours / 24);
  if (diffInDays < 7) return `${diffInDays}d ago`;
  return date.toLocaleDateString("en-US", { month: "short", day: "numeric" });
}

export function NotificationBell({ role }: NotificationBellProps) {
  const router = useRouter();
  const [isOpen, setIsOpen] = useState(false);
  const [unreadOnly, setUnreadOnly] = useState(false);
  const [markingAll, setMarkingAll] = useState(false);

  // Poll unread count every 30 seconds
  const { data: unreadCount = 0, mutate: mutateCount } = useSWR(
    "/notifications/unread-count",
    fetchUnreadCount,
    {
      refreshInterval: 30000,
      revalidateOnFocus: true,
    },
  );

  // Fetch recent notifications when dropdown is open or unread filter changes
  const {
    data: notifData,
    isLoading: notifLoading,
    mutate: mutateList,
  } = useSWR(
    isOpen ? [`/notifications/dropdown`, unreadOnly] : null,
    () => fetchNotifications({ limit: 6, unreadOnly }),
    {
      revalidateOnFocus: false,
    },
  );

  const notifications = notifData?.data || [];

  async function handleMarkAllRead(e: React.MouseEvent) {
    e.stopPropagation();
    if (markingAll || unreadCount === 0) return;

    try {
      setMarkingAll(true);
      await markAllNotificationsAsRead();
      void mutateCount(0, false);
      if (notifData) {
        void mutateList(
          {
            ...notifData,
            data: notifData.data.map((n) => ({ ...n, isRead: true })),
          },
          false,
        );
      }
      toast.success("All notifications marked as read");
    } catch {
      toast.error("Failed to mark all as read");
    } finally {
      setMarkingAll(false);
    }
  }

  async function handleNotificationClick(notification: INotification) {
    if (!notification.isRead) {
      void markNotificationAsRead(notification._id);
      void mutateCount(Math.max(0, unreadCount - 1), false);
      if (notifData) {
        void mutateList(
          {
            ...notifData,
            data: notifData.data.map((n) =>
              n._id === notification._id ? { ...n, isRead: true } : n,
            ),
          },
          false,
        );
      }
    }

    setIsOpen(false);
    const destination = resolveNotificationLink(notification, role);
    router.push(destination);
  }

  return (
    <DropdownMenu open={isOpen} onOpenChange={setIsOpen}>
      <DropdownMenuTrigger>
        <Button
          type="button"
          variant="ghost"
          size="icon"
          aria-label={
            unreadCount > 0
              ? `${unreadCount} unread notifications`
              : "Notifications"
          }
          className={cn(
            "relative h-9 w-9 rounded-lg",
            "text-ink/60",
            "transition-colors duration-200",
            "hover:bg-blue/[0.08] hover:text-blue",
            isOpen && "bg-blue/[0.08] text-blue",
          )}
        >
          <Bell className="h-[18px] w-[18px]" />
          {unreadCount > 0 && (
            <span
              className={cn(
                "absolute -top-1 -right-1 flex items-center justify-center rounded-full bg-blue px-1 text-[10px] font-bold text-white shadow-sm ring-2 ring-white",
                unreadCount > 9 ? "min-w-[18px] h-[18px]" : "h-4 w-4",
              )}
            >
              {unreadCount > 99 ? "99+" : unreadCount}
            </span>
          )}
        </Button>
      </DropdownMenuTrigger>

      <DropdownMenuContent
        align="end"
        sideOffset={8}
        className="w-[360px] sm:w-[400px] rounded-2xl border-line/90 bg-white p-0 shadow-xl overflow-hidden animate-in fade-in-50 zoom-in-95 duration-150"
      >
        {/* Header */}
        <div className="flex items-center justify-between border-b border-line/70 px-4 py-3 bg-mist/50">
          <div className="flex items-center gap-2">
            <h3 className="text-sm font-bold text-navy">Notifications</h3>
            {unreadCount > 0 && (
              <span className="rounded-full bg-blue/10 px-2 py-0.5 text-[11px] font-semibold text-blue">
                {unreadCount} new
              </span>
            )}
          </div>

          <button
            type="button"
            onClick={handleMarkAllRead}
            disabled={markingAll || unreadCount === 0}
            className={cn(
              "inline-flex items-center gap-1 text-xs font-semibold text-blue transition-opacity hover:opacity-80 disabled:opacity-40 disabled:cursor-not-allowed",
            )}
          >
            {markingAll ? (
              <Loader2 className="h-3 w-3 animate-spin" />
            ) : (
              <CheckCheck className="h-3.5 w-3.5" />
            )}
            <span>Mark all read</span>
          </button>
        </div>

        {/* Filter Tabs using DashboardButton styling */}
        <div className="flex items-center gap-2 border-b border-line/60 px-4 py-2.5 bg-white">
          <DashboardButton
            variant={!unreadOnly ? "default" : "outline"}
            onClick={() => setUnreadOnly(false)}
            className={cn(
              "h-7 rounded-full px-3 text-xs font-semibold transition-all duration-200",
              !unreadOnly
                ? "bg-blue text-white shadow-[0_2px_8px_rgba(1,110,220,0.25)] hover:bg-[#005cb9]"
                : "border-blue/30 bg-muted/30 text-navy hover:border-blue/30 hover:bg-blue/10 hover:text-blue shadow-none",
            )}
          >
            All
          </DashboardButton>
          <DashboardButton
            variant={unreadOnly ? "default" : "outline"}
            onClick={() => setUnreadOnly(true)}
            className={cn(
              "h-7 rounded-full px-3 text-xs font-semibold transition-all duration-200",
              unreadOnly
                ? "bg-blue text-white shadow-[0_2px_8px_rgba(1,110,220,0.25)] hover:bg-[#005cb9]"
                : "border-blue/30 bg-muted/30 text-navy hover:border-blue/30 hover:bg-blue/10 hover:text-blue shadow-none",
            )}
          >
            Unread
          </DashboardButton>
        </div>

        {/* Notification List */}
        <div className="max-h-[340px] overflow-y-auto divide-y divide-line/40">
          {notifLoading ? (
            <div className="space-y-3 p-4">
              {[...Array(3)].map((_, i) => (
                <div key={i} className="flex gap-3 animate-pulse">
                  <div className="h-9 w-9 rounded-xl bg-slate-200 shrink-0" />
                  <div className="flex-1 space-y-1.5">
                    <div className="h-3.5 w-3/4 rounded bg-slate-200" />
                    <div className="h-3 w-full rounded bg-slate-100" />
                    <div className="h-2.5 w-1/4 rounded bg-slate-100" />
                  </div>
                </div>
              ))}
            </div>
          ) : notifications.length === 0 ? (
            <div className="flex flex-col items-center justify-center px-4 py-10 text-center">
              <div className="flex h-12 w-12 items-center justify-center rounded-full bg-mist text-ink/40 mb-2.5">
                <Inbox className="h-6 w-6" />
              </div>
              <p className="text-sm font-semibold text-navy">
                {unreadOnly ? "No unread notifications" : "No notifications yet"}
              </p>
              <p className="mt-1 text-xs text-ink/50 max-w-[220px]">
                {unreadOnly
                  ? "You are caught up on everything!"
                  : "Important updates about your orders and bookings will appear here."}
              </p>
            </div>
          ) : (
            notifications.map((n) => (
              <div
                key={n._id}
                onClick={() => handleNotificationClick(n)}
                role="button"
                tabIndex={0}
                className={cn(
                  "group relative flex cursor-pointer gap-3 p-3.5 text-left transition-colors",
                  !n.isRead
                    ? "bg-blue/[0.03] hover:bg-blue/[0.07]"
                    : "bg-white hover:bg-mist/70",
                )}
              >
                {/* Icon */}
                <div
                  className={cn(
                    "flex h-9 w-9 shrink-0 items-center justify-center rounded-xl transition-colors",
                    !n.isRead ? "bg-white shadow-xs border border-line/60" : "bg-mist",
                  )}
                >
                  {getNotificationIcon(n.type)}
                </div>

                {/* Details */}
                <div className="min-w-0 flex-1">
                  <div className="flex items-start justify-between gap-2">
                    <p
                      className={cn(
                        "text-xs leading-snug line-clamp-1",
                        !n.isRead
                          ? "font-bold text-navy"
                          : "font-semibold text-ink/80",
                      )}
                    >
                      {n.title}
                    </p>

                    <span className="shrink-0 text-[11px] font-medium text-ink/45">
                      {formatRelativeTime(n.createdAt)}
                    </span>
                  </div>

                  <p className="mt-0.5 text-xs text-ink/65 line-clamp-2 leading-relaxed">
                    {n.message}
                  </p>
                </div>

                {/* Unread indicator dot */}
                {!n.isRead && (
                  <span
                    aria-hidden="true"
                    className="absolute top-4 right-3 h-2 w-2 rounded-full bg-blue shrink-0 ring-2 ring-white"
                  />
                )}
              </div>
            ))
          )}
        </div>

        {/* Footer */}
        <div className="border-t border-line/70 bg-mist/40 p-2.5 text-center">
          <Link
            href="/dashboard/notifications"
            onClick={() => setIsOpen(false)}
            className="inline-flex items-center gap-1.5 text-xs font-semibold text-blue hover:text-blue-dark transition-colors py-1 px-3 rounded-lg hover:bg-blue/[0.06]"
          >
            <span>View all notifications</span>
            <ExternalLink className="h-3 w-3" />
          </Link>
        </div>
      </DropdownMenuContent>
    </DropdownMenu>
  );
}
</file>

<file path="components/dashboard/notifications/NotificationCenter.tsx">
"use client";

import { useState } from "react";
import useSWR from "swr";
import { useRouter } from "next/navigation";
import {
  AlertTriangle,
  ArrowRight,
  Bell,
  Boxes,
  Calendar,
  CalendarCheck,
  Check,
  CheckCheck,
  CheckCircle2,
  ChevronLeft,
  ChevronRight,
  Inbox,
  Loader2,
  Mail,
  Package,
  RefreshCw,
  Trash2,
} from "lucide-react";
import { toast } from "sonner";

import DashboardButton from "@/components/dashboard/DashboardButton";
import {
  deleteNotification,
  fetchNotifications,
  fetchUnreadCount,
  markAllNotificationsAsRead,
  markNotificationAsRead,
  resolveNotificationLink,
} from "@/lib/api/notifications";
import { cn } from "@/lib/utils";
import { INotification, TNotificationType } from "@/types/notification.type";

import { Button } from "@/components/ui/button";

interface NotificationCenterProps {
  role?: string | null;
}

function getNotificationIcon(type: TNotificationType) {
  if (type.startsWith("order")) {
    if (type === "order.payment_confirmed") {
      return <CheckCircle2 className="h-5 w-5 text-emerald-500" />;
    }
    if (type === "order.cancelled") {
      return <AlertTriangle className="h-5 w-5 text-rose-500" />;
    }
    return <Package className="h-5 w-5 text-blue" />;
  }

  if (type.startsWith("booking")) {
    if (type === "booking.cancelled") {
      return <AlertTriangle className="h-5 w-5 text-rose-500" />;
    }
    return <CalendarCheck className="h-5 w-5 text-teal-600" />;
  }

  if (type.startsWith("contact")) {
    return <Mail className="h-5 w-5 text-indigo-500" />;
  }

  if (type === "site_visit.scheduled") {
    return <Calendar className="h-5 w-5 text-amber-500" />;
  }

  if (type.startsWith("inventory")) {
    return <Boxes className="h-5 w-5 text-orange-500" />;
  }

  return <Bell className="h-5 w-5 text-blue" />;
}

function formatFullDate(dateString: string): string {
  try {
    const d = new Date(dateString);
    return d.toLocaleString("en-US", {
      dateStyle: "medium",
      timeStyle: "short",
    });
  } catch {
    return dateString;
  }
}

export function NotificationCenter({ role }: NotificationCenterProps) {
  const router = useRouter();
  const [page, setPage] = useState(1);
  const [unreadOnly, setUnreadOnly] = useState(false);
  const [markingAll, setMarkingAll] = useState(false);
  const [deletingId, setDeletingId] = useState<string | null>(null);
  const [readingId, setReadingId] = useState<string | null>(null);

  const {
    data: notifData,
    isLoading,
    mutate,
  } = useSWR(
    [`/notifications/center`, page, unreadOnly],
    () => fetchNotifications({ page, limit: 10, unreadOnly }),
    {
      revalidateOnFocus: true,
    },
  );

  const { data: unreadCount = 0, mutate: mutateCount } = useSWR(
    "/notifications/unread-count",
    fetchUnreadCount,
  );

  const notifications = notifData?.data || [];
  const meta = notifData?.meta || { page: 1, limit: 10, total: 0, totalPages: 1 };

  async function handleMarkAll() {
    if (markingAll || unreadCount === 0) return;
    try {
      setMarkingAll(true);
      await markAllNotificationsAsRead();
      void mutateCount(0, false);
      void mutate();
      toast.success("All notifications marked as read");
    } catch {
      toast.error("Failed to mark all as read");
    } finally {
      setMarkingAll(false);
    }
  }

  async function handleMarkAsRead(id: string) {
    try {
      setReadingId(id);
      await markNotificationAsRead(id);
      void mutateCount(Math.max(0, unreadCount - 1), false);
      if (notifData) {
        void mutate(
          {
            ...notifData,
            data: notifData.data.map((n) =>
              n._id === id ? { ...n, isRead: true } : n,
            ),
          },
          false,
        );
      }
      toast.success("Notification marked as read");
    } catch {
      toast.error("Failed to update notification");
    } finally {
      setReadingId(null);
    }
  }

  async function handleDelete(id: string) {
    try {
      setDeletingId(id);
      await deleteNotification(id);
      void mutate();
      void mutateCount();
      toast.success("Notification deleted");
    } catch {
      toast.error("Failed to delete notification");
    } finally {
      setDeletingId(null);
    }
  }

  function handleNavigate(notification: INotification) {
    if (!notification.isRead) {
      void markNotificationAsRead(notification._id);
      void mutateCount(Math.max(0, unreadCount - 1), false);
    }
    const destination = resolveNotificationLink(notification, role);
    router.push(destination);
  }

  return (
    <div className="mx-auto max-w-5xl space-y-6 p-4 sm:p-6 lg:p-8">
      {/* Page Header */}
      <div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div className="flex items-center gap-2.5">
            <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-blue/10 text-blue">
              <Bell className="h-5 w-5" />
            </div>
            <div>
              <h1 className="text-2xl font-bold tracking-tight text-navy">
                Notifications
              </h1>
              <p className="text-xs text-ink/50 sm:text-sm">
                Activity alerts, status transitions, and administrative updates.
              </p>
            </div>
          </div>
        </div>

        <div className="flex items-center gap-2.5">
          <DashboardButton
            variant="outline"
            onClick={() => void mutate()}
            icon={
              <RefreshCw
                className={cn("h-4 w-4 mr-1.5", isLoading && "animate-spin")}
              />
            }
            className="h-9 rounded-full border-blue/30 bg-muted/30 px-4 text-xs font-semibold text-navy shadow-xs transition-all duration-200 hover:border-blue/30 hover:bg-blue/10 hover:text-blue hover:shadow-sm"
          >
            <span className="hidden sm:inline">Refresh</span>
          </DashboardButton>

          <DashboardButton
            onClick={handleMarkAll}
            disabled={markingAll || unreadCount === 0}
            icon={
              markingAll ? (
                <Loader2 className="h-4 w-4 mr-1.5 animate-spin" />
              ) : (
                <CheckCheck className="h-4 w-4 mr-1.5" />
              )
            }
            className="h-9 rounded-full bg-blue px-4 text-xs font-semibold text-white shadow-[0_4px_14px_rgba(1,110,220,0.22)] transition-all duration-200 hover:bg-[#005cb9] hover:shadow-[0_6px_18px_rgba(1,110,220,0.28)] disabled:opacity-50 disabled:shadow-none"
          >
            <span>Mark all read</span>
          </DashboardButton>
        </div>
      </div>

      {/* Filter Tabs using DashboardButton styling */}
      <div className="flex items-center justify-between border-b border-line pb-4">
        <div className="flex items-center gap-2.5">
          <DashboardButton
            variant={!unreadOnly ? "default" : "outline"}
            onClick={() => {
              setUnreadOnly(false);
              setPage(1);
            }}
            className={cn(
              "h-9 rounded-full px-4 text-xs font-semibold transition-all duration-200 sm:text-sm",
              !unreadOnly
                ? "bg-blue text-white shadow-[0_4px_14px_rgba(1,110,220,0.22)] hover:bg-[#005cb9]"
                : "border-blue/30 bg-muted/30 text-navy hover:border-blue/30 hover:bg-blue/10 hover:text-blue shadow-xs",
            )}
          >
            <span>All</span>
            <span
              className={cn(
                "ml-1.5 rounded-full px-2 py-0.5 text-[11px]",
                !unreadOnly
                  ? "bg-white/20 text-white font-bold"
                  : "bg-blue/10 text-blue font-bold",
              )}
            >
              {meta.total}
            </span>
          </DashboardButton>

          <DashboardButton
            variant={unreadOnly ? "default" : "outline"}
            onClick={() => {
              setUnreadOnly(true);
              setPage(1);
            }}
            className={cn(
              "h-9 rounded-full px-4 text-xs font-semibold transition-all duration-200 sm:text-sm",
              unreadOnly
                ? "bg-blue text-white shadow-[0_4px_14px_rgba(1,110,220,0.22)] hover:bg-[#005cb9]"
                : "border-blue/30 bg-muted/30 text-navy hover:border-blue/30 hover:bg-blue/10 hover:text-blue shadow-xs",
            )}
          >
            <span>Unread</span>
            {unreadCount > 0 && (
              <span
                className={cn(
                  "ml-1.5 rounded-full px-2 py-0.5 text-[11px] font-bold",
                  unreadOnly
                    ? "bg-white text-blue"
                    : "bg-blue text-white",
                )}
              >
                {unreadCount}
              </span>
            )}
          </DashboardButton>
        </div>

        <p className="text-xs text-muted-foreground font-medium">
          Showing {notifications.length} of {meta.total} notifications
        </p>
      </div>

      {/* Notifications List */}
      <div className="space-y-3">
        {isLoading ? (
          <div className="space-y-3">
            {[...Array(4)].map((_, i) => (
              <div
                key={i}
                className="flex items-start gap-4 rounded-2xl border border-line/60 bg-white p-4 shadow-xs animate-pulse"
              >
                <div className="h-10 w-10 rounded-xl bg-slate-200 shrink-0" />
                <div className="flex-1 space-y-2">
                  <div className="h-4 w-1/3 rounded bg-slate-200" />
                  <div className="h-3.5 w-3/4 rounded bg-slate-100" />
                  <div className="h-3 w-1/4 rounded bg-slate-100" />
                </div>
              </div>
            ))}
          </div>
        ) : notifications.length === 0 ? (
          <div className="flex flex-col items-center justify-center rounded-2xl border border-dashed border-line bg-white/60 px-4 py-16 text-center">
            <div className="flex h-14 w-14 items-center justify-center rounded-2xl bg-mist text-ink/40 mb-3">
              <Inbox className="h-7 w-7" />
            </div>
            <h3 className="text-base font-bold text-navy">
              {unreadOnly ? "No unread notifications" : "No notifications"}
            </h3>
            <p className="mt-1 text-xs text-ink/50 max-w-sm">
              {unreadOnly
                ? "You have acknowledged all recent notifications. Switch to 'All' to review your past activity."
                : "You don't have any notifications right now. System updates, order events, and booking changes will appear here."}
            </p>
          </div>
        ) : (
          notifications.map((notification) => (
            <div
              key={notification._id}
              className={cn(
                "group relative flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-2xl border p-4 sm:p-5 transition-all shadow-xs",
                !notification.isRead
                  ? "border-blue/30 bg-blue/[0.02] hover:border-blue/50"
                  : "border-line/70 bg-white hover:border-line",
              )}
            >
              {/* Left Details */}
              <div className="flex items-start gap-3.5 min-w-0 flex-1">
                <div
                  className={cn(
                    "flex h-11 w-11 shrink-0 items-center justify-center rounded-xl",
                    !notification.isRead
                      ? "bg-white border border-blue/20 shadow-xs"
                      : "bg-mist",
                  )}
                >
                  {getNotificationIcon(notification.type)}
                </div>

                <div className="min-w-0 flex-1">
                  <div className="flex flex-wrap items-center gap-2">
                    <h4
                      className={cn(
                        "text-sm leading-snug",
                        !notification.isRead
                          ? "font-bold text-navy"
                          : "font-semibold text-ink/80",
                      )}
                    >
                      {notification.title}
                    </h4>

                    {!notification.isRead && (
                      <span className="rounded-full bg-blue px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white">
                        New
                      </span>
                    )}
                  </div>

                  <p className="mt-1 text-xs leading-relaxed text-ink/65 sm:text-sm">
                    {notification.message}
                  </p>

                  <p className="mt-2 text-[11px] font-medium text-ink/45">
                    {formatFullDate(notification.createdAt)}
                  </p>
                </div>
              </div>

              {/* Action Buttons */}
              <div className="flex items-center gap-2 self-end sm:self-center shrink-0 border-t border-line/40 pt-3 sm:border-0 sm:pt-0">
                {!notification.isRead && (
                  <Button
                    type="button"
                    variant="ghost"
                    size="sm"
                    onClick={() => handleMarkAsRead(notification._id)}
                    disabled={readingId === notification._id}
                    title="Mark as read"
                    className="h-8 gap-1 rounded-xl text-xs text-ink/60 hover:bg-mist hover:text-navy"
                  >
                    {readingId === notification._id ? (
                      <Loader2 className="h-3.5 w-3.5 animate-spin" />
                    ) : (
                      <Check className="h-3.5 w-3.5" />
                    )}
                    <span className="hidden sm:inline">Read</span>
                  </Button>
                )}

                <Button
                  type="button"
                  variant="ghost"
                  size="icon"
                  onClick={() => handleDelete(notification._id)}
                  disabled={deletingId === notification._id}
                  title="Delete notification"
                  className="h-8 w-8 rounded-xl text-ink/40 hover:bg-rose-50 hover:text-rose-600"
                >
                  {deletingId === notification._id ? (
                    <Loader2 className="h-3.5 w-3.5 animate-spin" />
                  ) : (
                    <Trash2 className="h-3.5 w-3.5" />
                  )}
                </Button>

                <DashboardButton
                  onClick={() => handleNavigate(notification)}
                  icon={<ArrowRight className="h-3.5 w-3.5 ml-1" />}
                  className="h-8 rounded-full bg-blue px-3.5 text-xs font-semibold text-white shadow-xs transition-all duration-200 hover:bg-[#005cb9]"
                >
                  <span>View Details</span>
                </DashboardButton>
              </div>
            </div>
          ))
        )}
      </div>

      {/* Pagination Controls */}
      {meta.totalPages > 1 && (
        <div className="flex items-center justify-between border-t border-line pt-4">
          <Button
            type="button"
            variant="outline"
            size="sm"
            onClick={() => setPage((p) => Math.max(1, p - 1))}
            disabled={page <= 1}
            className="h-9 gap-1 rounded-xl border-line"
          >
            <ChevronLeft className="h-4 w-4" />
            <span>Previous</span>
          </Button>

          <span className="text-xs font-medium text-ink/60">
            Page {meta.page} of {meta.totalPages}
          </span>

          <Button
            type="button"
            variant="outline"
            size="sm"
            onClick={() => setPage((p) => Math.min(meta.totalPages, p + 1))}
            disabled={page >= meta.totalPages}
            className="h-9 gap-1 rounded-xl border-line"
          >
            <span>Next</span>
            <ChevronRight className="h-4 w-4" />
          </Button>
        </div>
      )}
    </div>
  );
}
</file>

<file path="components/dashboard/user/orders/UserDashboardUI.tsx">
"use client";

import type { LucideIcon } from "lucide-react";
import { ChevronLeft, ChevronRight } from "lucide-react";

import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import {
  Card,
  CardContent,
} from "@/components/ui/card";

const statusStyles: Record<string, string> = {
  Processing: "border-amber-200 bg-amber-50 text-amber-800",
  Shipped: "border-blue-200 bg-blue-50 text-blue-800",
  Delivered: "border-emerald-200 bg-emerald-50 text-emerald-800",
  Cancelled: "border-slate-200 bg-slate-100 text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300",
  Paid: "border-emerald-200 bg-emerald-50 text-emerald-800",
  Pending: "border-amber-200 bg-amber-50 text-amber-800 dark:border-amber-900/60 dark:bg-amber-950/40 dark:text-amber-300",
  Refunded: "border-violet-200 bg-violet-50 text-violet-800",
  Submitted: "border-blue-200 bg-blue-50 text-blue-800",
  "Under Review": "border-violet-200 bg-violet-50 text-violet-800",
  "In Progress": "border-indigo-200 bg-indigo-50 text-indigo-800 dark:border-indigo-900/60 dark:bg-indigo-950/40 dark:text-indigo-300",
  Completed: "border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-900/60 dark:bg-emerald-950/40 dark:text-emerald-300",
  Rejected: "border-red-200 bg-red-50 text-red-800 dark:border-red-900/60 dark:bg-red-950/40 dark:text-red-300",
  Confirmed: "border-blue-200 bg-blue-50 text-blue-800 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-300",
};

export function UserStatusBadge({ status }: { status: string }) {
  return (
    <Badge variant="outline" className={`rounded-full px-2.5 py-1 font-semibold ${statusStyles[status] ?? "border-border bg-muted text-muted-foreground"}`}>
      {status}
    </Badge>
  );
}

export function UserDashboardMetric({
  title,
  value,
  description,
  icon: Icon,
  tone,
}: {
  title: string;
  value: string;
  description: string;
  icon: LucideIcon;
  tone: "blue" | "teal" | "amber";
}) {
  const toneStyles = {
    blue: "bg-blue/10 text-blue",
    teal: "bg-teal/10 text-teal",
    amber: "bg-amber-100 text-amber-700",
  };

  return (
    <Card className="rounded-2xl border-border/70 bg-background shadow-none transition-colors hover:border-blue/25">
      <CardContent className="flex items-start justify-between gap-4 p-5 sm:p-6">
        <div className="min-w-0">
          <p className="text-sm font-medium text-muted-foreground">{title}</p>
          <p className="mt-2 truncate font-display text-2xl font-bold tracking-tight text-navy sm:text-3xl">
            {value}
          </p>
          <p className="mt-1 text-xs leading-relaxed text-muted-foreground">{description}</p>
        </div>
        <div className={`flex h-11 w-11 shrink-0 items-center justify-center rounded-xl ${toneStyles[tone]}`}>
          <Icon className="h-5 w-5" aria-hidden="true" />
        </div>
      </CardContent>
    </Card>
  );
}

export function UserListPagination({
  page,
  totalPages,
  start,
  end,
  total,
  onPageChange,
}: {
  page: number;
  totalPages: number;
  start: number;
  end: number;
  total: number;
  onPageChange: (page: number) => void;
}) {
  return (
    <div className="flex flex-col gap-3 border-t border-border/60 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p className="text-xs text-muted-foreground" aria-live="polite">
        Showing <span className="font-semibold text-foreground">{start}–{end}</span> of <span className="font-semibold text-foreground">{total}</span>
      </p>
      <div className="flex items-center justify-between gap-3 sm:justify-end">
        <span className="text-xs font-medium text-muted-foreground" aria-live="polite">
          Page {page} of {totalPages}
        </span>
        <div className="flex gap-2">
          <Button
            type="button"
            variant="outline"
            size="sm"
            className="rounded-full"
            onClick={() => onPageChange(page - 1)}
            disabled={page <= 1}
            aria-label="Go to previous page"
          >
            <ChevronLeft className="h-4 w-4" />
            <span className="sr-only sm:not-sr-only">Previous</span>
          </Button>
          <Button
            type="button"
            variant="outline"
            size="sm"
            className="rounded-full"
            onClick={() => onPageChange(page + 1)}
