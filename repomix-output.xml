            <h1 className="mt-2 font-display text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
              Welcome back, {user.name}
            </h1>
          </div>
          <PeriodSelector value={period} onChange={setPeriod} />
        </div>
        <DashboardError onRetry={() => mutate()} />
