    description: project.description,
    url: projectUrl,
    image: project.primaryImage.url,
    creator: {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: "Enviroshield",
      url: siteUrl,
    },
    locationCreated: {
      "@type": "Place",
      name: location,
    },
    about: {
      "@type": "Thing",
      name: serviceName,
    },
  };

  const webPageJsonLd = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${projectUrl}#webpage`,
    url: projectUrl,
    name: project.title,
    description: project.description,
    isPartOf: {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "Enviroshield",
    },
    about: {
      "@id": `${projectUrl}#project`,
