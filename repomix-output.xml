                  <Link
                    href="/register"
                    onClick={onClose}
                    className="flex min-h-12 items-center justify-center gap-2 rounded-xl bg-blue px-3 text-sm font-bold text-white transition-colors hover:bg-deep"
                  >
                    <UserRound size={17} aria-hidden="true" />
                    Sign up
                  </Link>
                </div>
              )}
            </div>
          </motion.aside>
        </>
      )}
    </AnimatePresence>
  );
}
