              <section className="rounded-2xl border bg-white p-5">
                <h2 className="mb-4 font-semibold text-navy">
                  Delivery
                </h2>
                <div className="grid gap-4 sm:grid-cols-2">
                  <Detail
                    label="Address"
                    value={order.deliveryAddress.addressLine}
                  />
                  <Detail
                    label="Area"
                    value={order.deliveryAddress.area}
                  />
                  <Detail
                    label="City"
                    value={order.deliveryAddress.city}
                  />
                  <Detail
                    label="District"
                    value={order.deliveryAddress.district}
                  />
                  <Detail
                    label="Postal code"
                    value={order.deliveryAddress.postalCode ?? "—"}
                  />
                  <Detail
                    label="Delivery zone"
                    value={prettyOrderStatus(order.deliveryZone)}
                  />
                </div>
              </section>

              <section className="rounded-2xl border bg-white p-5">
                <h2 className="mb-4 font-semibold text-navy">
                  Ordered products
                </h2>
                <div className="space-y-3">
                  {order.items.map((item, index) => (
                    <div
                      key={`${item.productId}-${index}`}
                      className="flex flex-wrap items-center gap-3 rounded-xl border p-3 sm:flex-nowrap"
                    >
                      <div className="relative h-14 w-14 shrink-0 overflow-hidden rounded-lg bg-muted">
                        {item.primaryImage?.url ? (
                          <Image
                            src={item.primaryImage.url}
                            alt={item.primaryImage.alt || item.name}
                            fill
                            sizes="56px"
                            className="object-cover"
                          />
                        ) : (
                          <div className="flex h-full items-center justify-center text-xs text-muted-foreground">
                            No image
                          </div>
                        )}
                      </div>
                      <div className="min-w-[140px] flex-1">
                        <p className="font-medium">{item.name}</p>
                        <div className="mt-0.5 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                          {item.weight || item.size ? (
                            <span className="rounded bg-blue/10 px-1.5 py-0.5 font-semibold text-blue">
                              Weight: {item.weight || item.size}
                            </span>
                          ) : null}
                          <span>SKU: {item.sku}</span>
                        </div>
                      </div>
                      <div className="grid w-full grid-cols-3 gap-2 text-sm sm:w-auto sm:min-w-[300px]">
                        <Detail
                          label="Unit"
                          value={formatOrderAmount(
                            item.unitPrice,
                            order.currency,
                          )}
                        />
                        <Detail
                          label="Qty"
                          value={String(item.quantity)}
                        />
                        <Detail
                          label="Line total"
                          value={formatOrderAmount(
                            item.lineTotal,
                            order.currency,
                          )}
                        />
                      </div>
                    </div>
                  ))}
                </div>
              </section>

              <section className="grid gap-5 rounded-2xl border bg-white p-5 md:grid-cols-2">
                <div className="space-y-3">
                  <h2 className="font-semibold text-navy">Payment</h2>
                  <Detail
                    label="Method"
                    value={
                      order.paymentMethod === "cod"
                        ? "Cash on delivery"
                        : prettyOrderStatus(order.paymentMethod)
                    }
                  />
                  <div className="space-y-1">
                    <p className="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                      Payment status
                    </p>
                    <StatusBadge
                      status={
                        displayPaymentStatus ?? order.paymentStatus
                      }
                    />
                  </div>
                  <div className="space-y-1">
                    <p className="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                      Order status
                    </p>
                    <StatusBadge status={order.status} />
                  </div>
                </div>
                <div className="space-y-3">
                  <h2 className="font-semibold text-navy">Summary</h2>
                  <div className="flex justify-between gap-4 text-sm">
                    <span className="text-muted-foreground">
                      Subtotal
                    </span>
                    <span>
                      {formatOrderAmount(
                        order.subtotal,
                        order.currency,
                      )}
                    </span>
                  </div>
                  <div className="flex justify-between gap-4 text-sm">
                    <span className="text-muted-foreground">
                      Delivery fee
                    </span>
                    <span>
                      {formatOrderAmount(
                        order.deliveryFee,
                        order.currency,
                      )}
                    </span>
                  </div>
                  <div className="flex justify-between gap-4 border-t pt-3 font-bold text-navy">
                    <span>Total ({order.currency})</span>
                    <span>
                      {formatOrderAmount(
                        order.totalAmount,
                        order.currency,
                      )}
                    </span>
                  </div>
                </div>
              </section>

              {(order.customerNote || order.cancellationReason) && (
                <section className="grid gap-4 rounded-2xl border bg-white p-5 sm:grid-cols-2">
                  {order.customerNote && (
                    <Detail
                      label="Customer note"
                      value={order.customerNote}
                    />
                  )}
                  {order.cancellationReason && (
                    <Detail
                      label="Cancellation reason"
                      value={order.cancellationReason}
                    />
                  )}
                </section>
              )}
            </div>
          </div>
        )}
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="components/dashboard/admin/ecommerce/products/ProductsDashboard.tsx">
"use client";

import {
  Calendar,
  CheckCircle,
  ChevronLeft,
  ChevronRight,
  Edit,
  Eye,
  EyeOff,
  Filter,
  History,
  MoreHorizontal,
  Package,
  PackagePlus,
  Plus,
  Search,
  Send,
  Trash,
  XCircle,
} from "lucide-react";
import Image from "next/image";
import { useRouter } from "next/navigation";
import { useEffect, useMemo, useState } from "react";

import {
  tableFeatures,
  useTable,
  type ColumnDef,
} from "@tanstack/react-table";

import { Badge } from "@/components/ui/badge";
import { Card } from "@/components/ui/card";
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuGroup,
  DropdownMenuItem,
  DropdownMenuLabel,
  DropdownMenuSeparator,
  DropdownMenuTrigger,
} from "@/components/ui/dropdown-menu";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";

import DashboardButton from "@/components/dashboard/DashboardButton";
import DashboardEmpty from "@/components/dashboard/DashboardEmpty";
import DashboardError from "@/components/dashboard/DashboardError";
import DashboardLoading from "@/components/dashboard/DashboardLoading";

import CreateProductModal from "./CreateProductModal";
import DeleteProductDialog from "./DeleteProductDialog";
import EditProductModal from "./EditProductModal";
import ProductStatusDialog from "./ProductStatusDialog";
import StockAdjustmentModal from "./StockAdjustmentModal";
import ViewProductModal from "./ViewProductModal";

import { Input } from "@/components/ui/input";
import { useFetch } from "@/hooks/swr/useFetch";
import type { IProduct, IProductResponse } from "@/types";
import { formatDate } from "@/utils/formatDate";

const features = tableFeatures({});

export default function ProductsDashboard() {
  const router = useRouter();
  const [search, setSearch] = useState("");
  const [debouncedSearch, setDebouncedSearch] = useState("");

  const [status, setStatus] = useState("all");
  const [inStock, setInStock] = useState("all");

  const [currentPage, setCurrentPage] = useState(1);
  const [limit, setLimit] = useState(10);

  const [sortBy, setSortBy] = useState("createdAt");
  const [sortOrder, setSortOrder] = useState("desc");

  const [isCreateModalOpen, setIsCreateModalOpen] = useState(false);
  const [isEditModalOpen, setIsEditModalOpen] = useState(false);
  const [isViewModalOpen, setIsViewModalOpen] = useState(false);
  const [selectedProduct, setSelectedProduct] =
    useState<IProduct | null>(null);
  const [isDeleteDialogOpen, setIsDeleteDialogOpen] = useState(false);

  const [productToDelete, setProductToDelete] =
    useState<IProduct | null>(null);
  const [isStatusDialogOpen, setIsStatusDialogOpen] = useState(false);
  const [productToChangeStatus, setProductToChangeStatus] =
    useState<IProduct | null>(null);
  const [isStockAdjustmentOpen, setIsStockAdjustmentOpen] =
    useState(false);
  const [productToAdjust, setProductToAdjust] =
    useState<IProduct | null>(null);

  // Debounce search input before requesting the API.
  useEffect(() => {
    const timeout = setTimeout(() => {
      setDebouncedSearch(search.trim());
      setCurrentPage(1);
    }, 350);

    return () => clearTimeout(timeout);
  }, [search]);

  // Build the endpoint using the supported query parameters.
  const endpoint = useMemo(() => {
    const params = new URLSearchParams();

    if (debouncedSearch) {
      params.set("search", debouncedSearch);
    }

    if (status !== "all") {
      params.set("status", status);
    }

    if (inStock !== "all") {
      params.set("inStock", inStock);
    }

    params.set("page", String(currentPage));
    params.set("limit", String(limit));
    params.set("sortBy", sortBy);
    params.set("sortOrder", sortOrder);

    return `/product?${params.toString()}`;
  }, [
    debouncedSearch,
    status,
    inStock,
    currentPage,
    limit,
    sortBy,
    sortOrder,
  ]);

  const { data, isLoading, isError, refetch } =
    useFetch<IProductResponse>(endpoint);

  const products = data?.data ?? [];
  const meta = data?.meta;

  const handleStatusChange = (value: string | null) => {
    setStatus(value ?? "all");
    setCurrentPage(1);
  };

  const handleStockChange = (value: string | null) => {
    setInStock(value ?? "all");
    setCurrentPage(1);
  };

  const handleLimitChange = (value: string | null) => {
    if (!value) return;

    setLimit(Number(value));
    setCurrentPage(1);
  };

  const handleSortByChange = (value: string | null) => {
    if (!value) return;

    setSortBy(value);
    setCurrentPage(1);
  };

  const handleSortOrderChange = (value: string | null) => {
    if (!value) return;

    setSortOrder(value);
    setCurrentPage(1);
  };

  const clearFilters = () => {
    setSearch("");
    setDebouncedSearch("");
    setStatus("all");
    setInStock("all");
    setCurrentPage(1);
    setSortBy("createdAt");
    setSortOrder("desc");
  };

  const handleView = (product: IProduct) => {
    setSelectedProduct(product);
    setIsViewModalOpen(true);
  };

  const handleEdit = (product: IProduct) => {
    setSelectedProduct(product);
    setIsEditModalOpen(true);
  };

  const handleProductStatusAction = (product: IProduct) => {
    setProductToChangeStatus(product);
    setIsStatusDialogOpen(true);
  };

  const handleInventoryMovements = (product: IProduct) => {
    router.push(
      `/dashboard/ecommerce/products/${encodeURIComponent(product._id)}/inventory-movements`,
    );
  };

  const handleAdjustStock = (product: IProduct) => {
    setProductToAdjust(product);
    setIsStockAdjustmentOpen(true);
  };

  const handleDelete = (product: IProduct) => {
    setProductToDelete(product);
    setIsDeleteDialogOpen(true);
  };

  const columns: ColumnDef<typeof features, IProduct>[] = [
    {
      accessorKey: "name",
      header: "Product",
      cell: ({ row }) => {
        const product = row.original;

        return (
          <div className="flex min-w-[280px] max-w-[360px] items-center gap-3">
            <div className="relative h-11 w-11 shrink-0 overflow-hidden rounded-xl border border-slate-200 bg-slate-100">
              {product.primaryImage?.url ? (
                <Image
                  src={product.primaryImage.url}
                  alt={product.primaryImage.alt || product.name}
                  fill
                  sizes="44px"
                  unoptimized
                  className="object-cover"
                />
              ) : (
                <div className="flex h-full items-center justify-center text-blue">
                  <Package className="h-4 w-4" />
                </div>
              )}
            </div>

            <div className="min-w-0 flex-1 space-y-0.5">
              <div className="flex min-w-0 items-center gap-1.5">
                <p
                  className="truncate text-sm font-semibold text-slate-900"
                  title={product.name}
                >
                  {product.name}
                </p>

                {product.isFeatured && (
                  <span className="shrink-0 rounded-full bg-blue/10 px-1.5 py-0.5 text-[9px] font-semibold text-blue">
                    Featured
                  </span>
                )}
              </div>

              {product.shortDescription ? (
                <p
                  className="truncate text-xs text-slate-500"
                  title={product.shortDescription}
                >
                  {product.shortDescription}
                </p>
              ) : null}

              <div className="flex min-w-0 items-center gap-1.5 whitespace-nowrap text-[11px] text-slate-400">
                <span className="shrink-0 font-medium text-slate-500 whitespace-nowrap">
                  {product.sku}
                </span>
                <span className="h-1 w-1 shrink-0 rounded-full bg-slate-300" />
                <span
                  className="min-w-0 truncate text-slate-400"
                  title={`/${product.slug}`}
                >
                  /{product.slug}
                </span>
              </div>
            </div>
          </div>
        );
      },
    },
    {
      accessorKey: "categoryId",
      header: "Category",
      cell: ({ row }) => (
        <span className="inline-flex max-w-[140px] truncate rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">
          {typeof row.original.categoryId === "object"
            ? row.original.categoryId?.name
            : row.original.categoryId || "—"}
        </span>
      ),
    },
    {
      accessorKey: "price",
      header: "Price",
      cell: ({ row }) => {
        const variants = row.original.variants || [];
        const hasVariants = variants.length > 1;
        const prices = variants.map((v) => v.price);
        const minPrice = prices.length ? Math.min(...prices) : row.original.price;
        const maxPrice = prices.length ? Math.max(...prices) : row.original.price;

        const costs = variants
          .map((v) => v.costPrice)
          .filter((c): c is number => typeof c === "number" && c > 0);
        const minCost = costs.length ? Math.min(...costs) : row.original.costPrice;
        const maxCost = costs.length ? Math.max(...costs) : row.original.costPrice;
        const hasCost = minCost !== undefined && minCost > 0;

        return (
          <div className="min-w-[90px]">
            <p className="font-semibold text-slate-800 text-sm">
              {hasVariants
                ? `৳${minPrice.toLocaleString("en-BD")} – ৳${maxPrice.toLocaleString("en-BD")}`
                : `৳${row.original.price.toLocaleString("en-BD")}`}
            </p>

            <div className="mt-0.5 flex flex-wrap items-center gap-1 text-[11px] text-slate-400">
              {hasVariants ? (
                <span className="rounded bg-blue/10 px-1.5 py-0.5 text-[10px] font-semibold text-blue">
                  {variants.length} weights
                </span>
              ) : null}
              {hasCost && maxCost !== undefined && (
                <span>
                  Cost: ৳{minCost.toLocaleString("en-BD")}
                  {minCost !== maxCost ? ` – ৳${maxCost.toLocaleString("en-BD")}` : ""}
                </span>
              )}
            </div>
          </div>
        );
      },
    },
    {
      accessorKey: "stockQuantity",
      header: "Stock",
      cell: ({ row }) => {
        const product = row.original;
        const variants = product.variants || [];
        const isOutOfStock = product.stockQuantity <= 0;
        const hasLowStockVariant = variants.some(
          (v) =>
            v.stockQuantity <=
            (v.lowStockThreshold ?? product.lowStockThreshold ?? 5),
        );
        const isLowStock =
          !isOutOfStock &&
          (hasLowStockVariant ||
            product.stockQuantity <= (product.lowStockThreshold ?? 5));

        return (
          <div className="min-w-[90px] space-y-0.5">
            <span
              className={`text-sm font-semibold ${
                isOutOfStock
                  ? "text-red-600"
                  : isLowStock
                    ? "text-amber-700"
                    : "text-slate-800"
              }`}
            >
              {product.stockQuantity} units
            </span>

            <p className="text-[11px] text-slate-400">
              {isOutOfStock
                ? "Out of stock"
                : isLowStock
                  ? "Low stock"
                  : "In stock"}
            </p>
          </div>
        );
      },
    },
    {
      accessorKey: "status",
      header: "Status",
      cell: ({ row }) => {
        const product = row.original;
        const isPublished = product.status === "published";

        return (
          <div className="flex min-w-[110px] flex-col items-start gap-1">
            {isPublished ? (
              <Badge className="gap-1 rounded-full bg-green-500 px-2.5 py-0.5 text-[10px] font-semibold capitalize hover:bg-green-600">
                <CheckCircle className="h-3 w-3" />
                Published
              </Badge>
            ) : (
              <Badge
                variant="secondary"
                className="gap-1 rounded-full px-2.5 py-0.5 text-[10px] font-semibold capitalize"
              >
                <XCircle className="h-3 w-3" />
                {product.status}
              </Badge>
            )}

            <span className="text-[10px] text-slate-400">
              {product.publishedAt
                ? `Published ${formatDate(product.publishedAt)}`
                : "Not published yet"}
            </span>
          </div>
        );
      },
    },
    {
      accessorKey: "updatedAt",
      header: "Last Updated",
      cell: ({ row }) => (
        <div className="min-w-[110px] space-y-0.5">
          <div className="flex items-center gap-1.5 text-xs font-semibold text-slate-700">
            <Calendar className="h-3.5 w-3.5 text-slate-400" />
            {formatDate(row.original.updatedAt)}
          </div>

          <p className="text-[10px] text-slate-400">
            Created {formatDate(row.original.createdAt)}
          </p>
        </div>
      ),
    },
    {
      id: "actions",
      header: "Actions",

      cell: ({ row }) => {
        const product = row.original;

        return (
          <div className="flex items-center gap-1.5">
            <DashboardButton
              variant="outline"
              className="h-8 w-8 rounded-lg border-blue/30 bg-muted/30 p-0 text-navy shadow-sm transition-all duration-200 hover:border-blue/30 hover:bg-blue/10 hover:text-blue hover:shadow-md"
              icon={<Eye className="h-4 w-4" />}
              onClick={() => handleView(product)}
              ariaLabel="View product details"
            />

            <DropdownMenu>
              <DropdownMenuTrigger>
                <DashboardButton
                  variant="outline"
                  className="h-8 w-8 rounded-lg border-blue/30 bg-muted/30 p-0 text-navy shadow-sm transition-all duration-200 hover:border-blue/30 hover:bg-blue/10 hover:text-blue hover:shadow-md"
                  icon={<MoreHorizontal className="h-4 w-4" />}
                  ariaLabel="Product actions"
                />
              </DropdownMenuTrigger>

              <DropdownMenuContent align="end" className="w-40">
                <DropdownMenuGroup>
                  <DropdownMenuLabel>Actions</DropdownMenuLabel>

                  <DropdownMenuSeparator />

                  <DropdownMenuItem
                    className="cursor-pointer"
                    onClick={() => handleProductStatusAction(product)}
                  >
                    {product.status === "published" ? (
                      <EyeOff className="mr-2 h-4 w-4" />
                    ) : (
                      <Send className="mr-2 h-4 w-4" />
                    )}
                    {product.status === "published"
                      ? "Unpublish"
                      : "Publish"}
                  </DropdownMenuItem>

                  <DropdownMenuItem
                    className="cursor-pointer"
                    onClick={() => handleInventoryMovements(product)}
                  >
                    <History className="mr-2 h-4 w-4" />
                    Inventory History
                  </DropdownMenuItem>

                  <DropdownMenuItem
                    className="cursor-pointer"
                    onClick={() => handleAdjustStock(product)}
                  >
                    <PackagePlus className="mr-2 h-4 w-4" />
                    Adjust Stock
                  </DropdownMenuItem>

                  <DropdownMenuItem
                    className="cursor-pointer"
                    onClick={() => handleEdit(product)}
                  >
                    <Edit className="mr-2 h-4 w-4" />
                    Edit
                  </DropdownMenuItem>

                  <DropdownMenuItem
                    className="cursor-pointer text-red-600 focus:text-red-600"
                    onClick={() => handleDelete(product)}
                  >
                    <Trash className="mr-2 h-4 w-4" />
                    Delete
                  </DropdownMenuItem>
                </DropdownMenuGroup>
              </DropdownMenuContent>
            </DropdownMenu>
          </div>
        );
      },
    },
  ];

  const table = useTable({
    features,
    columns,
    data: products,
  });

  if (isLoading && !data) {
    return <DashboardLoading />;
  }

  if (isError && !data) {
    return <DashboardError onRetry={() => refetch()} />;
  }

  const totalPages = meta?.totalPages ?? 1;
  const currentPageNum = meta?.page ?? currentPage;
  const hasActiveFilters =
    search.trim() !== "" ||
    status !== "all" ||
    inStock !== "all" ||
    sortBy !== "createdAt" ||
    sortOrder !== "desc";

  return (
    <section className="container mx-auto px-5 py-8 lg:px-0">
      {/* Header */}
      <div className="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h1 className="text-3xl font-bold">Product Management</h1>

          <p className="mt-1 text-muted-foreground">
            Manage product information, pricing, stock, and
            publishing.
          </p>

          {meta && (
            <p className="mt-1 text-sm text-muted-foreground">
              Showing {products.length} products on this page of{" "}
              {meta.total} total products
            </p>
          )}
        </div>

        <DashboardButton
          icon={<Plus className="h-4 w-4" />}
          onClick={() => setIsCreateModalOpen(true)}
        >
          Add Product
        </DashboardButton>
      </div>

      {/* Search and filters */}
      <div className="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        {/* Search */}
        <div className="relative w-full sm:w-64 sm:shrink-0">
          <Search className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
          <Input
            placeholder="Search products..."
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            className="h-9 rounded-full border-blue/30 bg-muted/30 pl-9 text-xs shadow-sm transition-all duration-200 focus:border-blue/40 focus:ring-2 focus:ring-blue/10"
          />
        </div>

        {/* Filters */}

        {/* Filters */}
        <div className="flex flex-wrap items-center gap-3 sm:ml-auto sm:justify-end">
          <div className="flex items-center gap-2">
            <Filter className="h-4 w-4 text-muted-foreground" />
            <span className="text-sm font-medium">Filter:</span>
          </div>

          {/* Status filter */}
          <div className="flex items-center gap-1.5">
            <label className="text-xs font-medium text-muted-foreground">
              Status
            </label>
            <Select value={status} onValueChange={handleStatusChange}>
              <SelectTrigger className="h-9 w-[125px] rounded-full border-blue/30 bg-muted/30 px-3 text-xs font-semibold text-navy">
                <SelectValue placeholder="All status" />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="all">All status</SelectItem>
                <SelectItem value="published">Published</SelectItem>
                <SelectItem value="draft">Draft</SelectItem>
              </SelectContent>
            </Select>
          </div>

          {/* Stock filter */}
          <div className="flex items-center gap-1.5">
            <label className="text-xs font-medium text-muted-foreground">
              Stock
            </label>
            <Select value={inStock} onValueChange={handleStockChange}>
              <SelectTrigger className="h-9 w-[125px] rounded-full border-blue/30 bg-muted/30 px-3 text-xs font-semibold text-navy">
                <SelectValue placeholder="All stock" />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="all">All stock</SelectItem>
                <SelectItem value="true">In stock</SelectItem>
                <SelectItem value="false">Out of stock</SelectItem>
              </SelectContent>
            </Select>
          </div>

          {/* Sort field */}
          <div className="flex items-center gap-1.5">
            <label className="text-xs font-medium text-muted-foreground">
              Sort by
            </label>
            <Select value={sortBy} onValueChange={handleSortByChange}>
              <SelectTrigger className="h-9 w-[140px] rounded-full border-blue/30 bg-muted/30 px-3 text-xs font-semibold text-navy">
                <SelectValue placeholder="Sort by" />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="createdAt">
                  Date created
                </SelectItem>
                <SelectItem value="updatedAt">
                  Last updated
                </SelectItem>
                <SelectItem value="name">Product name</SelectItem>
                <SelectItem value="price">Price</SelectItem>
                <SelectItem value="stockQuantity">
                  Stock quantity
                </SelectItem>
              </SelectContent>
            </Select>
          </div>

          {/* Sort direction */}
          <div className="flex items-center gap-1.5">
            <label className="text-xs font-medium text-muted-foreground">
              Order
            </label>
            <Select
              value={sortOrder}
              onValueChange={handleSortOrderChange}
            >
              <SelectTrigger className="h-9 w-[115px] rounded-full border-blue/30 bg-muted/30 px-3 text-xs font-semibold text-navy">
                <SelectValue placeholder="Order" />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="desc">Descending</SelectItem>
                <SelectItem value="asc">Ascending</SelectItem>
              </SelectContent>
            </Select>
          </div>

          {hasActiveFilters && (
            <DashboardButton
              variant="outline"
              onClick={clearFilters}
              className="h-9 rounded-full px-4 text-xs"
            >
              Clear
            </DashboardButton>
          )}
        </div>
      </div>

      {/* Products table */}
      {products.length === 0 ? (
        <DashboardEmpty
          title="No products found"
          description={
            hasActiveFilters
              ? "Try changing your search or filters."
              : "Your product catalogue is empty. Add your first product to get started."
          }
          icon={<Package className="h-6 w-6" />}
          actionLabel={
            hasActiveFilters ? undefined : "Add Your First Product"
          }
          onAction={() => setIsCreateModalOpen(true)}
        />
      ) : (
        <Card className="overflow-hidden border p-0 shadow-sm">
          <div className="overflow-x-auto">
            <table className="w-full">
              <thead className="border-b bg-muted/50">
                {table.getHeaderGroups().map((headerGroup) => (
                  <tr key={headerGroup.id}>
                    {headerGroup.headers.map((header) => (
                      <th
                        key={header.id}
                        className="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-muted-foreground"
                      >
                        {header.isPlaceholder ? null : (
                          <table.FlexRender header={header} />
                        )}
                      </th>
                    ))}
                  </tr>
                ))}
              </thead>

              <tbody>
                {table.getRowModel().rows.map((row) => (
                  <tr
                    key={row.original._id}
                    className="border-b transition-colors last:border-0 hover:bg-muted/30"
                  >
                    {row.getAllCells().map((cell) => (
                      <td key={cell.id} className="px-4 py-3 text-sm">
                        <table.FlexRender cell={cell} />
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </Card>
      )}

      {/* Pagination */}
      {products.length > 0 && (
        <div className="mt-4 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div className="flex items-center gap-2">
            <span className="text-sm text-muted-foreground">
              Rows per page:
            </span>

            <Select
              value={String(limit)}
              onValueChange={handleLimitChange}
            >
              <SelectTrigger className="h-8 w-20 rounded-full border-blue/30 bg-muted/30 px-4 text-xs font-semibold text-navy">
                <SelectValue />
              </SelectTrigger>

              <SelectContent>
                <SelectItem value="5">5</SelectItem>
                <SelectItem value="10">10</SelectItem>
                <SelectItem value="20">20</SelectItem>
                <SelectItem value="50">50</SelectItem>
              </SelectContent>
            </Select>
          </div>

          <div className="flex items-center gap-3">
            <span className="text-sm text-muted-foreground">
              Page {currentPageNum} of {totalPages}
            </span>

            <DashboardButton
              variant="outline"
              disabled={currentPageNum <= 1}
              onClick={() => setCurrentPage(currentPageNum - 1)}
              icon={<ChevronLeft className="h-4 w-4" />}
              className="h-8 w-8 rounded-full border-blue bg-blue p-0 text-white hover:bg-[#005cb9] hover:text-white disabled:pointer-events-none disabled:opacity-50"
              ariaLabel="Previous page"
            />

            <DashboardButton
              variant="outline"
              disabled={currentPageNum >= totalPages}
              onClick={() => setCurrentPage(currentPageNum + 1)}
              icon={<ChevronRight className="h-4 w-4" />}
              className="h-8 w-8 rounded-full border-blue bg-blue p-0 text-white hover:bg-[#005cb9] hover:text-white disabled:pointer-events-none disabled:opacity-50"
              ariaLabel="Next page"
            />
          </div>
        </div>
      )}

      {/* CREATE PRODUCT */}
      <CreateProductModal
        isModalOpen={isCreateModalOpen}
        setIsModalOpen={setIsCreateModalOpen}
        revalidateKey={`/product?page=${currentPage}&limit=${limit}`}
        onSuccess={() => refetch()}
      />

      {/* EDIT PRODUCT */}
      <EditProductModal
        product={selectedProduct}
        open={isEditModalOpen}
        revalidateKey={endpoint}
        onClose={() => {
          setIsEditModalOpen(false);
          setSelectedProduct(null);
          refetch();
        }}
      />

      {/* VIEW PRODUCT */}
      <ViewProductModal
        product={selectedProduct}
        isModalOpen={isViewModalOpen}
        setIsModalOpen={(open) => {
          setIsViewModalOpen(open);

          if (!open) {
            setSelectedProduct(null);
          }
        }}
      />

      {/* PRODUCT STATUS */}
      <ProductStatusDialog
        product={productToChangeStatus}
        open={isStatusDialogOpen}
        revalidateKey={endpoint}
        onClose={() => {
          setIsStatusDialogOpen(false);
          setProductToChangeStatus(null);
        }}
      />

      {/* STOCK ADJUSTMENT */}
      <StockAdjustmentModal
        product={productToAdjust}
        open={isStockAdjustmentOpen}
        revalidateKey={endpoint}
        onClose={() => {
          setIsStockAdjustmentOpen(false);
          setProductToAdjust(null);
        }}
      />

      {/* DELETE PRODUCT */}
      <DeleteProductDialog
        product={productToDelete}
        open={isDeleteDialogOpen}
        revalidateKey={`/product?page=${currentPage}&limit=${limit}`}
        onClose={() => {
          setIsDeleteDialogOpen(false);
          setProductToDelete(null);
          refetch();
        }}
      />
    </section>
  );
}
</file>

<file path="components/dashboard/admin/ecommerce/products/ViewProductModal.tsx">
"use client";

import {
  Calendar,
  CheckCircle,
  Clock,
  ExternalLink,
  FileText,
  Globe,
  Image as ImageIcon,
  Package,
  Search,
  Tag,
  Truck,
  XCircle,
} from "lucide-react";
import Image from "next/image";
import { useState } from "react";

import { PdfViewerModal } from "@/components/pdf-viewer-modal";
import type { IProduct } from "@/types";
import { formatDate } from "@/utils/formatDate";
import { HeroMeta, InfoCard, OgImagePreview, SectionHeading, SeoCard, TimelineItem } from "../../common/ViewModalUI";
import { ProductDescriptionViewer } from "./ProductDescriptionViewer";
import { MetricCard } from "./ProductMetricCard";

import DashboardButton from "@/components/dashboard/DashboardButton";
import { Badge } from "@/components/ui/badge";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";


type ViewProductModalProps = {
  isModalOpen: boolean;
  setIsModalOpen: (open: boolean) => void;
  product: IProduct | null;
};

export default function ViewProductModal({
  isModalOpen,
  setIsModalOpen,
  product,
}: ViewProductModalProps) {
  const [isTdsModalOpen, setIsTdsModalOpen] = useState(false);

  if (!product) return null;

  const isPublished = product.status === "published";
  const variants = product.variants || [];
  const prices = variants.map((v) => v.price).filter((p) => typeof p === "number");
  const minPrice = prices.length ? Math.min(...prices) : product.price ?? 0;
  const maxPrice = prices.length ? Math.max(...prices) : product.price ?? 0;
  const priceDisplay =
    minPrice === maxPrice
      ? `৳${minPrice.toLocaleString("en-BD")}`
      : `৳${minPrice.toLocaleString("en-BD")} – ৳${maxPrice.toLocaleString("en-BD")}`;

  const costs = variants
    .map((v) => v.costPrice)
    .filter((c): c is number => typeof c === "number" && c > 0);
  const minCost = costs.length ? Math.min(...costs) : undefined;
  const maxCost = costs.length ? Math.max(...costs) : undefined;
  const costDisplay =
    minCost !== undefined && maxCost !== undefined
      ? minCost === maxCost
        ? `৳${minCost.toLocaleString("en-BD")}`
        : `৳${minCost.toLocaleString("en-BD")} – ৳${maxCost.toLocaleString("en-BD")}`
      : "Not specified";

  const isOutOfStock = (product.stockQuantity ?? 0) <= 0;
  const hasLowStockVariant = variants.some(
    (v) =>
      v.stockQuantity <=
      (v.lowStockThreshold ?? product.lowStockThreshold ?? 5),
  );
  const isLowStock =
    !isOutOfStock &&
    (hasLowStockVariant ||
      (product.stockQuantity ?? 0) <= (product.lowStockThreshold ?? 5));

  const description =
    product.description &&
    typeof product.description === "object" &&
    !Array.isArray(product.description)
      ? product.description
      : {
          type: "doc",
          content: [{ type: "paragraph" }],
        };

  const handleClose = () => {
    setIsModalOpen(false);
  };

  return (
    <Dialog
      open={isModalOpen}
      onOpenChange={(open) => {
        if (!open) handleClose();
      }}
    >
      <DialogContent className="max-h-[92vh] !max-w-6xl overflow-y-auto border-0 bg-[#f8fafc] p-0 shadow-2xl">
        <DialogHeader className="sr-only">
          <DialogTitle>Product Details</DialogTitle>
          <DialogDescription>
            View complete product information, description, inventory, technical
            data, and SEO settings.
          </DialogDescription>
        </DialogHeader>

        <div className="overflow-hidden">
          {/* HERO */}
          <section className="relative overflow-hidden bg-navy px-6 py-6 text-white sm:px-8 sm:py-8">
            <div className="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-blue/20 blur-3xl" />
            <div className="pointer-events-none absolute -bottom-32 left-1/3 h-64 w-64 rounded-full bg-blue/10 blur-3xl" />

            <div className="relative grid gap-6 lg:grid-cols-[340px_1fr]">
              {/* Primary image */}
              <div className="relative min-h-[240px] overflow-hidden rounded-2xl border border-white/10 bg-white/5 shadow-xl">
                {product.primaryImage?.url ? (
                  <Image
                    src={product.primaryImage.url}
                    alt={product.primaryImage.alt || product.name}
                    fill
                    priority
                    sizes="(max-width: 1024px) 100vw, 340px"
                    unoptimized
                    className="object-contain p-4"
                  />
                ) : (
                  <div className="flex h-full min-h-[240px] items-center justify-center">
                    <Package className="h-14 w-14 text-white/30" />
                  </div>
                )}

                <div className="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent px-5 pb-4 pt-12">
                  <p className="text-xs font-medium uppercase tracking-[0.16em] text-white/60">
                    Primary Product Image
                  </p>
                  {product.primaryImage?.alt && (
                    <p className="mt-1 text-sm text-white/90">
                      {product.primaryImage.alt}
                    </p>
                  )}
                </div>
              </div>

              {/* Product heading */}
              <div className="flex min-w-0 flex-col justify-between">
                <div>
                  <div className="flex flex-wrap items-center gap-2">
                    <Badge
                      className={
                        isPublished
                          ? "gap-1 border-0 bg-emerald-500 text-white hover:bg-emerald-500"
                          : "gap-1 border-0 bg-white/10 text-white hover:bg-white/15"
                      }
                    >
                      {isPublished ? (
                        <CheckCircle className="h-3 w-3" />
                      ) : (
                        <XCircle className="h-3 w-3" />
                      )}
                      <span className="capitalize">{product.status}</span>
                    </Badge>

                    <Badge
                      className={`gap-1 border-0 ${
                        isOutOfStock
                          ? "bg-red-500/20 text-red-100 hover:bg-red-500/20"
                          : isLowStock
                            ? "bg-amber-500/20 text-amber-100 hover:bg-amber-500/20"
                            : "bg-emerald-500/20 text-emerald-100 hover:bg-emerald-500/20"
                      }`}
                    >
                      <Package className="h-3 w-3" />
                      {isOutOfStock
                        ? "Out of stock"
                        : isLowStock
                          ? "Low stock"
                          : "In stock"}
                    </Badge>

                    {product.isFeatured && (
                      <Badge className="gap-1 border-0 bg-blue/20 text-blue-100 hover:bg-blue/20">
                        <Tag className="h-3 w-3" />
                        Featured
                      </Badge>
                    )}
                  </div>

                  <p className="mt-6 text-xs font-semibold uppercase tracking-[0.18em] text-blue-200">
                    Ecommerce / Product
                  </p>

                  <h2 className="mt-2 break-words text-3xl font-bold tracking-tight sm:text-4xl">
                    {product.name}
                  </h2>

                  <div className="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-white/50">
                    <span className="break-all font-mono">
                      SKU: {product.sku}
                    </span>
                    <span className="hidden h-1 w-1 rounded-full bg-white/30 sm:block" />
                    <span className="break-all font-mono">/{product.slug}</span>
                  </div>

                  {product.shortDescription && (
                    <p className="mt-5 max-w-3xl text-sm leading-7 text-white/70 sm:text-[15px]">
                      {product.shortDescription}
                    </p>
                  )}
                </div>

                {/* Hero metadata */}
                <div className="mt-7 grid gap-3 sm:grid-cols-3">
                  <HeroMeta
                    icon={<Calendar className="h-4 w-4" />}
                    label="Created"
                    value={formatDate(product.createdAt)}
                  />
                  <HeroMeta
                    icon={<Clock className="h-4 w-4" />}
                    label="Updated"
                    value={formatDate(product.updatedAt)}
                  />
                  <HeroMeta
                    icon={<Globe className="h-4 w-4" />}
                    label="Published"
                    value={
                      product.publishedAt
                        ? formatDate(product.publishedAt)
                        : "Not published"
                    }
                  />
                </div>
              </div>
            </div>
          </section>

          <div className="space-y-6 p-5 sm:p-8">
            {/* PRODUCT INFORMATION */}
            <section>
              <SectionHeading
                eyebrow="Overview"
                title="Product Information"
                description="Product identity, category, pricing, and inventory details."
              />

              <div className="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                <InfoCard
                  label="Product Name"
                  value={product.name}
                  icon={<Package className="h-4 w-4" />}
                />

                <InfoCard
                  label="SKU"
                  value={product.sku || "Not provided"}
                  mono
                />

                <InfoCard
                  label="Category"
                  value={
                    typeof product.categoryId === "object"
                      ? product.categoryId?.name
                      : product.categoryId || "Uncategorized"
                  }
                  icon={<Tag className="h-4 w-4" />}
                />

                <InfoCard label="Slug" value={product.slug} mono />

                <InfoCard label="Product ID" value={product._id} mono />

                <InfoCard
                  label="Weights"
                  value={
                    product.variants && product.variants.length > 0
                      ? product.variants
                          .map((v) => v.weight || v.size)
                          .filter(Boolean)
                          .join(", ")
                      : (product.weight && product.weight > 0)
                        ? `${product.weight} kg`
                        : "Not specified"
                  }
                  icon={<Truck className="h-4 w-4" />}
                />
              </div>

              <div className="mt-3 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <p className="text-[11px] font-bold uppercase tracking-[0.14em] text-slate-400">
                  Short Description
                </p>
                <p className="mt-2 whitespace-pre-wrap text-sm leading-7 text-slate-600">
                  {product.shortDescription || "No short description provided."}
                </p>
              </div>
            </section>

            {/* PRICING AND INVENTORY */}
            <section>
              <SectionHeading
                eyebrow="Commerce"
                title="Weights, Pricing & Inventory"
                description="All available weights, individual prices, and variant inventory levels."
              />

              {product.variants && product.variants.length > 0 ? (
                <div className="mt-4 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                  <div className="overflow-x-auto">
                    <table className="w-full text-left text-sm">
                      <thead className="border-b border-slate-100 bg-slate-50/75 text-xs font-bold uppercase tracking-wider text-slate-500">
                        <tr>
                          <th className="px-5 py-3.5">Weight</th>
                          <th className="px-5 py-3.5">Price</th>
                          <th className="px-5 py-3.5">Cost</th>
                          <th className="px-5 py-3.5">Stock</th>
                          <th className="px-5 py-3.5">SKU</th>
                          <th className="px-5 py-3.5 text-right">Status</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-slate-100">
                        {product.variants.map((v, i) => {
                          const vOutOfStock = v.stockQuantity <= 0;
                          const vLowStock =
                            !vOutOfStock &&
                            v.stockQuantity <= (v.lowStockThreshold ?? product.lowStockThreshold ?? 5);

                          return (
                            <tr key={v._id || i} className="hover:bg-slate-50/50">
                              <td className="px-5 py-3.5 font-bold text-navy">
                                {v.weight || v.size}
                              </td>
                              <td className="px-5 py-3.5 font-extrabold text-blue">
                                ৳{(v.price ?? 0).toLocaleString("en-BD")}
                              </td>
                              <td className="px-5 py-3.5 text-slate-500">
                                ৳{(v.costPrice ?? 0).toLocaleString("en-BD")}
                              </td>
                              <td className="px-5 py-3.5 font-semibold text-slate-700">
                                {v.stockQuantity}
                              </td>
                              <td className="px-5 py-3.5 font-mono text-xs text-slate-500">
                                {v.sku || product.sku}
                              </td>
                              <td className="px-5 py-3.5 text-right">
                                <span
                                  className={`inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold ${
                                    vOutOfStock
                                      ? "bg-red-50 text-red-700"
                                      : vLowStock
                                        ? "bg-amber-50 text-amber-700"
                                        : "bg-emerald-50 text-emerald-700"
                                  }`}
                                >
                                  {vOutOfStock
                                    ? "Out of stock"
                                    : vLowStock
                                      ? "Low stock"
                                      : "In stock"}
                                </span>
                              </td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                </div>
              ) : null}

              <div className="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                <MetricCard
                  label="Price Range"
                  value={priceDisplay}
                  detail={variants.length > 1 ? `${variants.length} weight variants` : "Standard pricing"}
                  accent="blue"
                />

                <MetricCard
                  label="Cost Range"
                  value={costDisplay}
                  detail="Per variant cost price"
                  accent="gray"
                />

                <MetricCard
                  label="Total Stock"
                  value={`${(product.stockQuantity ?? 0).toLocaleString("en-BD")} units`}
                  detail={variants.length > 1 ? `Combined across ${variants.length} weights` : "Available inventory"}
                  accent={isOutOfStock ? "red" : isLowStock ? "amber" : "green"}
                />

                <MetricCard
                  label="Stock Health"
                  value={isOutOfStock ? "Out of Stock" : isLowStock ? "Low Stock" : "In Stock"}
                  detail={isOutOfStock ? "No units left" : isLowStock ? "Needs restock" : "Sufficient inventory"}
                  accent={isOutOfStock ? "red" : isLowStock ? "amber" : "green"}
                />
              </div>
            </section>

            {/* GALLERY */}
            <section>
              <SectionHeading
                eyebrow="Media"
                title="Product Gallery"
                description="Additional images associated with this product."
              />

              <div className="mt-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                {product.gallery?.length ? (
                  <div className="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
                    {product.gallery.map((image, index) => (
                      <a
                        key={`${image.publicId || image.url}-${index}`}
                        href={image.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        className="group overflow-hidden rounded-xl border border-slate-200 bg-slate-50 transition-shadow hover:shadow-md"
                      >
                        <div className="relative aspect-square">
                          {image.url ? (
                            <Image
                              src={image.url}
                              alt={
                                image.alt ||
                                `${product.name} image ${index + 1}`
                              }
                              fill
                              sizes="(max-width: 640px) 50vw, 25vw"
                              unoptimized
                              className="object-contain p-3 transition-transform duration-300 group-hover:scale-105"
                            />
                          ) : (
                            <div className="flex h-full items-center justify-center">
                              <ImageIcon className="h-8 w-8 text-slate-300" />
                            </div>
                          )}
                        </div>
                        <div className="flex items-center justify-between gap-2 border-t border-slate-100 px-3 py-2">
                          <p className="truncate text-xs text-slate-500">
                            {image.alt || `Image ${index + 1}`}
                          </p>
                          <ExternalLink className="h-3.5 w-3.5 shrink-0 text-slate-400" />
                        </div>
                      </a>
                    ))}
                  </div>
                ) : (
                  <EmptyMessage message="No additional product images have been added." />
                )}
              </div>
            </section>

            {/* RICH TEXT DESCRIPTION */}
            <section>
              <SectionHeading
                eyebrow="Product Details"
                title="Full Description"
                description="Complete product content rendered from the rich text editor."
              />

              <div className="mt-5">
                <ProductDescriptionViewer content={description} />
              </div>
            </section>

            {/* TECHNICAL DATA SHEET */}
            <section>
              <SectionHeading
                eyebrow="Documentation"
                title="Technical Data Sheet"
                description="Technical documentation associated with this product."
              />

              <div className="mt-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                {product.tdsUrl ? (
                  <div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                    <div className="flex min-w-0 items-center gap-3">
                      <div className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-blue/10 text-blue">
                        <FileText className="h-5 w-5" />
                      </div>
                      <div className="min-w-0">
                        <p className="text-sm font-semibold text-navy">
                          Technical Data Sheet
                        </p>
                        <p className="mt-1 break-all text-xs text-slate-500">
                          Product technical documentation
                        </p>
                      </div>
                    </div>

                    <div className="flex items-center gap-2">
                      <button
                        type="button"
                        onClick={() => setIsTdsModalOpen(true)}
                        className="inline-flex h-9 shrink-0 items-center justify-center gap-2 rounded-full bg-blue px-4 text-xs font-semibold text-white shadow-sm transition-colors hover:bg-blue/90"
                      >
                        <FileText className="h-3.5 w-3.5" />
                        View TDS
                      </button>
                      <a
                        href={product.tdsUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        className="inline-flex h-9 shrink-0 items-center justify-center gap-2 rounded-full border border-blue/30 px-3 text-xs font-semibold text-navy transition-colors hover:bg-blue/5 hover:text-blue"
                        title="Open in new tab"
                      >
                        <ExternalLink className="h-3.5 w-3.5" />
                      </a>
                    </div>
                  </div>
                ) : (
                  <EmptyMessage message="No technical data sheet has been uploaded." />
                )}
              </div>
            </section>

            <PdfViewerModal
