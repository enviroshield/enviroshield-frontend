<file path="components/dashboard/analytics/charts/InteractiveAreaChart.tsx">
"use client";

import { useId, useMemo, useState } from "react";
import { cn } from "@/lib/utils";

export interface DataPoint {
  label: string;
  value: number;
  secondaryValue?: number;
  date?: string;
}

interface InteractiveAreaChartProps {
  data: DataPoint[];
  height?: number;
  valuePrefix?: string;
  valueSuffix?: string;
  primaryLabel?: string;
  secondaryLabel?: string;
  showSecondary?: boolean;
  className?: string;
}

export function InteractiveAreaChart({
  data,
  height = 240,
  valuePrefix = "",
  valueSuffix = "",
  primaryLabel = "Value",
  secondaryLabel = "Secondary",
  showSecondary = false,
  className,
}: InteractiveAreaChartProps) {
  const chartId = useId().replace(/:/g, "-");
  const [activeIndex, setActiveIndex] = useState<number | null>(null);

  const padding = { top: 20, right: 16, bottom: 32, left: 48 };
  const width = 800;
  const innerWidth = width - padding.left - padding.right;
  const innerHeight = height - padding.top - padding.bottom;

  const { maxValue, points, secondaryPoints, yAxisTicks } = useMemo(() => {
    if (!data || data.length === 0) {
      return {
        maxValue: 100,
        points: [],
        secondaryPoints: [],
        yAxisTicks: [0, 50, 100],
      };
    }

    const maxPrimary = Math.max(...data.map((d) => d.value), 0);
    const maxSec = showSecondary
      ? Math.max(...data.map((d) => d.secondaryValue || 0), 0)
      : 0;
    const computedMax = Math.max(maxPrimary, maxSec);

    // Nice round max for Y axis
    const magnitude = computedMax > 0 ? Math.pow(10, Math.floor(Math.log10(computedMax))) : 10;
    const roundedMax =
      computedMax === 0
        ? 100
        : Math.ceil(computedMax / magnitude) * magnitude || 100;

    const count = data.length;
    const xStep = count > 1 ? innerWidth / (count - 1) : 0;

    const primaryPts = data.map((d, i) => {
      const x = padding.left + (count > 1 ? i * xStep : innerWidth / 2);
      const y = padding.top + innerHeight - (d.value / roundedMax) * innerHeight;
      return { x, y, ...d };
    });

    const secPts = showSecondary
      ? data.map((d, i) => {
          const x = padding.left + (count > 1 ? i * xStep : innerWidth / 2);
          const val = d.secondaryValue || 0;
          const y = padding.top + innerHeight - (val / roundedMax) * innerHeight;
          return { x, y, value: val };
        })
      : [];

    const yTicks = [
      0,
      Math.round(roundedMax * 0.25),
      Math.round(roundedMax * 0.5),
      Math.round(roundedMax * 0.75),
      roundedMax,
    ];

    return {
      maxValue: roundedMax,
      points: primaryPts,
      secondaryPoints: secPts,
      yAxisTicks: yTicks,
    };
  }, [data, innerHeight, innerWidth, padding.left, padding.top, showSecondary]);

  // Construct SVG paths
  const areaPath = useMemo(() => {
    if (points.length === 0) return "";
    const first = points[0];
    const last = points[points.length - 1];

    let path = `M ${first.x} ${first.y}`;
    for (let i = 1; i < points.length; i++) {
      const prev = points[i - 1];
      const curr = points[i];
      const cx = (prev.x + curr.x) / 2;
      path += ` C ${cx} ${prev.y}, ${cx} ${curr.y}, ${curr.x} ${curr.y}`;
    }

    const bottomY = padding.top + innerHeight;
    path += ` L ${last.x} ${bottomY} L ${first.x} ${bottomY} Z`;
    return path;
  }, [points, padding.top, innerHeight]);

  const linePath = useMemo(() => {
    if (points.length === 0) return "";
    let path = `M ${points[0].x} ${points[0].y}`;
    for (let i = 1; i < points.length; i++) {
      const prev = points[i - 1];
      const curr = points[i];
      const cx = (prev.x + curr.x) / 2;
      path += ` C ${cx} ${prev.y}, ${cx} ${curr.y}, ${curr.x} ${curr.y}`;
    }
    return path;
  }, [points]);

  const secondaryLinePath = useMemo(() => {
    if (!showSecondary || secondaryPoints.length === 0) return "";
    let path = `M ${secondaryPoints[0].x} ${secondaryPoints[0].y}`;
    for (let i = 1; i < secondaryPoints.length; i++) {
      const prev = secondaryPoints[i - 1];
      const curr = secondaryPoints[i];
      const cx = (prev.x + curr.x) / 2;
      path += ` C ${cx} ${prev.y}, ${cx} ${curr.y}, ${curr.x} ${curr.y}`;
    }
    return path;
  }, [secondaryPoints, showSecondary]);

  const formatYValue = (num: number) => {
    if (num >= 1_000_000) return `${(num / 1_000_000).toFixed(1)}M`;
    if (num >= 1_000) return `${(num / 1_000).toFixed(0)}k`;
    return num.toString();
  };

  const activePoint = activeIndex !== null ? points[activeIndex] : null;
  const activeSecPoint =
    activeIndex !== null && showSecondary ? secondaryPoints[activeIndex] : null;

  const isAllZero = points.every((p) => p.value === 0);

  return (
    <div className={cn("relative w-full select-none", className)}>
      {/* Tooltip Float */}
      {activePoint && (
        <div
          className="pointer-events-none absolute z-20 flex flex-col gap-1 rounded-xl border border-border/80 bg-background/95 px-3 py-2 text-xs shadow-md backdrop-blur-sm transition-all duration-75"
          style={{
            left: `${(activePoint.x / width) * 100}%`,
            top: `${Math.max(10, activePoint.y - 65)}px`,
            transform:
              activePoint.x > width * 0.7
                ? "translateX(-100%)"
                : activePoint.x < width * 0.3
                  ? "translateX(0)"
                  : "translateX(-50%)",
          }}
        >
          <span className="font-semibold text-foreground">
            {activePoint.label}
          </span>
          <div className="flex items-center gap-1.5 text-muted-foreground">
            <span className="inline-block h-2 w-2 rounded-full bg-blue" />
            <span>{primaryLabel}:</span>
            <span className="font-semibold text-foreground">
              {valuePrefix}
              {activePoint.value.toLocaleString()}
              {valueSuffix}
            </span>
          </div>
          {showSecondary && activeSecPoint && (
            <div className="flex items-center gap-1.5 text-muted-foreground">
              <span className="inline-block h-2 w-2 rounded-full bg-emerald-500" />
              <span>{secondaryLabel}:</span>
              <span className="font-semibold text-foreground">
                {valuePrefix}
                {activeSecPoint.value.toLocaleString()}
                {valueSuffix}
              </span>
            </div>
          )}
        </div>
      )}

      {/* SVG Canvas */}
      <svg
        viewBox={`0 0 ${width} ${height}`}
        className="w-full overflow-visible"
        style={{ height }}
      >
        <defs>
          <linearGradient
            id={`area-gradient-${chartId}`}
            x1="0"
            y1="0"
            x2="0"
            y2="1"
          >
            <stop offset="0%" stopColor="#016edc" stopOpacity="0.28" />
            <stop offset="100%" stopColor="#016edc" stopOpacity="0.0" />
          </linearGradient>
        </defs>

        {/* Grid lines */}
        {yAxisTicks.map((tick, i) => {
          const y =
            padding.top + innerHeight - (tick / maxValue) * innerHeight;
          return (
            <g key={i}>
              <line
                x1={padding.left}
                y1={y}
                x2={width - padding.right}
                y2={y}
                stroke="currentColor"
                className="text-border/40"
                strokeDasharray="4 4"
                strokeWidth={1}
              />
              <text
                x={padding.left - 8}
                y={y + 4}
                textAnchor="end"
                className="fill-muted-foreground text-[10px]"
              >
                {formatYValue(tick)}
              </text>
            </g>
          );
        })}

        {/* Primary Area & Line */}
        {areaPath && (
          <path
            d={areaPath}
            fill={`url(#area-gradient-${chartId})`}
            className="transition-all duration-300"
          />
        )}

        {linePath && (
          <path
            d={linePath}
            fill="none"
            stroke="#016edc"
            strokeWidth={2.5}
            strokeLinecap="round"
            strokeLinejoin="round"
          />
        )}

        {/* Secondary Line */}
        {secondaryLinePath && (
          <path
            d={secondaryLinePath}
            fill="none"
            stroke="#10b981"
            strokeWidth={2}
            strokeDasharray="4 4"
            strokeLinecap="round"
            strokeLinejoin="round"
          />
        )}

        {/* Interactive Hover Vertical Line */}
        {activePoint && (
          <line
            x1={activePoint.x}
            y1={padding.top}
            x2={activePoint.x}
            y2={padding.top + innerHeight}
            stroke="currentColor"
            className="text-foreground/30"
            strokeDasharray="3 3"
            strokeWidth={1.5}
          />
        )}

        {/* Interactive Point Marker */}
        {activePoint && (
          <g>
            <circle
              cx={activePoint.x}
              cy={activePoint.y}
              r={5}
              fill="#016edc"
              stroke="#ffffff"
              strokeWidth={2}
            />
            {activeSecPoint && (
              <circle
                cx={activeSecPoint.x}
                cy={activeSecPoint.y}
                r={4}
                fill="#10b981"
                stroke="#ffffff"
                strokeWidth={2}
              />
            )}
          </g>
        )}

        {/* X Axis Labels */}
        {points.map((p, i) => {
          // Downsample labels so they don't overlap if many points (e.g. 30d or 90d)
          const total = points.length;
          const stride = total > 40 ? 10 : total > 15 ? 4 : total > 7 ? 2 : 1;
          const isVisible = i % stride === 0 || i === total - 1;

          if (!isVisible) return null;

          return (
            <text
              key={i}
              x={p.x}
              y={height - 8}
              textAnchor="middle"
              className="fill-muted-foreground text-[10px]"
            >
              {p.label}
            </text>
          );
        })}

        {/* Transparent Interactive Columns for Hover */}
        {points.map((p, i) => {
          const colWidth = innerWidth / Math.max(1, points.length);
          return (
            <rect
              key={i}
              x={p.x - colWidth / 2}
              y={padding.top}
              width={colWidth}
              height={innerHeight}
              fill="transparent"
              className="cursor-pointer"
              onMouseEnter={() => setActiveIndex(i)}
              onMouseLeave={() => setActiveIndex(null)}
              onTouchStart={() => setActiveIndex(i)}
            />
          );
        })}
      </svg>

      {/* Empty State Banner if all values are 0 */}
      {isAllZero && (
        <div className="absolute inset-0 flex items-center justify-center pointer-events-none">
          <p className="rounded-lg bg-background/80 px-3 py-1.5 text-xs text-muted-foreground border border-border/40 shadow-xs">
            No activity recorded for this period
          </p>
        </div>
      )}
    </div>
  );
}
</file>

<file path="components/dashboard/analytics/charts/StatusDonutChart.tsx">
"use client";

import { useMemo, useState } from "react";
import { cn } from "@/lib/utils";

export interface StatusSegment {
  label: string;
  count: number;
  color: string;
}

interface StatusDonutChartProps {
  title?: string;
  data: StatusSegment[];
  className?: string;
}

export function StatusDonutChart({
  title,
  data,
  className,
}: StatusDonutChartProps) {
  const [hoveredIndex, setHoveredIndex] = useState<number | null>(null);

  const total = useMemo(() => {
    return data.reduce((acc, curr) => acc + curr.count, 0);
  }, [data]);

  const size = 180;
  const strokeWidth = 24;
  const radius = (size - strokeWidth) / 2;
  const circumference = 2 * Math.PI * radius;

  // Compute stroke offsets for each segment
  const segments = useMemo(() => {
    if (total === 0) return [];

    let currentOffset = 0;
    return data.map((item, index) => {
      const percentage = (item.count / total) * 100;
      const strokeLength = (item.count / total) * circumference;
      const strokeDashoffset = -currentOffset;
      currentOffset += strokeLength;

      return {
        ...item,
        index,
        percentage: Math.round(percentage * 10) / 10,
        strokeLength,
        strokeDashoffset,
      };
    });
  }, [data, total, circumference]);

  const activeSegment =
    hoveredIndex !== null ? segments[hoveredIndex] : null;

  return (
    <div
      className={cn(
        "flex flex-col items-center justify-between gap-6 p-4",
        className,
      )}
    >
      {title && (
        <h4 className="text-sm font-semibold text-foreground self-start">
          {title}
        </h4>
      )}

      {/* Donut and Center Text */}
      <div className="relative flex items-center justify-center">
        <svg
          width={size}
          height={size}
          viewBox={`0 0 ${size} ${size}`}
          className="transform -rotate-90 select-none overflow-visible"
        >
          {/* Base Empty Circle */}
          <circle
            cx={size / 2}
            cy={size / 2}
            r={radius}
            fill="none"
            stroke="currentColor"
            className="text-muted/60"
            strokeWidth={strokeWidth}
          />

          {/* Slices */}
          {total > 0 &&
            segments.map((seg) => {
              const isHovered = hoveredIndex === seg.index;
              return (
                <circle
                  key={seg.label}
                  cx={size / 2}
                  cy={size / 2}
                  r={radius}
                  fill="none"
                  stroke={seg.color}
                  strokeWidth={isHovered ? strokeWidth + 4 : strokeWidth}
                  strokeDasharray={`${seg.strokeLength} ${circumference}`}
                  strokeDashoffset={seg.strokeDashoffset}
                  strokeLinecap="butt"
                  className="transition-all duration-200 cursor-pointer"
                  onMouseEnter={() => setHoveredIndex(seg.index)}
                  onMouseLeave={() => setHoveredIndex(null)}
                />
              );
            })}
        </svg>

        {/* Center label */}
        <div className="pointer-events-none absolute flex flex-col items-center justify-center text-center">
          {activeSegment ? (
            <>
              <span className="font-display text-xl font-bold text-foreground">
                {activeSegment.count}
              </span>
              <span className="text-[11px] font-medium text-muted-foreground truncate max-w-[100px]">
                {activeSegment.label}
              </span>
              <span className="text-[10px] text-muted-foreground">
                ({activeSegment.percentage}%)
              </span>
            </>
          ) : (
            <>
              <span className="font-display text-2xl font-bold tracking-tight text-foreground">
                {total}
              </span>
              <span className="text-[11px] font-medium text-muted-foreground">
                Total
              </span>
            </>
          )}
        </div>
      </div>

      {/* Legend */}
      <div className="w-full grid grid-cols-2 gap-2 text-xs">
        {data.map((item, idx) => {
          const isHovered = hoveredIndex === idx;
          const percentage =
            total > 0 ? Math.round((item.count / total) * 100) : 0;
          return (
            <div
              key={item.label}
              onMouseEnter={() => setHoveredIndex(idx)}
              onMouseLeave={() => setHoveredIndex(null)}
              className={cn(
                "flex items-center justify-between rounded-lg p-1.5 transition-colors cursor-pointer",
                isHovered
                  ? "bg-muted/80 text-foreground font-medium"
                  : "text-muted-foreground hover:bg-muted/40",
              )}
            >
              <div className="flex items-center gap-2 truncate pr-1">
                <span
                  className="h-2.5 w-2.5 shrink-0 rounded-full"
                  style={{ backgroundColor: item.color }}
                />
                <span className="capitalize truncate">{item.label}</span>
              </div>
              <span className="text-foreground font-semibold shrink-0">
                {item.count} <span className="text-muted-foreground text-[10px]">({percentage}%)</span>
              </span>
            </div>
          );
        })}
      </div>
    </div>
  );
}
</file>

<file path="components/dashboard/analytics/charts/TopBarChart.tsx">
"use client";

import { useMemo } from "react";
import { cn } from "@/lib/utils";

export interface RankedItem {
  id: string;
  name: string;
  subLabel?: string;
  count: number;
  revenue?: number;
}

interface TopBarChartProps {
  title?: string;
  items: RankedItem[];
  countLabel?: string;
  showRevenue?: boolean;
  emptyMessage?: string;
  className?: string;
}

export function TopBarChart({
  title,
  items,
  countLabel = "Sold",
  showRevenue = true,
  emptyMessage = "No items recorded in this period",
  className,
}: TopBarChartProps) {
  const maxCount = useMemo(() => {
    return Math.max(...items.map((i) => i.count), 1);
  }, [items]);

  return (
    <div className={cn("flex flex-col gap-4 p-4", className)}>
      {title && (
        <h4 className="text-sm font-semibold text-foreground">{title}</h4>
      )}

      {items.length === 0 ? (
        <div className="flex h-36 items-center justify-center text-xs text-muted-foreground border border-dashed rounded-xl">
          {emptyMessage}
        </div>
      ) : (
        <div className="space-y-3">
          {items.map((item, index) => {
            const barPercentage = Math.round((item.count / maxCount) * 100);
            return (
              <div key={item.id || index} className="space-y-1.5">
                <div className="flex items-center justify-between text-xs">
                  <div className="flex items-center gap-2 truncate pr-2">
                    <span className="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-bold text-muted-foreground">
                      {index + 1}
                    </span>
                    <span className="font-medium text-foreground truncate">
                      {item.name}
                    </span>
                    {item.subLabel && (
                      <span className="text-[10px] text-muted-foreground truncate">
                        ({item.subLabel})
                      </span>
                    )}
                  </div>
                  <div className="flex items-center gap-2 shrink-0">
                    <span className="font-semibold text-foreground">
                      {item.count}{" "}
                      <span className="text-[10px] text-muted-foreground font-normal">
                        {countLabel}
                      </span>
                    </span>
                    {showRevenue && item.revenue !== undefined && (
                      <span className="text-muted-foreground text-[11px]">
                        • ৳{item.revenue.toLocaleString()}
                      </span>
                    )}
                  </div>
                </div>

                {/* Progress bar */}
                <div className="h-2 w-full overflow-hidden rounded-full bg-muted/60">
                  <div
                    className="h-full rounded-full bg-blue transition-all duration-500"
                    style={{ width: `${barPercentage}%` }}
                  />
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  );
}
