                    <img
                      src={testimonial.clientImage.url}
                      alt={
                        testimonial.clientImage.alt ||
                        testimonial.clientName
                      }
                      className="h-full w-full object-cover"
                    />
                  ) : (
                    <MessageSquareQuote className="h-14 w-14 text-white/30" />
