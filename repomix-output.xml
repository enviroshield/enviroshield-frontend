                            </button>
                          </div>
                          <div className="mt-3 flex items-center justify-between gap-3">
                            <div className="inline-flex h-9 items-center overflow-hidden rounded-full border border-line">
                              <button
                                type="button"
                                onClick={() =>
                                  setQuantity(
                                    item.productId,
                                    item.quantity - 1,
                                    item.variantId,
                                  )
                                }
                                disabled={item.quantity <= 1}
                                aria-label={`Decrease ${item.name} quantity`}
                                className="grid size-9 place-items-center text-navy hover:bg-mist disabled:opacity-40"
                              >
                                <Minus size={14} />
                              </button>
                              <span
                                className="min-w-8 text-center text-sm font-bold tabular-nums text-navy"
                                aria-label={`Quantity ${item.quantity}`}
                              >
                                {item.quantity}
                              </span>
                              <button
                                type="button"
                                onClick={() =>
                                  setQuantity(
                                    item.productId,
                                    item.quantity + 1,
                                    item.variantId,
                                  )
                                }
                                disabled={
                                  item.quantity >=
                                    (item.stockQuantity ?? 99) ||
                                  item.quantity >= 99
                                }
                                aria-label={`Increase ${item.name} quantity`}
                                className="grid size-9 place-items-center text-navy hover:bg-mist disabled:opacity-40"
                              >
                                <Plus size={14} />
                              </button>
                            </div>
                            <span className="text-sm font-extrabold tabular-nums text-navy">
                              {money(item.price * item.quantity)}
                            </span>
                          </div>
                        </div>
                      </li>
                    );
                  })}
                </ul>
                <footer className="shrink-0 border-t border-line bg-white px-6 pb-6 pt-5">
                  <div className="flex items-center justify-between text-sm">
                    <span className="text-ink/65">Subtotal</span>
                    <span className="text-lg font-extrabold tabular-nums text-navy">
                      {money(subtotal)}
                    </span>
                  </div>
                  <p className="mt-2 text-xs leading-5 text-ink/55">
                    Delivery is calculated at checkout. Final prices
                    are confirmed when your order is placed.
                  </p>
                  <Link
                    href="/cart"
                    onClick={onClose}
                    className="mt-5 flex min-h-12 items-center justify-center rounded-full border border-blue text-sm font-bold text-blue transition-colors hover:bg-blue/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
                  >
                    View cart
                  </Link>
                  <Link
                    href="/checkout"
                    onClick={onClose}
                    className="mt-3 flex min-h-12 items-center justify-center gap-2 rounded-full bg-blue text-sm font-bold text-white transition-colors hover:bg-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
                  >
                    Proceed to checkout{" "}
                    <ArrowRight size={16} aria-hidden="true" />
                  </Link>
                  <button
                    type="button"
                    onClick={onClose}
                    className="mt-3 w-full py-2 text-sm font-semibold text-ink/65 underline decoration-transparent underline-offset-4 hover:text-blue hover:decoration-current"
                  >
                    Continue shopping
                  </button>
                </footer>
              </>
            )}
          </motion.aside>
        </>
      )}
    </AnimatePresence>
  );
}
