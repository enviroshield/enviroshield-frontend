                    icon={<Calendar className="h-4 w-4" />}
                    label="Created"
                    value={formatDate(contact.createdAt)}
                  />

                  <div className="hidden h-8 w-px bg-slate-200 sm:block" />

                  <TimelineItem
                    icon={<Clock className="h-4 w-4" />}
                    label="Last Updated"
                    value={formatDate(contact.updatedAt)}
                  />
                </div>
              </div>
            </section>

            {/* =====================================================
