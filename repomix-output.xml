<file path="components/ProductCard.tsx">
import { FileText, ImageOff } from "lucide-react";
import Image from "next/image";
import Link from "next/link";

import { Button } from "@/components/Button";
import { getProductImageUrl } from "@/lib/products/images";
import { getTrustedTdsUrl } from "@/lib/products/tds";
import type { IPublishedProduct } from "@/types/product.type";

const CURRENCY = "৳";

export function ProductCard({
  product,
}: {
  product: IPublishedProduct;
}) {
  const name = product.name;
  const slug = product.slug;
  const category = product.categoryId?.name || "Product";
  const imageUrl = product.primaryImage?.url;
  const imageAlt = product.primaryImage?.alt || name;
  const description = product.shortDescription;
  const sku = product.sku;
  const price = product.price;
  const stockQuantity = product.stockQuantity;
  const lowStockThreshold = product.lowStockThreshold;
  const isFeatured = product.isFeatured;
  const tdsUrl = product.tdsUrl;

  const detailsHref = `/products/${slug}`;
  const safeTdsUrl = getTrustedTdsUrl(tdsUrl);
  const safeImageUrl = getProductImageUrl(imageUrl);

  const availableQuantity = Number.isFinite(stockQuantity)
    ? Math.max(0, stockQuantity)
    : 0;

  const threshold = Number.isFinite(lowStockThreshold)
    ? Math.max(0, lowStockThreshold ?? 5)
    : 0;

  const outOfStock = availableQuantity === 0;
  const lowStock =
    !outOfStock && availableQuantity <= threshold;

  return (
    <article className="group/card relative flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-white transition-all duration-500 hover:-translate-y-1 hover:border-blue/30 hover:shadow-[0_18px_40px_rgba(0,51,78,0.12)]">
      <Link
        href={detailsHref}
        aria-label={`View ${name}`}
        className="relative block aspect-[4/3] overflow-hidden bg-mist"
      >
        {safeImageUrl ? (
          <Image
            src={safeImageUrl}
            alt={imageAlt || name}
            fill
            sizes="(max-width: 600px) 100vw, (max-width: 1200px) 50vw, 33vw"
            className={`object-cover transition-transform duration-700 ease-out group-hover/card:scale-105 ${
              outOfStock ? "opacity-60 grayscale" : ""
            }`}
          />
        ) : (
          <span className="flex h-full w-full items-center justify-center text-ink/30">
            <ImageOff size={40} aria-hidden="true" />
          </span>
        )}

        <span
          aria-hidden="true"
          className="pointer-events-none absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-white/60 to-transparent"
        />
      </Link>

      <div className="pointer-events-none absolute left-4 top-4 flex flex-col items-start gap-2">
        {isFeatured && (
          <span className="rounded-full bg-blue px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-white shadow-[0_4px_12px_rgba(1,110,220,0.35)]">
            Featured
          </span>
        )}

        {outOfStock ? (
          <span className="rounded-full bg-navy px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-white">
            Out of stock
          </span>
        ) : lowStock ? (
          <span className="rounded-full bg-amber-500 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-white">
            Only {availableQuantity} left
          </span>
        ) : null}
      </div>

      <div className="flex flex-1 flex-col gap-3 p-5">
        <div className="flex items-center justify-between gap-3">
          <span className="truncate rounded-full bg-mist px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-deep">
            {category}
          </span>

          {sku && (
            <span className="shrink-0 text-[11px] text-ink/50">
              SKU: {sku}
            </span>
          )}
        </div>

        <h3 className="text-[17px] font-bold leading-snug text-navy">
          <Link
            href={detailsHref}
            className="transition-colors hover:text-blue"
          >
            {name}
          </Link>
        </h3>

        {description && (
          <p className="line-clamp-2 text-sm leading-relaxed text-ink/70">
            {description}
          </p>
        )}

        <div className="mt-auto flex items-end justify-between gap-3 pt-3">
          <div>
            <p className="text-[11px] font-medium uppercase tracking-wider text-ink/50">
              {product.variants && product.variants.length > 1 ? "Starting from" : "Price"}
            </p>

            <p className="text-[22px] font-extrabold leading-none text-blue">
              {(() => {
                const variants = product.variants || [];
                const lowestPrice =
                  variants.length > 0
                    ? Math.min(...variants.map((v) => v.price))
                    : price;

                if (lowestPrice !== null && Number.isFinite(lowestPrice) && lowestPrice >= 0) {
                  return variants.length > 1
                    ? `From ${CURRENCY}${lowestPrice.toLocaleString("en-BD")}`
                    : `${CURRENCY}${lowestPrice.toLocaleString("en-BD")}`;
                }
                return "Contact us";
              })()}
            </p>
          </div>

          {safeTdsUrl && (
            <a
              href={safeTdsUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open technical data sheet for ${name} in a new tab`}
              className="inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-xs font-semibold text-ink/70 transition-colors hover:border-blue hover:text-blue"
            >
              <FileText size={14} aria-hidden="true" />
              View TDS
            </a>
          )}
        </div>

        <Button
          href={detailsHref}
          variant="outline"
          fullWidth
          className="mt-2"
        >
          View details
        </Button>
      </div>
    </article>
  );
}
</file>

<file path="components/dashboard/admin/service-bookings/UpdateBookingStatusModal.tsx">
"use client";

import { AlertCircle, AlertTriangle, CheckCircle2, Loader2, Lock } from "lucide-react";
import { useEffect, useState } from "react";
import { toast } from "sonner";

import DashboardButton from "@/components/dashboard/DashboardButton";
import { Badge } from "@/components/ui/badge";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";
import { Label } from "@/components/ui/label";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { axiosInstance } from "@/lib/axios";
import {
  getAllowedBookingStatusTransitions,
  type Booking,
  type BookingStatus,
} from "@/types/booking.type";
import { formatBookingStatus, getBookingStatusClass } from "./bookingUtils";
import StatusPipelineGuide from "@/components/dashboard/StatusPipelineGuide";

type UpdateBookingStatusModalProps = {
  booking: Booking | null;
  open: boolean;
  onClose: () => void;
  onSuccess?: () => void;
};

const IRREVERSIBLE_STATUSES: BookingStatus[] = ["completed", "cancelled", "rejected"];

export default function UpdateBookingStatusModal({
  booking,
  open,
  onClose,
  onSuccess,
}: UpdateBookingStatusModalProps) {
  const [selectedStatus, setSelectedStatus] = useState<BookingStatus | "">("");
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [isConfirmed, setIsConfirmed] = useState(false);

  const currentStatus = booking?.status ?? "pending";
  const allowedStatuses = booking ? getAllowedBookingStatusTransitions(currentStatus) : [];
  const isTerminal = allowedStatuses.length === 0;

  useEffect(() => {
    if (open && booking) {
      const allowed = getAllowedBookingStatusTransitions(booking.status);
      setSelectedStatus(allowed.length > 0 ? allowed[0] : "");
      setIsConfirmed(false);
    }
  }, [open, booking]);

  const handleClose = () => {
    if (isSubmitting) return;
    onClose();
  };

  const isIrreversible = selectedStatus && IRREVERSIBLE_STATUSES.includes(selectedStatus as BookingStatus);
  const requiresConfirmation = Boolean(isIrreversible);

  const onSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!booking || !selectedStatus || isTerminal) return;

    if (selectedStatus === booking.status) {
      toast.info("Status is already set to " + formatBookingStatus(selectedStatus));
      onClose();
      return;
    }

    if (requiresConfirmation && !isConfirmed) {
      setIsConfirmed(true);
      return;
    }

    setIsSubmitting(true);
    try {
      const response = await axiosInstance.patch(`/booking/${booking._id}/status`, {
        status: selectedStatus,
      });

      toast.success(
        response.data?.message || "Booking status updated successfully.",
      );
      onSuccess?.();
      onClose();
    } catch (error: unknown) {
      const err = error as { response?: { data?: { message?: string } }; message?: string };
      const message =
        err?.response?.data?.message ||
        err?.message ||
        "Failed to update booking status.";
      toast.error(message);
    } finally {
      setIsSubmitting(false);
    }
  };

  return (
    <Dialog open={open && Boolean(booking)} onOpenChange={(val) => !val && handleClose()}>
      <DialogContent className="max-h-[92vh] overflow-hidden rounded-2xl border-0 p-0 shadow-2xl sm:max-w-xl">
        <div className="flex max-h-[92vh] flex-col">
          <DialogHeader className="border-b px-6 py-5 text-left sm:px-8">
            <DialogTitle className="text-xl font-bold text-navy">
              Update Booking Status
            </DialogTitle>
            <DialogDescription className="text-sm leading-6">
              Advance the fulfillment status for booking{" "}
              <span className="font-semibold text-foreground">
                #{booking?.bookingNumber}
              </span>
              .
            </DialogDescription>
          </DialogHeader>

          <form onSubmit={onSubmit} className="flex flex-1 flex-col overflow-hidden">
            <div className="min-h-0 flex-1 space-y-5 overflow-y-auto px-6 py-6 sm:px-8">
              {/* Pipeline Flow Guide */}
              <StatusPipelineGuide
                type="booking"
                currentStatus={currentStatus}
                selectedStatus={!isTerminal ? selectedStatus : undefined}
              />

              {/* Current Status Box */}
              <div className="flex items-center justify-between rounded-xl border bg-muted/20 p-4 text-sm">
                <div>
                  <span className="text-muted-foreground">Current status: </span>
                  <Badge
                    variant="outline"
                    className={`ml-2 rounded-full px-2.5 py-0.5 text-xs font-semibold capitalize ${
                      booking ? getBookingStatusClass(booking.status) : ""
                    }`}
                  >
                    {booking ? formatBookingStatus(booking.status) : "—"}
                  </Badge>
                </div>
                {isTerminal && (
                  <span className="flex items-center gap-1.5 text-xs font-semibold text-amber-700 dark:text-amber-400">
                    <Lock className="h-3.5 w-3.5" />
                    Terminal State
                  </span>
                )}
              </div>

              {isTerminal ? (
                <div className="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800 dark:border-amber-900/40 dark:bg-amber-950/20 dark:text-amber-300">
                  <div className="flex items-start gap-3">
                    <AlertCircle className="mt-0.5 h-5 w-5 shrink-0 text-amber-600 dark:text-amber-400" />
                    <div>
                      <p className="font-semibold">Workflow Complete</p>
                      <p className="mt-1 text-xs leading-5">
                        This booking has reached terminal status &quot;{formatBookingStatus(currentStatus)}&quot;. No further status transitions are permitted in this pipeline.
                      </p>
                    </div>
                  </div>
                </div>
              ) : (
                <>
                  {/* Status Select */}
                  <div className="space-y-2">
                    <Label htmlFor="status-select" className="text-sm font-semibold text-navy">
                      Allowed next status
                    </Label>
                    <Select
                      value={selectedStatus}
                      onValueChange={(val) => {
                        setSelectedStatus(val as BookingStatus);
                        setIsConfirmed(false);
                      }}
                      disabled={isSubmitting}
                    >
                      <SelectTrigger id="status-select" className="h-11 w-full rounded-xl">
                        <SelectValue placeholder="Select next status" />
                      </SelectTrigger>
                      <SelectContent>
                        {allowedStatuses.map((status) => (
                          <SelectItem key={status} value={status}>
                            {formatBookingStatus(status)}
                          </SelectItem>
                        ))}
                      </SelectContent>
                    </Select>
                    <p className="text-xs leading-5 text-muted-foreground">
                      Only permitted forward transitions from &quot;{formatBookingStatus(currentStatus)}&quot; are selectable.
                    </p>
                  </div>

                  {/* Warning / Confirmation Box for critical terminal states */}
                  {isIrreversible && (
                    <div className="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800 dark:border-red-900/40 dark:bg-red-950/20 dark:text-red-300">
                      <div className="flex items-start gap-3">
                        <AlertTriangle className="mt-0.5 h-5 w-5 shrink-0 text-red-600 dark:text-red-400" />
                        <div>
                          <p className="font-semibold">Irreversible Action</p>
                          <p className="mt-1 text-xs leading-5">
                            Transitioning to &quot;{formatBookingStatus(selectedStatus as BookingStatus)}&quot; is permanent. Once transitioned, this booking cannot be moved backward or updated again.
                          </p>
                          {isConfirmed && (
                            <p className="mt-2 text-xs font-bold text-red-700 dark:text-red-300">
                              Please click &quot;Confirm & Update Status&quot; below to proceed.
                            </p>
                          )}
                        </div>
                      </div>
                    </div>
                  )}
                </>
              )}
            </div>

            {/* Footer */}
            <div className="flex flex-col-reverse gap-3 border-t bg-muted/20 px-6 py-4 sm:flex-row sm:justify-end sm:px-8">
              <DashboardButton
                type="button"
                variant="outline"
                className="min-h-10 rounded-xl px-5 text-xs font-bold"
                disabled={isSubmitting}
                onClick={handleClose}
              >
                {isTerminal ? "Close" : "Cancel"}
              </DashboardButton>
              {!isTerminal && (
                <DashboardButton
                  type="submit"
                  disabled={isSubmitting || !selectedStatus}
                  className={
                    isIrreversible
                      ? "bg-red-600 text-white hover:bg-red-700 dark:bg-red-700"
                      : undefined
                  }
                  icon={
                    isSubmitting ? (
                      <Loader2 className="h-4 w-4 animate-spin" />
                    ) : isConfirmed ? (
                      <CheckCircle2 className="h-4 w-4" />
                    ) : undefined
                  }
                >
                  {isSubmitting
                    ? "Updating..."
                    : requiresConfirmation && !isConfirmed
                    ? `Proceed to ${formatBookingStatus(selectedStatus as BookingStatus)}`
                    : isConfirmed
                    ? "Confirm & Update Status"
                    : "Update Status"}
                </DashboardButton>
              )}
            </div>
          </form>
        </div>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="components/cart/CheckoutForm.tsx">
"use client";
import { formatTaka } from "@/lib/utils";

import { zodResolver } from "@hookform/resolvers/zod";
import {
  ArrowLeft,
  ArrowRight,
  ShieldCheck,
  ShoppingBag,
} from "lucide-react";
import Image from "next/image";
import Link from "next/link";
import { useRouter } from "next/navigation";
import { useEffect, useRef, useState } from "react";
import { Controller, useForm } from "react-hook-form";
import { toast } from "sonner";
import { z } from "zod";

import Container from "@/components/Container";
import { useCart } from "@/components/cart/CartProvider";
import CheckoutLoader from "@/components/cart/CheckoutLoader";
import EmptyCart from "@/components/cart/EmptyCart";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Textarea } from "@/components/ui/textarea";

import { usePost } from "@/hooks/swr/usePost";
import type {
  CreateOrderRequest,
  CreatedOrderConfirmation,
  DeliveryZone,
} from "@/lib/api/orders";
import { authClient } from "@/lib/auth-client";
import { clearCart } from "@/lib/cart";
import { getProductImageUrl } from "@/lib/products/images";
import { trackConversion } from "@/lib/analytics/events";
import { getConversionContext } from "@/lib/analytics/conversion-context";

const checkoutSchema = z.object({
  name: z
    .string()
    .trim()
    .min(2, "Enter a name between 2 and 100 characters.")
    .max(100, "Enter a name between 2 and 100 characters."),
  phone: z
    .string()
    .trim()
    .refine(
      (value) =>
        /^\+?[0-9]{7,15}$/.test(value.replace(/[\s()-]/g, "")),
      "Enter a valid phone number, including +880 if needed.",
    ),
  addressLine: z
    .string()
    .trim()
    .min(5, "Enter an address between 5 and 200 characters.")
    .max(200, "Enter an address between 5 and 200 characters."),
  area: z
    .string()
    .trim()
    .min(2, "Enter an area between 2 and 100 characters.")
    .max(100, "Enter an area between 2 and 100 characters."),
  city: z
    .string()
    .trim()
    .min(2, "Enter a city between 2 and 100 characters.")
    .max(100, "Enter a city between 2 and 100 characters."),
  district: z
    .string()
    .trim()
    .min(2, "Enter a district between 2 and 100 characters.")
    .max(100, "Enter a district between 2 and 100 characters."),
  postalCode: z
    .string()
    .trim()
    .max(20, "Postal code cannot exceed 20 characters."),
  deliveryZone: z.enum(["dhaka", "outside_dhaka"]),
  customerNote: z
    .string()
    .trim()
    .max(1000, "Note cannot exceed 1000 characters."),
});

type CheckoutValues = z.infer<typeof checkoutSchema>;

type CreateOrderApiResponse = {
  success: boolean;
  statusCode: number;
  message: string;
  data: CreatedOrderConfirmation | null;
};

const initialValues: CheckoutValues = {
  name: "",
  phone: "",
  addressLine: "",
  area: "",
  city: "",
  district: "",
  postalCode: "",
  deliveryZone: "dhaka",
  customerNote: "",
};

const money = formatTaka;

function messageFromError(error: unknown): string {
  if (error instanceof Error) return error.message;

  if (typeof error === "object" && error !== null) {
    const data = error as {
      message?: unknown;
      errorMessages?: unknown;
    };

    if (typeof data.message === "string") return data.message;

    if (Array.isArray(data.errorMessages)) {
      const firstMessage = data.errorMessages.find(
        (item) => typeof item?.message === "string",
      )?.message;

      if (typeof firstMessage === "string") return firstMessage;
    }
  }

  return "We couldn't place your order. Please check your details and try again.";
}

const fieldClassName =
  "min-h-12 rounded-xl border-line bg-white text-sm text-navy shadow-none placeholder:text-ink/40 focus-visible:border-blue focus-visible:ring-2 focus-visible:ring-blue/15";

export default function CheckoutForm() {
  const router = useRouter();

  const { data: session, isPending: sessionPending } =
    authClient.useSession();

  const { items, subtotal, hydrated } = useCart();

  const { mutate: postOrder, isLoading: isSubmitting } =
    usePost("/order");

  const [requestError, setRequestError] = useState("");
  const submissionLock = useRef(false);

  const form = useForm<CheckoutValues>({
    resolver: zodResolver(checkoutSchema),
    defaultValues: initialValues,
    mode: "onTouched",
  });

  const { control, handleSubmit, setValue, formState } = form;

  // Prefill profile data without overwriting anything the customer has entered.
  useEffect(() => {
    if (!session?.user) return;

    if (!form.getValues("name") && session.user.name) {
      setValue("name", session.user.name, {
        shouldDirty: false,
        shouldValidate: formState.touchedFields.name,
      });
    }

    if (!form.getValues("phone") && session.user.phone) {
      setValue("phone", session.user.phone, {
        shouldDirty: false,
        shouldValidate: formState.touchedFields.phone,
      });
    }
  }, [
    session?.user,
    form,
    setValue,
    formState.touchedFields.name,
    formState.touchedFields.phone,
  ]);

  const onSubmit = async (values: CheckoutValues) => {
    if (submissionLock.current) return;

    if (!items.length) {
      const message =
        "Your cart is empty. Add a product before checkout.";
      setRequestError(message);
      return;
    }

    if (!session?.user) {
      const message =
        "Please sign in to place an order. Your account email is used for order updates.";
      setRequestError(message);
      return;
    }

    submissionLock.current = true;
    setRequestError("");

    const phone = values.phone.trim().replace(/[\s()-]/g, "");
    const conversionContext = getConversionContext("order");

    const payload: CreateOrderRequest = {
      items: items.map((item) => ({
        productId: item.productId,
        variantId: item.variantId || undefined,
        quantity: item.quantity,
      })),
      customer: {
        name: values.name.trim(),
        phone,
      },
      deliveryAddress: {
        addressLine: values.addressLine.trim(),
        area: values.area.trim(),
        city: values.city.trim(),
        district: values.district.trim(),
        ...(values.postalCode.trim()
          ? { postalCode: values.postalCode.trim() }
          : {}),
      },
      deliveryZone: values.deliveryZone as DeliveryZone,
      ...(values.customerNote.trim()
        ? { customerNote: values.customerNote.trim() }
        : {}),
      conversionContext,
    };

    try {
      const order = await postOrder(payload);

      if (!order?.data?._id || !order?.data?.orderNumber) {
        throw new Error("The order response was incomplete.");
      }

      // Fire Purchase event through browser Pixel with matching event ID for deduplication
      trackConversion(
        "purchase",
        {
          order_id: order.data._id,
          order_number: order.data.orderNumber,
          currency: order.data.currency || "BDT",
          value: order.data.totalAmount,
          content_type: "product",
          contents: items.map((item) => ({
            id: item.productId,
            quantity: item.quantity,
            item_price: item.price,
          })),
          num_items: items.reduce(
            (acc: number, item) => acc + item.quantity,
            0,
          ),
        },
        { eventId: conversionContext.eventId },
      );

      clearCart();

      toast.success("Your order has been placed.");

      router.push(
        `/checkout/success?orderId=${encodeURIComponent(order?.data?._id)}`,
      );
    } catch (error: unknown) {
      const message = messageFromError(error);

      setRequestError(message);
      toast.error(message);

      submissionLock.current = false;
    }
  };

  return (
    <section className="bg-mist/45 py-14 max-[600px]:py-9">
      <Container>
        <div className="mx-auto max-w-[1180px]">
          <Link
            href="/cart"
            className="inline-flex items-center gap-2 text-sm font-semibold text-blue transition-colors hover:text-deep"
          >
            <ArrowLeft size={16} aria-hidden="true" />
            Back to cart
          </Link>

          <div className="mt-4">
            <p className="mb-3 text-[11px] font-extrabold uppercase tracking-[0.15em] text-blue">
              Secure checkout
            </p>

            <h1 className="text-[clamp(32px,4vw,48px)] font-extrabold leading-tight tracking-[-0.04em] text-navy">
              Delivery details
            </h1>

            <p className="mt-2 text-sm leading-6 text-ink/65">
              Your order will be paid by cash on delivery.
            </p>
          </div>

          {!hydrated ? (
            <CheckoutLoader />
          ) : items.length === 0 ? (
            <EmptyCart />
          ) : (
            <div className="mt-8 grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_400px]">
              <form
                onSubmit={handleSubmit(onSubmit)}
                noValidate
                className="min-w-0 rounded-2xl border border-line bg-white p-7 shadow-[0_10px_30px_rgba(0,51,78,0.04)] max-[600px]:p-5"
              >
                <fieldset
                  disabled={isSubmitting || sessionPending}
                  className="min-w-0"
                >
                  <legend className="text-lg font-extrabold text-navy">
                    Customer and delivery
                  </legend>

                  <p className="mt-1 text-sm text-ink/60">
                    Fields marked with{" "}
                    <span aria-hidden="true">*</span> are required.
                  </p>

                  {!sessionPending && !session?.user && (
                    <div className="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-950">
                      The order service requires an account so it can
                      send your order confirmation.{" "}
                      <Link
                        href="/login?callbackUrl=%2Fcheckout"
                        className="font-bold underline underline-offset-2"
                      >
                        Sign in or create an account
                      </Link>
                      , then return to checkout.
                    </div>
                  )}

                  <div className="mt-6 grid gap-5 sm:grid-cols-2">
                    <div>
                      <label
                        htmlFor="name"
                        className="text-sm font-bold text-navy"
                      >
                        Customer name{" "}
                        <span className="text-red-600">*</span>
                      </label>

                      <Input
                        id="name"
                        autoComplete="name"
                        placeholder="Your full name"
                        aria-invalid={Boolean(formState.errors.name)}
                        aria-describedby={
                          formState.errors.name
                            ? "name-error"
                            : undefined
                        }
                        {...form.register("name")}
                        className={`${fieldClassName} mt-2`}
                      />

                      {formState.errors.name && (
                        <p
                          id="name-error"
                          className="mt-1.5 text-xs text-red-700"
                        >
                          {formState.errors.name.message}
                        </p>
                      )}
                    </div>

                    <div>
                      <label
                        htmlFor="phone"
                        className="text-sm font-bold text-navy"
                      >
                        Phone number{" "}
                        <span className="text-red-600">*</span>
                      </label>

                      <Input
                        id="phone"
                        type="tel"
                        inputMode="tel"
                        autoComplete="tel"
                        placeholder="+880 1XXXXXXXXX"
                        aria-invalid={Boolean(formState.errors.phone)}
                        aria-describedby={
                          formState.errors.phone
                            ? "phone-error"
                            : undefined
                        }
                        {...form.register("phone")}
                        className={`${fieldClassName} mt-2`}
                      />

                      {formState.errors.phone && (
                        <p
                          id="phone-error"
                          className="mt-1.5 text-xs text-red-700"
                        >
                          {formState.errors.phone.message}
                        </p>
                      )}
                    </div>

                    <div className="sm:col-span-2">
                      <label
                        htmlFor="addressLine"
                        className="text-sm font-bold text-navy"
                      >
                        Delivery address{" "}
                        <span className="text-red-600">*</span>
                      </label>

                      <Input
                        id="addressLine"
                        autoComplete="street-address"
                        placeholder="House, road, building, or street"
                        aria-invalid={Boolean(
                          formState.errors.addressLine,
                        )}
                        aria-describedby={
                          formState.errors.addressLine
                            ? "addressLine-error"
                            : undefined
                        }
                        {...form.register("addressLine")}
                        className={`${fieldClassName} mt-2`}
                      />

                      {formState.errors.addressLine && (
                        <p
                          id="addressLine-error"
                          className="mt-1.5 text-xs text-red-700"
                        >
                          {formState.errors.addressLine.message}
                        </p>
                      )}
                    </div>

                    <div>
                      <label
                        htmlFor="area"
                        className="text-sm font-bold text-navy"
                      >
                        Area <span className="text-red-600">*</span>
                      </label>

                      <Input
                        id="area"
                        autoComplete="address-level3"
                        placeholder="Your area"
                        aria-invalid={Boolean(formState.errors.area)}
                        aria-describedby={
                          formState.errors.area
                            ? "area-error"
                            : undefined
                        }
                        {...form.register("area")}
                        className={`${fieldClassName} mt-2`}
                      />

                      {formState.errors.area && (
                        <p
                          id="area-error"
                          className="mt-1.5 text-xs text-red-700"
                        >
                          {formState.errors.area.message}
                        </p>
                      )}
                    </div>

                    <div>
                      <label
                        htmlFor="city"
                        className="text-sm font-bold text-navy"
                      >
                        City <span className="text-red-600">*</span>
                      </label>

                      <Input
                        id="city"
                        autoComplete="address-level2"
                        placeholder="Your city"
                        aria-invalid={Boolean(formState.errors.city)}
                        aria-describedby={
                          formState.errors.city
                            ? "city-error"
                            : undefined
                        }
                        {...form.register("city")}
                        className={`${fieldClassName} mt-2`}
                      />

                      {formState.errors.city && (
                        <p
                          id="city-error"
                          className="mt-1.5 text-xs text-red-700"
                        >
                          {formState.errors.city.message}
                        </p>
                      )}
                    </div>

                    <div>
                      <label
                        htmlFor="district"
                        className="text-sm font-bold text-navy"
                      >
                        District{" "}
                        <span className="text-red-600">*</span>
                      </label>

                      <Input
                        id="district"
                        autoComplete="address-level1"
                        placeholder="Your district"
                        aria-invalid={Boolean(
                          formState.errors.district,
                        )}
                        aria-describedby={
                          formState.errors.district
                            ? "district-error"
                            : undefined
                        }
                        {...form.register("district")}
                        className={`${fieldClassName} mt-2`}
                      />

                      {formState.errors.district && (
                        <p
                          id="district-error"
                          className="mt-1.5 text-xs text-red-700"
                        >
                          {formState.errors.district.message}
                        </p>
                      )}
                    </div>

                    <div>
                      <label
                        htmlFor="postalCode"
                        className="text-sm font-bold text-navy"
                      >
                        Postal code{" "}
                        <span className="font-normal text-ink/55">
                          (optional)
                        </span>
                      </label>

                      <Input
                        id="postalCode"
                        autoComplete="postal-code"
                        placeholder="Postal code"
                        aria-invalid={Boolean(
                          formState.errors.postalCode,
                        )}
                        aria-describedby={
                          formState.errors.postalCode
                            ? "postalCode-error"
                            : undefined
                        }
                        {...form.register("postalCode")}
                        className={`${fieldClassName} mt-2`}
                      />

                      {formState.errors.postalCode && (
                        <p
                          id="postalCode-error"
                          className="mt-1.5 text-xs text-red-700"
                        >
                          {formState.errors.postalCode.message}
                        </p>
                      )}
                    </div>

                    <div className="sm:col-span-2">
                      <label
                        htmlFor="deliveryZone"
                        className="text-sm font-bold text-navy"
                      >
                        Delivery zone{" "}
                        <span className="text-red-600">*</span>
                      </label>

                      <Controller
                        control={control}
                        name="deliveryZone"
                        render={({ field }) => (
                          <Select
                            value={field.value}
                            onValueChange={field.onChange}
                            disabled={isSubmitting || sessionPending}
                          >
                            <SelectTrigger
                              id="deliveryZone"
                              aria-invalid={Boolean(
                                formState.errors.deliveryZone,
                              )}
                              aria-describedby={
                                formState.errors.deliveryZone
                                  ? "deliveryZone-error"
                                  : undefined
                              }
                              className={`${fieldClassName} mt-2 w-full`}
                            >
                              <SelectValue placeholder="Select delivery zone">
                                {field.value === "dhaka"
                                  ? "Inside Dhaka"
                                  : field.value === "outside_dhaka"
                                    ? "Outside Dhaka"
                                    : "Select delivery zone"}
                              </SelectValue>
                            </SelectTrigger>

                            <SelectContent>
                              <SelectItem value="dhaka">
                                Inside Dhaka
                              </SelectItem>

                              <SelectItem value="outside_dhaka">
                                Outside Dhaka
                              </SelectItem>
                            </SelectContent>
                          </Select>
                        )}
                      />

                      <p className="mt-1.5 text-xs leading-5 text-ink/55">
                        The delivery fee and final total are confirmed
                        by the server when the order is placed.
                      </p>

                      {formState.errors.deliveryZone && (
                        <p
                          id="deliveryZone-error"
                          className="mt-1.5 text-xs text-red-700"
                        >
                          {formState.errors.deliveryZone.message}
                        </p>
                      )}
                    </div>

                    <div className="sm:col-span-2">
                      <label
                        htmlFor="customerNote"
                        className="text-sm font-bold text-navy"
                      >
                        Note for delivery{" "}
                        <span className="font-normal text-ink/55">
                          (optional)
                        </span>
                      </label>

                      <Textarea
                        id="customerNote"
                        rows={3}
                        maxLength={1000}
                        placeholder="Any directions that will help us deliver your order"
                        aria-invalid={Boolean(
                          formState.errors.customerNote,
                        )}
                        aria-describedby={
                          formState.errors.customerNote
                            ? "customerNote-error"
                            : undefined
                        }
                        {...form.register("customerNote")}
                        className="mt-2 min-h-24 resize-y rounded-xl border-line bg-white text-sm text-navy shadow-none placeholder:text-ink/40 focus-visible:border-blue focus-visible:ring-2 focus-visible:ring-blue/15"
                      />

                      {formState.errors.customerNote && (
                        <p
                          id="customerNote-error"
                          className="mt-1.5 text-xs text-red-700"
                        >
                          {formState.errors.customerNote.message}
                        </p>
                      )}
                    </div>
                  </div>
                </fieldset>

                {requestError && (
                  <p
                    className="mt-5 rounded-xl border border-red-200 bg-red-50 p-3 text-sm leading-6 text-red-800"
                    role="alert"
                  >
                    {requestError}
                  </p>
                )}

                <Button
                  type="submit"
                  disabled={
                    isSubmitting ||
                    sessionPending ||
                    !session?.user ||
                    items.length === 0
                  }
                  className="mt-7 min-h-12 w-full rounded-full bg-blue px-5 text-sm font-bold text-white transition-colors hover:bg-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue disabled:cursor-not-allowed disabled:bg-ink/35"
                >
                  {isSubmitting ? (
                    <>
                      <span
                        className="size-4 animate-spin rounded-full border-2 border-white/40 border-t-white"
                        aria-hidden="true"
                      />
                      Placing order…
                    </>
                  ) : (
                    <>
                      Place order
                      <ArrowRight size={16} aria-hidden="true" />
                    </>
                  )}
                </Button>

                <p className="mt-3 flex items-center justify-center gap-2 text-xs text-ink/55">
                  <ShieldCheck size={15} aria-hidden="true" />
                  Cash on delivery · Prices and stock verified at
                  order time
                </p>
              </form>

              <aside className="rounded-3xl border border-line bg-white p-5 shadow-[0_8px_28px_rgba(0,51,78,0.06)] sm:p-7 lg:sticky lg:top-28">
                <div className="flex items-center justify-between gap-3 border-b border-line pb-4">
                  <div className="flex items-center gap-3">
                    <span className="grid size-11 shrink-0 place-items-center rounded-2xl bg-blue/10 text-blue">
                      <ShoppingBag size={21} aria-hidden="true" />
                    </span>

                    <div>
                      <h2 className="text-lg font-extrabold text-navy">
                        Order summary
                      </h2>
                      <p className="mt-0.5 text-xs text-ink/55">
                        A quick look at your purchase
                      </p>
                    </div>
                  </div>

                  <span className="shrink-0 rounded-full bg-mist px-3 py-1.5 text-xs font-bold text-navy">
                    {items.length}{" "}
                    {items.length === 1 ? "item" : "items"}
                  </span>
                </div>

                <ul className="divide-y divide-line">
                  {items.map((item) => {
                    const image = getProductImageUrl(item.image);
                    const itemKey = `${item.productId}:${item.variantId || ""}`;

                    return (
                      <li
                        key={itemKey}
                        className="flex items-center gap-3 py-4 sm:gap-4"
                      >
                        <div className="relative size-[68px] shrink-0 overflow-hidden rounded-2xl border border-line bg-mist/60">
                          {image ? (
                            <Image
                              src={image}
                              alt={item.name}
                              fill
                              sizes="68px"
                              className="object-cover"
                            />
                          ) : (
                            <span className="grid h-full place-items-center text-[10px] text-ink/50">
                              No image
                            </span>
                          )}
                        </div>

                        <div className="min-w-0 flex-1">
                          <p className="text-sm font-bold leading-5 text-navy">
                            {item.name}
                          </p>
                          {(item.weight || item.size) && (
                            <p className="mt-0.5 text-xs font-semibold text-blue">
                              Weight: {item.weight || item.size}
                            </p>
                          )}

                          <p className="mt-1 text-xs text-ink/55">
                            {money(item.price)} × {item.quantity}
                          </p>
                        </div>

                        <span className="shrink-0 text-sm font-extrabold tabular-nums text-navy">
                          {money(item.price * item.quantity)}
                        </span>
                      </li>
                    );
                  })}
                </ul>

                <div className="space-y-3 border-t border-line pt-5 text-sm">
                  <div className="flex justify-between gap-4">
                    <span className="text-ink/65">
                      Estimated subtotal
                    </span>
                    <span className="font-semibold tabular-nums text-navy">
                      {money(subtotal)}
                    </span>
                  </div>

                  <div className="flex justify-between gap-4">
                    <span className="text-ink/65">Delivery</span>
                    <span className="text-right text-xs leading-5 text-ink/60">
                      Confirmed after order placement
                    </span>
                  </div>

                  <div className="flex items-center justify-between gap-4 rounded-2xl bg-blue/5 px-4 py-4">
                    <span className="font-extrabold text-navy">
                      Final total
                    </span>
                    <span className="max-w-[170px] text-right text-xs leading-5 text-ink/60">
                      Confirmed with server-verified prices and
                      delivery
                    </span>
                  </div>

                  <div className="flex items-start gap-2 pt-1 text-xs leading-5 text-ink/55">
                    <ShieldCheck
                      size={15}
                      className="mt-0.5 shrink-0 text-blue"
                      aria-hidden="true"
                    />
                    <p>
                      Cart prices are estimates. Stock, item prices,
                      and delivery charges are verified when you place
                      your order.
                    </p>
                  </div>
                </div>
              </aside>
            </div>
          )}
        </div>
      </Container>
    </section>
  );
}
